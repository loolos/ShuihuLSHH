    {
      "trigger": {"kind":"cond"},
      "cond": {"op":"or","a":{"type":1,"arg":48},"b":{"op":"and","a":{"type":4,"arg":12},"b":{"op":"and","a":{"op":"and","a":{"type":7,"arg":0},"b":{"type":8,"arg":27}},"b":{"op":"and","a":{"type":9,"arg":1},"b":{"type":10,"arg":29}}}}},
      "head": [5,8,1,0,0,0,32,2,1],
      "ops": [
        {"op":12,"flag":1,"value":48},
        {"op":13,"flag":0,"text":"保正快走！朱仝在这里等你很久了！"},
        {"op":12,"flag":1,"value":12},
        {"op":13,"flag":0,"text":"喔！你是『美髯公』朱仝嘛！朱都头，我们无冤无仇，为何如此苦苦相逼？"},
        {"op":12,"flag":1,"value":48},
        {"op":13,"flag":0,"text":"保正误会了。你没有看到我让出一条路给你逃生？我怕雷横不懂得做人情，所以我骗他去打前门，我在后门放你走。保正你不可投往别处，只有梁山泊可以安身立命。"},
        {"op":12,"flag":1,"value":12},
        {"op":13,"flag":0,"text":"...你的不杀之恩，他日必报！"},
        {"op":29,"flag":null,"text":"经过一场恶战，晁盖到达安全地带。"}
