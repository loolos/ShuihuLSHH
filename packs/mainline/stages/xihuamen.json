 ],
 "script": [
  { "on": "start", "do": [
   ["title", "当晚 · 王进家中", "#1"],
   ["narrate", "王进回到家中，闷闷不已，对娘说知此事。", "#2"],
   ["appear", "wangjin"],
   ["move", "wangjin", 10, 7],
   ["appear", "wangmu"],
   ["face", "wangjin", "wangmu"],
   ["narrate", "母子二人抱头而哭。", "#3"],
   ["say", "wangmu", "我儿，三十六着，走为上着。只恐没处走。", "#4"],
   ["say", "wangjin", "母亲说得是。儿子寻思，也是这般计较。只有延安府老种经略相公镇守边庭，他手下军官多有曾到京师，爱儿子使枪棒的极多，何不逃去投奔他们？那里是用人去处，足可安身立命。", "#5"],
   ["say", "wangmu", "我儿，和你要私走，只恐门前两个牌军，是殿帅府拨来伏侍你的，他若得知，须走不脱。", "#6"],
   ["say", "wangjin", "不妨。母亲放心，儿子自有道理措置他。", "#7"],
   ["leave", "wangmu"],
   ["appear", "zhangpai"],
   ["move", "zhangpai", 12, 7],
   ["face", "wangjin", "zhangpai"],
   ["say", "wangjin", "你先吃了些晚饭，我使你一处去干事。", "#8"],
   ["say", "zhangpai", "教头使小人那里去？", "#9"],
   ["say", "wangjin", "我因前日病患，许下酸枣门外岳庙里香愿，明日早要去烧炷头香。你可今晚先去分付庙祝，教他来日早开些庙门，等我来烧炷头香，就要三牲献刘李王。你就庙里歇了等我。", "#10"],
   ["say", "zhangpai", "小人这便去。", "#11"],
   ["move", "zhangpai", 27, 8],
   ["leave", "zhangpai"],
   ["tint", "night"],
   ["title", "当夜 · 五更", "#12"],
   ["narrate", "当夜子母二人收拾了行李衣服、细软银两，做一担儿打挟了；又装两个料袋袱驼，拴在马上。等到五更，天色未明——", "#13"],
   ["appear", "lipai"],
   ["move", "lipai", 12, 7],
   ["face", "wangjin", "lipai"],
   ["say", "wangjin", "你与我将这些银两去岳庙里，和张牌买个三牲煮熟，在那里等候。我买些纸烛，随后便来。", "#14"],
   ["say", "lipai", "小人晓得。", "#15"],
   ["move", "lipai", 27, 9],
   ["leave", "lipai"],
   ["appear", "wangmu"],
   ["move", "wangmu", 9, 7],
   ["say", "wangjin", "娘，上马罢。趁天色未明，出西华门去。", "#16"],
   ["move", "wangjin", 1, 8],
   ["move", "wangmu", 0, 8],
   ["leave", "wangmu"],
   ["leave", "wangjin"],
   ["narrate", "王进扶娘上了马，家中粗重都弃了，锁上前后门，挑了担儿，跟在马后，趁五更天色未明，乘势出了西华门，取路望延安府来。", "#17"],
   ["tint", ""],
   ["title", "次日 · 酸枣门外岳庙", "#18"],
   ["narrate", "且说两个牌军买了福物煮熟，在庙里等到巳牌，也不见来；回到王教头家看时，门上锁着，两头无路。直等到黄昏，不见回来，只得去殿帅府首告：「王教头弃家在逃，子母不知去向。」", "#19"],
   ["narrate", "高太尉见告了，大怒道：「贼配军在逃，看那厮待走那里去！」随即押下文书，行开诸州各府，捉拿逃军王进。", "#20"],
   ["narrate", "且说王教头母子二人，自离了东京，在路饥餐渴饮，夜住晓行，一月有余。高俅差来的追兵，却已在后面紧紧赶来……", "#21"],
   ["victory", "王进母子私离东京，投延安府去了。", "#22"]
  ]}
 ]
}
