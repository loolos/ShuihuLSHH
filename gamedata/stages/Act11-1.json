      "head": [1,56,1,0,0,0,34,2,0],
      "ops": [
        {"op":12,"flag":1,"value":14},
        {"op":14,"flag":1,"value":6},
        {"op":15,"flag":1,"value":10},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"text":"杨志，这些是『生辰纲』全部的货物吗？"},
        {"op":12,"flag":1,"value":14},
        {"op":13,"flag":0,"text":"只是其中的一小部份...其他不知道在哪里。"},
        {"op":12,"flag":1,"value":62},
        {"op":13,"flag":0,"text":"壮士！这些大部分是我辛辛苦苦卖命赚来的血汗钱啊...壮士如果还有江湖道义的话，这些金银珠宝请尽量拿，只要放小人一条生路就可以了..."},
        {"op":12,"flag":1,"value":14},
        {"op":14,"flag":1,"value":9},
        {"op":15,"flag":1,"value":13},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":14},
        {"op":13,"flag":0,"text":"说！你把『生辰纲』藏在哪里？！"},
        {"op":12,"flag":1,"value":62},
        {"op":13,"flag":0,"text":"冤枉啊...小人真的不知道什么生辰纲、生死纲的玩意；那位『白日鼠』白胜最近发了一笔横财，你们有事就找他好了！"},
        {"op":12,"flag":1,"value":47},
        {"op":13,"flag":0,"text":"邓爷！你怎么这么轻易就把我卖了？！"},
        {"op":12,"flag":1,"value":62},
        {"op":13,"flag":0,"text":"生命要紧啊！各位英雄好汉，你就把我给放了吧！"},
        {"op":12,"flag":1,"value":14},
        {"op":14,"flag":1,"value":9},
        {"op":15,"flag":1,"value":12},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":14},
        {"op":13,"flag":0,"text":"你是『白日鼠』白胜？！说！其他的财宝呢？！跟你同伙的那些人呢？！"},
        {"op":12,"flag":1,"value":47},
        {"op":18,"flag":1,"value":0},
        {"op":19,"flag":1,"value":44},
        {"op":13,"flag":0,"text":"哼！我白胜也有江湖道义的！我不会轻易地出卖同伴，你就算把我打死我也不会..."},
        {"op":12,"flag":1,"value":47},
        {"op":13,"flag":0,"text":"哇～大爷，你拿出刀子干什么...很危险的...."},
        {"op":12,"flag":1,"value":14},
        {"op":13,"flag":0,"text":"如果追不回『生辰纲』，我重回朝廷的一丝希望就完了！说！『生辰纲』在哪里！"},
        {"op":12,"flag":1,"value":47},
        {"op":13,"flag":0,"text":"不要杀我！不要杀我！我说，我说！先把刀子放下..."},
        {"op":12,"flag":1,"value":47},
        {"op":13,"flag":0,"text":"其实夺取『生辰纲』不是我的主意。附近东溪村有个保正，人称『托塔天王』晁盖，他是主谋；家中有个先生，人称『智多星』吴用，他是策划整个行动的人。其他还有『赤发鬼』刘唐、『入云龙』公孙胜、『立地太岁』阮小二、『短命二郎』阮小五、『活阎罗』阮小七，总共就是这些人了。"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"text":"他们现在在哪里？"},
        {"op":12,"flag":1,"value":47},
        {"op":13,"flag":0,"text":"我分了我应得的那份，就离开了东溪村；他们应该还在晁盖家中。"},
        {"op":12,"flag":1,"value":16},
        {"op":14,"flag":1,"value":8},
        {"op":15,"flag":1,"value":11},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":16},
        {"op":18,"flag":1,"value":0},
        {"op":19,"flag":1,"value":45},
        {"op":13,"flag":0,"text":"不好了，官兵看到山上起火，有许多官兵都包围上来了。"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"text":"(糟糕，现在我们有不少人被通缉，最好还是避避风头...)"},
        {"op":12,"flag":1,"value":14},
        {"op":13,"flag":0,"text":"%X兄，有什么难言之隐吗？...就交给我好了。"},
        {"op":29,"flag":null,"text":"二龙山，杨志问出『生辰纲』的线索。"}
      ]
    }
  ]
