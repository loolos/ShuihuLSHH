      "head": [1,54,1,0,0,0,26,2,0],
      "ops": [
        {"op":12,"flag":1,"value":4294967295},
        {"op":18,"flag":1,"value":1},
        {"op":19,"flag":1,"value":39},
        {"op":13,"flag":0,"text":"林冲棒胜洪教头，柴进愈加敬重，留众人在庄上歇息。此后柴进托人替林冲在沧州安排了看守草料场的差事，林冲谢过照应，前去交割。众好汉放心不下，仍在附近相护。另一边，陆谦正在沧州城中一家酒店盘算。"},
        {"op":12,"flag":1,"value":64},
        {"op":13,"flag":0,"text":"（林冲到了沧州，却有柴大官人照应，又有几位好汉相护。若再像野猪林那般强取，只怕仍要失手……）"},
        {"op":12,"flag":1,"value":63},
        {"op":14,"flag":1,"value":12},
        {"op":15,"flag":1,"value":10},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":63},
        {"op":13,"flag":0,"text":"陆虞候，别来无恙！太尉府的差事，可有着落了？"},
        {"op":12,"flag":1,"value":64},
        {"op":13,"flag":0,"text":"原来是富安。你从东京赶来，可是衙内又有吩咐？"},
        {"op":12,"flag":1,"value":63},
        {"op":13,"flag":0,"text":"衙内一心要林冲的性命，催我来与你商议。此事若成，自有重赏。"},
        {"op":12,"flag":1,"value":64},
        {"op":13,"flag":0,"text":"他到了沧州仍不得安生，太尉府还不肯放过他？"},
        {"op":12,"flag":1,"value":63},
        {"op":13,"flag":0,"text":"太尉也要断了这条后患。林冲如今在何处落脚？"},
        {"op":12,"flag":1,"value":64},
        {"op":13,"flag":0,"text":"先前在柴进庄上住过。柴家门第非比寻常，不可贸然闯庄拿人。"},
        {"op":12,"flag":1,"value":63},
        {"op":13,"flag":0,"text":"柴大官人家传誓书铁券，确是动不得。总须另寻时机。"},
        {"op":12,"flag":1,"value":64},
        {"op":13,"flag":0,"text":"林冲与我自幼相交，如今却因太尉府的差遣，落得这般田地……"},
        {"op":12,"flag":1,"value":63},
        {"op":13,"flag":0,"text":"陆虞候莫再迟疑。我带来些人手，必要时可替我们把守道路。"},
        {"op":12,"flag":1,"value":64},
        {"op":13,"flag":0,"text":"事已至此，也顾不得旧日情分了。只须办得干净，休留下后患。"},
        {"op":12,"flag":1,"value":63},
        {"op":13,"flag":0,"text":"先查清他眼下的差使，再作计较。"},
        {"op":12,"flag":1,"value":64},
        {"op":13,"flag":0,"text":"我正为此事踌躇：他若仍在柴庄，有人护着，实不好下手。"},
        {"op":12,"flag":1,"value":71},
        {"op":14,"flag":1,"value":14},
        {"op":15,"flag":1,"value":12},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":71},
        {"op":13,"flag":0,"text":"我知道一件事：柴大官人托人安排林冲去看守草料场，如今人已经交割过去了。"},
        {"op":12,"flag":1,"value":63},
        {"op":13,"flag":0,"text":"哦？此事当真？草料场离城远，可比柴家庄容易行事。"},
        {"op":12,"flag":1,"value":71},
        {"op":13,"flag":0,"text":"这差事不是我安排的，只是我恰好听得消息。那地方草堆连着仓廒，最怕的就是火烛。"},
        {"op":12,"flag":1,"value":64},
        {"op":13,"flag":0,"text":"这位壮士是？为何也这般留意林冲？"},
        {"op":12,"flag":1,"value":71},
        {"op":13,"flag":0,"text":"我便是洪教头。先前比棒败在他手里，心中不服；如今既遇着二位，也愿帮上一把。"},
        {"op":12,"flag":1,"value":64},
        {"op":13,"flag":0,"text":"原来如此。既知道他在草料场，我们便从那里下手。"},
        {"op":12,"flag":1,"value":71},
        {"op":13,"flag":0,"text":"若在草堆四下放起火来，便叫他无处容身。纵然侥幸逃出，失了大军草料，也难逃官司。"},
        {"op":12,"flag":1,"value":63},
        {"op":13,"flag":0,"text":"正是！再打点差拨，让他替我们遮掩。只等夜深无人时，便可动手。"},
        {"op":29,"flag":null,"text":"洪教头得知林冲看守草料场，陆谦、富安遂商议纵火害人。"}
      ]
    }
  ]
}
