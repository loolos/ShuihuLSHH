  "script": [
    {
      "on": "start",
      "do": [
        [
          "portrait",
          "wusong",
          "faces/wusong-xingzhe.png"
        ],
        [
          "bind",
          "huarong"
        ],
        [
          "bind",
          "songjiang"
        ],
        [
          "title",
          "清风山下 · 青州大路"
        ],
        [
          "narrate",
          "黄信、刘高押着两辆囚车，离了清风寨，行不过三四十里，前面望见一座大林子。"
        ],
        [
          "narrate",
          "只听得山坡上锣声响处，一伙喽啰抢将出来，拦住去路。"
        ],
        [
          "focus",
          "yanshun"
        ],
        [
          "say",
          "yanshun",
          "来往的到此当住脚！留下三千两买路黄金，任从过去。"
        ],
        [
          "focus",
          "huangxin"
        ],
        [
          "say",
          "huangxin",
          "你那厮们不得无礼，镇三山在此！"
        ],
        [
          "focus",
          "wangying"
        ],
        [
          "say",
          "wangying",
          "你便是镇万山，也要三千两买路黄金！"
        ],
        [
          "say",
          "likui",
          "少废话！把公明哥哥放下来，饶你们鸟命！"
        ],
        [
          "say",
          "hero",
          "囚车里是宋江哥哥和花荣兄弟，杀过去！"
        ],
        [
          "objective",
          "胜利：打倒黄信、刘高和全部官军，并派人走到宋江身边打开囚车（第 3、5 回合官军都有接应）\n失败：武龙、花荣或宋江倒下；超过 25 回合"
        ],
        [
          "turnLimit",
          25
        ]
      ]
    },
    {
      "on": {
        "turn": 2
      },
      "do": [
        [
          "narrate",
          "囚车里的花荣见了，把囚车掀开，便跳出来，将这缚索都挣断了，就军汉手里夺过一张弓、一壶箭。"
        ],
        [
          "cleanse",
          "huarong"
        ],
        [
          "say",
          "huarong",
          "黄信！你那掷盏的手段，今番须还你！"
        ]
      ]
    },
    {
      "on": {
        "turn": 3
      },
      "do": [
        [
          "narrate",
          "林侧岔路上尘头起处，三筹好汉杀将过来——却是二龙山的武行者、花和尚鲁智深、青面兽杨志，得了武龙的书，连夜赶来！"
        ],
        [
          "appear",
          "wusong"
        ],
        [
          "appear",
          "luzhishen"
        ],
        [
          "appear",
          "yangzhi"
        ],
        [
          "say",
          "luzhishen",
          "洒家来也！哪个撮鸟敢押宋三郎？"
        ],
        [
          "say",
          "wusong",
          "哥哥！兄弟来了！"
        ],
        [
          "say",
          "yangzhi",
          "官军休走，杨志在此！"
        ],
        [
          "narrate",
          "清风镇方向又赶来一小队官军！"
        ],
        [
          "appear",
          "early-1"
        ],
        [
          "appear",
          "early-2"
        ],
        [
          "appear",
          "early-3"
        ],
        [
          "appear",
          "early-4"
        ]
      ]
    },
    {
      "on": {
        "turn": 5
      },
      "do": [
        [
          "narrate",
          "青州方向又来了一彪官军——是黄信先差人去调的接应人马！"
        ],
        [
          "appear",
          "wave-1"
        ],
        [
          "appear",
          "wave-2"
        ],
        [
          "appear",
          "wave-3"
        ],
        [
          "appear",
          "wave-4"
        ],
        [
          "appear",
          "wave-5"
        ],
        [
          "appear",
          "wave-6"
        ],
        [
          "appear",
          "wave-7"
        ],
        [
          "appear",
          "wave-8"
        ],
        [
          "appear",
          "wave-9"
        ],
        [
          "appear",
          "wave-10"
        ],
        [
          "appear",
          "wave-11"
        ],
        [
          "appear",
          "wave-12"
        ],
        [
          "appear",
          "wave-13"
        ],
        [
          "appear",
          "wave-14"
        ],
        [
          "appear",
          "wave-15"
        ],
        [
          "appear",
          "wave-16"
        ],
        [
          "appear",
          "wave-17"
        ],
        [
          "appear",
          "wave-18"
        ],
        [
          "flag",
          "wave"
        ]
      ]
    },
    {
      "on": {
        "dead": "huangxin"
      },
      "do": [
        [
          "narrate",
          "黄信见势头不好，拨回马，独自飞马奔回清风镇去了。"
        ]
      ]
    },
    {
      "on": {
        "dead": "liugao"
      },
      "do": [
        [
          "narrate",
          "刘高见头势不好，拨转马头便走，却被喽啰拽翻，横拖倒拽，绑在一边。"
        ]
      ]
    },
    {
      "on": {
        "near": "songjiang"
      },
      "do": [
        [
          "narrate",
          "众好汉劈开囚车，割断绳索，救出宋江。"
        ],
        [
          "cleanse",
          "songjiang"
        ],
        [
          "say",
          "songjiang",
          "若不是众位兄弟舍命，宋江今番必死！"
        ],
        [
          "flag",
          "freed"
        ]
      ]
    },
    {
      "on": {
        "near": "songjiang"
      },
      "if": "cleared",
      "do": [
        [
          "narrate",
          "官军都杀散了。众好汉簇拥着宋江、花荣，聚在大路上。"
        ],
        [
          "say",
          "huarong",
          "刘高这厮恩将仇报，今番须饶他不得！"
        ],
