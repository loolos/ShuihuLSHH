      "ops": [
        {"op":12,"flag":1,"value":62},
        {"op":18,"flag":1,"value":0},
        {"op":19,"flag":1,"value":43},
        {"op":13,"flag":0,"text":"...这么说兄弟你这一票可捞了不少啊？"},
        {"op":12,"flag":1,"value":47},
        {"op":13,"flag":0,"text":"托大哥的福，小弟的确几个月不用开张了。晁保正虽然人称『托塔天王』，但是干起这偷鸡摸狗的事也十分行啊！还有那个『智多星』吴用，设计谋连孔明都不如他啊！刚才他们领头的汉子怀疑酒中有蒙汗药，要不是吴用先生要我将计就计，大概会被他识破..."},
        {"op":12,"flag":1,"value":62},
        {"op":13,"flag":0,"text":"哈哈哈...兄弟做了这么大买卖，实在值得庆祝！来，喝酒喝酒..."},
        {"op":12,"flag":1,"value":1100},
        {"op":14,"flag":1,"value":17},
        {"op":15,"flag":1,"value":8},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":1100},
        {"op":13,"flag":0,"text":"大王！有人打上山了！"},
        {"op":12,"flag":1,"value":0},
        {"op":12,"flag":1,"value":3},
        {"op":12,"flag":1,"value":5},
        {"op":12,"flag":1,"value":13},
        {"op":12,"flag":1,"value":14},
        {"op":12,"flag":1,"value":15},
        {"op":12,"flag":0,"value":16},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"text":"在下『%M』%N，不知贵寨是否对这位杨兄弟押解的官银动手？如果是，希望能将官银全数送还，大家凭著江湖义气，就此罢休。"},
        {"op":12,"flag":1,"value":62},
        {"op":13,"flag":0,"text":"哈哈！你有听说过被吃下去的东西还有吐出来的道理吗？...白胜，你看看那些人中有没有熟悉的面孔？"},
        {"op":12,"flag":1,"value":47},
        {"op":13,"flag":0,"text":"啊...那个青脸的汉子就是负责押解『生辰纲』的领队！可是其他那些凶神恶煞我可没有见过，他从哪里找来这么多帮手的？邓大哥救我！他们一定是来捉我的！"},
        {"op":12,"flag":1,"value":62},
        {"op":13,"flag":0,"text":"救你是可以...可是你的金银珠宝我要一半。"},
        {"op":12,"flag":1,"value":47},
        {"op":13,"flag":0,"text":"一半？！大哥，你太狠了吧！"},
        {"op":12,"flag":1,"value":62},
        {"op":13,"flag":0,"text":"六成。"},
        {"op":12,"flag":1,"value":47},
        {"op":13,"flag":0,"text":"什么？！"},
        {"op":12,"flag":1,"value":62},
        {"op":13,"flag":0,"text":"七成。"},
        {"op":12,"flag":1,"value":47},
        {"op":13,"flag":0,"text":"算我倒楣！我答应你！"},
        {"op":12,"flag":1,"value":14},
        {"op":13,"flag":0,"text":"啊...那个獐头鼠目的家伙就是卖酒的人！『生辰纲』一定在这里！"},
        {"op":12,"flag":1,"value":62},
        {"op":13,"flag":0,"text":"『%M』！就算本大王『金眼虎』邓龙抢了货物，你又能拿我怎么样？你们只有区区几个人，就敢来本山寨理论？真是活得不耐烦了！小子们！给我上！"},
        {"op":29,"flag":null,"text":"你能不能打败『金眼虎』邓龙？"}
      ]
    }
  ]
