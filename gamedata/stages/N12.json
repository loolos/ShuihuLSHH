      "ops": [
        {"op":12,"flag":1,"value":60},
        {"op":18,"flag":1,"value":0},
        {"op":19,"flag":1,"value":52},
        {"op":13,"flag":0,"text":"时知县有令！命我二人带着部队同来围剿东溪村贼寇晁盖！我是步兵都头『插翅虎』雷横，这位是马兵都头『美髯公』朱仝。"},
        {"op":12,"flag":1,"value":54},
        {"op":13,"flag":0,"text":"时知县怎么派你们两人来了？也好，咱们就一口气杀入东溪村，取下晁盖的人头吧！"},
        {"op":12,"flag":1,"value":48},
        {"op":13,"flag":0,"text":"......"},
        {"op":12,"flag":1,"value":48},
        {"op":13,"flag":0,"text":"不好。我知道晁盖的功夫了得，手下又不知道有哪些虎狼之辈；如果他带领庄客一齐杀出，就算我们捉住晁盖，手下也一定会死很多人。不如采声东击西之计，何观察与雷都头徉攻前门，我去截住后门；等到号令一响，你们只管从前门打进庄内；见一个捉一个，见两个捉一双。"},
        {"op":12,"flag":1,"value":48},
        {"op":16,"flag":1,"value":6},
        {"op":17,"flag":0,"value":8},
        {"op":12,"flag":1,"value":60},
        {"op":13,"flag":0,"text":"有道理。每次都是你在出主意，这次也听你的吧！"},
        {"op":12,"flag":1,"value":54},
        {"op":13,"flag":0,"text":"哼！暂且先听你的，到时候要是出了什么问题，我要你们两个负全部责任！"},
        {"op":12,"flag":1,"value":19},
        {"op":14,"flag":1,"value":16},
        {"op":15,"flag":1,"value":7},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":19},
        {"op":13,"flag":0,"text":"前门的官军又发动攻击了！事不宜迟！"},
        {"op":12,"flag":1,"value":20},
        {"op":14,"flag":1,"value":11},
        {"op":15,"flag":1,"value":7},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":20},
        {"op":13,"flag":0,"text":"后门也有官军埋伏！"},
        {"op":12,"flag":1,"value":12},
        {"op":13,"flag":0,"text":"不管了！放火烧房子，全部人员从后门杀出！"},
        {"op":35,"flag":null,"value":40},
        {"op":31,"flag":null,"text":"限制回合数 --- 40"},
        {"op":32,"flag":null,"text":"胜利条件   --- 晁盖到达安全地带"},
        {"op":33,"flag":null,"text":"失败条件一 --- %N死亡"},
        {"op":33,"flag":null,"text":"失败条件二 --- 晁盖死亡"}
      ]
    },
