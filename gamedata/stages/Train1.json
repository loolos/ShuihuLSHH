    {
      "trigger": {"kind":"cond"},
      "cond": {"op":"or","a":{"type":0,"arg":25},"b":{"type":1,"arg":1024}},
      "head": [1,14,1,0,0,0,16,4,0],
      "ops": [
        {"op":12,"flag":1,"value":0},
        {"op":12,"flag":0,"value":3},
        {"op":12,"flag":1,"value":1},
        {"op":13,"flag":0,"text":"%X兄，在下有个不情之请；不知您是否能帮忙？"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"text":"请说。"},
        {"op":12,"flag":1,"value":1},
        {"op":13,"flag":0,"text":"自从我逃出东京后，我一直很担心留在那儿的同事安危；尤其是接任我的人，可能会在高俅的一怒之下被刺配边疆。有一位林教头如同我的兄弟手足，功夫又好，接任我的人选大概就是他了。能不能帮我把这封信带到东京交给他，劝他也到延安府一同戍守疆土、为国出力？"},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"text":"师父，这个任务就交给徒儿了！徒儿一定会把信送到的！"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"text":"(东京啊...高俅的大本营...)"},
        {"op":12,"flag":1,"value":1},
        {"op":13,"flag":0,"text":"%X兄  小徒就拜托多照顾了..."},
        {"op":29,"flag":null,"text":"主角冒险闯东京。"}
