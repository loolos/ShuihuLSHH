        ],
        [
          "appear",
          "tubing-8"
        ],
        [
          "appear",
          "tubing-9"
        ],
        [
          "appear",
          "tubing-10"
        ],
        [
          "appear",
          "tubing-11"
        ],
        [
          "appear",
          "tubing-12"
        ],
        [
          "appear",
          "tubing-13"
        ],
        [
          "appear",
          "tubing-14"
        ],
        [
          "focus",
          "zhaoneng"
        ],
        [
          "say",
          "zhaoneng",
          "宋太公！你若是晓事的，便把儿子宋江献出来！若是藏着不放，和你这老子一发捉了去！"
        ],
        [
          "say",
          "songtaigong",
          "宋江几时回来？"
        ],
        [
          "say",
          "zhaoneng",
          "你便休胡说！村口有人亲眼见他进了庄门。"
        ],
        [
          "narrate",
          "宋太公扯着宋江躲进后堂。"
        ],
        [
          "leave",
          "songjiang"
        ],
        [
          "appear",
          "hero"
        ],
        [
          "appear",
          "yanshun"
        ],
        [
          "appear",
          "shiyong"
        ],
        [
          "focus",
          "hero"
        ],
        [
          "narrate",
          "庄墙外的树影里，三条汉子伏着——武龙，还有一路护送宋江回乡的燕顺、石勇。"
        ],
        [
          "say",
          "yanshun",
          "晁天王叫俺两个送哥哥到家，不想撞着这伙鸟土兵！"
        ],
        [
          "say",
          "shiyong",
          "火把虽多，不过三四十个。先打翻了那个领头的都头，余下的自然散了！"
        ],
        [
          "say",
          "hero",
          "好！杀散他们，保住太公和哥哥！"
        ],
        [
          "objective",
          "胜：打倒都头赵能（体力打到三成以下即可）\n败：武龙倒下；超过 10 回合"
        ],
        [
          "turnLimit",
          10
        ]
      ]
