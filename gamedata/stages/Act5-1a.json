      "ops": [
        {"op":12,"flag":1,"value":4294967295},
        {"op":13,"flag":0,"text":"众人继续往延安府前进。一日，天色已晚；附近却还不见客栈踪迹。只见前方一座庄园处处嫣红桃花，众人打算投宿一夜。"},
        {"op":12,"flag":1,"value":0},
        {"op":14,"flag":1,"value":18},
        {"op":15,"flag":1,"value":7},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"text":"对不起，我们是旅行的商人；附近没有任何客栈，希望能在您这里借宿一晚。"},
        {"op":12,"flag":1,"value":40},
        {"op":13,"flag":0,"text":"我们庄里今晚有事，歇不得。"},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"text":"兄台，随便借我们歇一夜，明日一早就走。"},
        {"op":12,"flag":1,"value":40},
        {"op":13,"flag":0,"text":"去去去！如果不想死就别留在这里！"},
        {"op":12,"flag":1,"value":13},
        {"op":13,"flag":0,"text":"借俺住一夜会死啊？！怎么这么不讲道理！"},
        {"op":12,"flag":1,"value":40},
        {"op":13,"flag":0,"text":"来人啊！救命啊！动粗啦！"},
        {"op":29,"flag":null,"text":"主角与桃花村庄客发生冲突。"}
      ]
    }
  ]
