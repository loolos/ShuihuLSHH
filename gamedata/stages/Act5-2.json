        {"op":12,"flag":0,"value":31},
        {"op":17,"flag":0,"value":2},
        {"op":12,"flag":0,"value":0},
        {"op":13,"flag":0,"text":"林教头有麻烦，我们去帮他！"},
        {"op":12,"flag":0,"value":16},
        {"op":13,"flag":0,"text":"好！休教那伙鸟人欺了他的家眷！"},
        {"op":12,"flag":0,"value":0},
