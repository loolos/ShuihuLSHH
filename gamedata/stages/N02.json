        {"op":12,"flag":1,"value":59},
        {"op":18,"flag":1,"value":0},
        {"op":19,"flag":1,"value":11},
        {"op":13,"flag":0,"id":1,"text":"俺是少华山头领『跳涧虎』陈达！今日要前往华阴县借粮，路经贵宝地，本着『四海之内皆兄弟』，欲借一条路。请史大郎答话！"},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"id":2,"text":"你们杀人放火，打家劫舍；犯下滔天大罪，全是些罪该万死的人！县内已经提出赏金捉拿你们，没想到你们居然敢来太岁头上动土！"},
        {"op":12,"flag":1,"value":59},
        {"op":13,"flag":0,"id":3,"text":"俺今日手下带有三四百名喽罗，如你不答应，俺只有以武力通过！喽罗皆是粗鲁人，奸淫掳掠在所难免！你再阻挡俺的去路，俺让你妻子不保！"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"id":4,"text":"此等人多说无益，必须好好教训他。王兄，那么你呢？"},
        {"op":12,"flag":1,"value":1},
        {"op":13,"flag":0,"id":5,"text":"徒儿有难，师父怎可袖手旁观？"},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"id":6,"text":"陈达！就算我肯，还有一个不肯！"},
        {"op":12,"flag":1,"value":59,"quiet":true},
        {"op":13,"flag":1,"id":7,"text":"好汉教我问谁？"},
        {"op":12,"flag":1,"value":3,"quiet":true},
        {"op":13,"flag":1,"id":8,"text":"你问得我手中这条棍棒肯时，便放你过去！"},
        {"op":12,"flag":1,"value":59},
        {"op":13,"flag":0,"id":9,"text":"欺人太甚！小子们，给我上！"},
        {"op":35,"flag":null,"value":50},
        {"op":31,"flag":null,"id":10,"text":"限制回合数 --- 50"},
        {"op":32,"flag":null,"id":11,"text":"胜利条件一 --- 打败陈达"},
        {"op":32,"flag":null,"id":12,"text":"胜利条件二 --- 所有喽罗死亡"},
        {"op":33,"flag":null,"id":13,"text":"失败条件一 --- %N死亡"},
        {"op":33,"flag":null,"id":14,"text":"失败条件二 --- 王进死亡"},
        {"op":33,"flag":null,"id":15,"text":"失败条件三 --- 史进死亡"}
      ]
    },
