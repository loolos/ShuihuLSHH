  "script": [
    {
      "on": "start",
      "do": [
        [
          "narrate",
          "且说武松被张都监诬作盗贼，改配恩州。施恩送行时叮嘱他提防途中暗算；宋江等分路照应，却被两个差人借办差之名拦在后头。一路又有两个提朴刀的汉子尾随，常与差人挤眉弄眼。到得飞云浦，四下无人，武松便在浦边停了脚步。"
        ],
        [
          "say",
          "wusong",
          "这里地名唤做甚么去处？"
        ],
        [
          "say",
          "escort-a",
          "你又不眼瞎，须见桥边牌额上写道‘飞云浦’！"
        ],
        [
          "say",
          "wusong",
          "我要净手则个。"
        ],
        [
          "say",
          "escort-b",
          "且住！休往大路上去，就到这水边来。那几个闲汉已落在后头，这里说话便宜。"
        ],
        [
          "narrate",
          "一个差人横身拦住归路，另一个伸手按住刀柄。武松戴着木枷，仍留心看着两人的脚步。"
        ],
        [
          "say",
          "wusong",
          "解送公人只管赶路，为何专拣这僻静处停住？后面那两个提刀的，又与你们是什么关系？"
        ],
        [
          "say",
          "escort-a",
          "事到如今，也不怕你知道！张都监府里早有分付，张团练又替蒋门神出了银子，要我们在路上结果你。"
        ],
        [
          "say",
          "escort-b",
          "那两个是蒋门神的徒弟，在前头封着路。杀了你，只报失脚落水，谁还来追问！"
        ],
        [
          "say",
          "wusong",
          "原来张都监假意抬举、栽赃拿我，都是与蒋门神一伙！你们押的不是人犯，是要灭口的活证。"
        ],
        [
          "narrate",
          "两个差人见阴谋已破，一个拔刀逼近，一个绕向武松背后，要趁他戴枷一齐下手。忽听后路有人大喝，脚步声直奔浦边而来。"
        ],
        [
          "appear",
          "hero"
        ],
        [
          "appear",
          "songjiang"
        ],
        [
          "appear",
          "daizong"
        ],
        [
          "appear",
          "huarong"
        ],
        [
          "appear",
          "likui"
        ],
        [
          "say",
          "hero",
          "住手！方才你们只说公差不许人跟，原来是要把武二哥骗到这里下毒手！"
        ],
        [
          "say",
          "daizong",
          "我们见你们舍了大路，越走越偏，便抄小路追来。方才那番杀人灭口的话，已经听得明白！"
        ],
        [
          "say",
          "songjiang",
          "武二郎愿依法服刑，我等才不拦押解；如今你们受人买嘱谋害性命，宋江怎能袖手！兄弟们，先救人！"
        ],
        [
          "say",
          "huarong",
          "二郎留心身后！我照住那提刀的，莫叫他们两面夹攻。"
        ],
        [
          "say",
          "likui",
          "拿了贼人的银子，还敢装作官差害好汉！哥哥，俺来截住他们！"
        ],
        [
          "say",
          "wusong",
          "多谢诸位赶来！这木枷困不住武松，待我挣开，再问他们一问！"
        ],
        [
          "borrowEquip",
          "wusong",
          0,
          0
        ],
        [
          "buff",
          "wusong",
          "defense",
          {
            "pct": -50
          }
        ],
        [
          "objective",
          "击败所有敌人（含增援）；第2至第6回合每回合有一波增援。武松倒下或超过15回合失败。"
        ],
        [
          "turnLimit",
          15
        ]
      ]
    },
    {
      "on": {
        "turn": 2
      },
      "do": [
        [
          "narrate",
          "武松把枷只一扭，折做两半个，扯开封皮，将来撇在水里。"
        ],
        [
          "cleanse",
          "wusong"
        ],
        [
          "appear",
          "shijin"
        ],
        [
          "appear",
          "linchong"
        ],
        [
          "appear",
          "duqian"
        ],
        [
          "appear",
          "songwan"
        ],
        [
          "say",
          "shijin",
          "宋三哥，武二哥！我回山禀过晁天王，请来林教头、杜迁、宋万相助。听说你们出了孟州，我们便沿路追来了！"
        ],
        [
          "say",
          "linchong",
          "我也受过这般押解暗害，岂容他们再伤好汉！"
        ],
        [
          "narrate",
          "蒋门神的两个徒弟提朴刀从前路赶出，正撞上史进等人赶到。前后援手会合，宋江招呼众人先制住四名杀手，再问幕后主谋的下落。"
        ],
        [
          "narrate",
          "两名蒋门神徒弟带着帮手从前路赶来！"
        ],
        [
          "appear",
          "disciple-a"
        ],
        [
          "appear",
          "disciple-b"
        ],
        [
          "appear",
          "wave2-1"
        ],
        [
          "appear",
          "wave2-2"
        ],
        [
          "appear",
          "wave2-3"
        ],
        [
          "appear",
          "wave2-4"
        ]
      ]
    },
    {
      "on": "enemiesDefeated",
      "do": [
        [
          "narrate",
          "徒弟临死招认：小人两个是蒋门神徒弟。今被师父和张团练定计，使小人两个来相帮防送公人，一处来害好汉。三名主谋此刻正在鸳鸯楼饮酒。"
        ],
        [
          "say",
          "wusong",
          "不杀得张都监，如何出得这口恨气！"
        ],
        [
          "narrate",
          "众人带武松回孟州，查明主谋；林冲、杜迁、宋万自此一同接应。"
        ],
        [
          "victory",
          "脱险飞云浦，回城辨主谋。"
        ]
      ],
      "if": "all-waves-arrived"
    },
    {
      "on": {
        "dead": "wusong"
      },
      "do": [
        [
          "defeat",
          "武松倒下，众人未能脱险。"
        ]
      ]
    },
