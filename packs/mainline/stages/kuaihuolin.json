        ],
        [
          "appear",
          "guard-8"
        ],
        [
          "appear",
          "disciple-a"
        ],
        [
          "appear",
          "disciple-b"
        ]
      ]
    },
    {
      "on": {
        "turn": 4
      },
      "do": [
        [
          "narrate",
          "张团练听闻快活林起了争斗，带着军汉和头目从侧街赶来，为蒋门神助阵。"
        ],
        [
          "appear",
          "zhangtuanlian"
        ],
        [
          "appear",
          "zhang-rescue-1"
        ],
        [
          "appear",
          "zhang-rescue-2"
        ],
        [
          "appear",
          "zhang-rescue-3"
        ],
        [
          "appear",
          "zhang-rescue-4"
        ],
        [
          "appear",
          "zhang-rescue-5"
        ],
        [
          "appear",
          "zhang-rescue-6"
        ],
        [
          "say",
          "zhangtuanlian",
          "蒋兄莫慌，我带人来了！谁敢在快活林撒野？"
        ],
        [
          "say",
          "wusong",
          "你纵容蒋门神夺店伤人，如今还要带兵帮凶？来多少，俺便打退多少！"
        ],
        [
          "appear",
          "daizong"
        ],
        [
          "appear",
          "huarong"
        ],
        [
          "appear",
          "likui"
        ],
        [
          "say",
          "daizong",
          "宋三哥！我同花荣、李逵一路寻到孟州，听说哥哥来了快活林，便赶来相会。"
        ],
        [
          "say",
          "huarong",
          "兄长久无音信，今日总算见着了。眼前这伙人欺压好汉，我等岂能袖手！"
        ],
        [
          "say",
          "likui",
          "哥哥有话，铁牛听着！那伙仗势欺人的，俺来对付！"
        ],
        [
          "narrate",
          "宋江招呼三人相助，嘱咐不可伤了店家客人。"
        ]
      ]
    },
    {
      "on": {
        "used": "wusong",
        "skills": [
          "yuanyang-jiao"
        ]
      },
      "do": [
        [
          "narrate",
          "武松虚影一晃，玉环步转身，鸳鸯脚连出；众人替他挡住围上来的打手。"
        ]
      ]
    },
    {
      "on": {
        "dead": "jiangmenshen"
      },
      "do": [
        [
          "narrate",
          "蒋门神被武松打得站立不住，退到路旁求饶；其余敌人仍在，众人继续迎战。"
        ]
      ]
    },
    {
      "on": {
        "dead": "zhangtuanlian"
      },
      "do": [
        [
          "narrate",
          "张团练败下阵来，手下仍在抵抗；先打退其余敌人，休叫他们再伤店家！"
        ]
      ]
    },
    {
      "on": "allEnemiesDefeated",
      "do": [
        [
          "show",
          "hero",
          "wusong"
        ],
        [
          "show",
          "songjiang",
          "wusong"
        ],
        [
          "show",
          "daizong",
          "wusong"
        ],
        [
          "show",
          "huarong",
          "wusong"
        ],
        [
          "show",
          "likui",
          "wusong"
        ],
        [
          "show",
          "jiangmenshen",
          "wusong"
        ],
        [
          "show",
          "zhangtuanlian",
          "wusong"
        ],
        [
          "say",
          "wusong",
          "若要我饶你性命，只要依我三件事。"
        ],
        [
          "say",
          "jiangmenshen",
          "好汉饶我！休说三件，便是三百件，我也依得。"
        ],
        [
          "say",
          "wusong",
          "第一件，离了快活林，将一应家火什物随即交还施恩。第二件，央请快活林为头为脑的英雄豪杰，都来与施恩陪话。"
        ],
        [
          "say",
          "wusong",
          "第三件，你交割了便连夜回乡去，不许你在孟州住！"
        ],
        [
          "say",
          "jiangmenshen",
          "小人都依，都依！"
        ],
        [
          "narrate",
          "张团练不敢再战，招呼还能走动的手下，扶起蒋门神，带着伤者狼狈逃走。众人只将他们打败赶走，并未取他们性命。"
        ],
        [
          "hide",
          "jiangmenshen"
        ],
        [
          "hide",
          "zhangtuanlian"
        ],
        [
          "say",
          "shien",
          "兄长这一顿拳脚，快活林又回到小弟手里了！诸位好汉的恩情，施恩终身不忘。"
        ],
        [
          "say",
          "songjiang",
          "小管营安心养伤，往后买卖公道些，莫再与蒋门神私下争斗。"
        ],
        [
          "victory",
          "击退蒋门神与张团练众人，快活林重归施恩。"
        ]
      ]
    },
    {
      "on": {
        "dead": "wusong"
      },
      "do": [
        [
          "defeat",
          "武松倒下，众人未能脱险。"
        ]
      ]
    },
    {
      "on": {
        "dead": "shien"
      },
      "do": [
        [
          "defeat",
          "施恩倒下，众人未能护住他。"
        ]
      ]
    }
  ]
}
