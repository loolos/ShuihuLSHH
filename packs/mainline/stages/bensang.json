        [
          "narrate",
          "众土兵正要四散，只听得庄门呀地开了，宋江抢将出来，大叫：「众兄弟住手！」"
        ],
        [
          "appear",
          "songjiang"
        ],
        [
          "move",
          "songjiang",
          17,
          11
