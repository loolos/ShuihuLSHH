  ],
  "script": [
    {
      "on": "start",
      "do": [
        [
          "title",
          "当夜 · 张都监府后院"
        ],
        [
          "narrate",
          "且说众好汉随武松折回孟州，趁夜潜入张都监府后园，在前院分守门路，约定听号相应。武松先揪住马院里的后槽问话。"
        ],
        [
          "say",
          "attendant",
          "好汉饶命！张都监和张团练、蒋门神，他三个一日都在鸳鸯楼上吃酒，这早晚还未散哩。"
        ],
        [
          "narrate",
          "武松问明了路，把后槽捆了丢在马院里，独自掩到楼梯边听着。"
        ],
        [
          "leave",
          "attendant"
        ],
        [
          "move",
          "wusong",
          13,
          9
        ],
        [
          "say",
          "jiangmenshen",
          "亏了相公与小人报了冤仇。再当重重地答报恩相。"
        ],
        [
          "say",
          "zhangdujian",
          "不是看我兄弟张团练面上，谁肯干这等的事！"
        ],
        [
          "say",
          "zhangtuanlian",
          "这一夜四个对付他一个，有甚么不了！再有几个性命也没了。"
        ],
        [
          "say",
          "jiangmenshen",
          "小人也分付徒弟来，只教就那里下手，结果了快来回报。"
        ],
        [
          "narrate",
          "武松听了，心头那把无明业火高三千丈，冲破了青天。他悄悄退回院中，招呼众人。"
        ],
        [
          "move",
          "wusong",
          11,
          15
        ],
        [
          "appear",
          "hero"
        ],
        [
          "appear",
          "songjiang"
        ],
        [
          "appear",
          "shijin"
        ],
        [
          "appear",
          "daizong"
        ],
        [
          "appear",
          "huarong"
        ],
        [
          "appear",
          "likui"
        ],
        [
          "appear",
          "linchong"
        ],
        [
          "appear",
          "duqian"
        ],
        [
          "appear",
          "songwan"
        ],
        [
          "say",
          "songjiang",
          "好个官府，竟与恶霸串通谋害人命！"
        ],
        [
          "say",
          "linchong",
          "当年高太尉害我，也是这般勾当。今日正好替二郎出这口气！"
        ],
        [
          "face",
          "wusong",
          "zhangdujian"
        ],
        [
          "say",
          "wusong",
          "张都监！飞云浦四个，已等不得你们的回报了！打虎武松在此！"
        ],
        [
          "say",
          "zhangdujian",
          "有贼！来人！前院、两厢、后门一齐围住！我等守在楼上，休教他们近身！"
        ],
        [
          "say",
          "zhangtuanlian",
          "各处军汉听令，先拿下这伙贼人！外头巡夜的也都唤进来！"
        ],
        [
          "say",
          "jiangmenshen",
          "徒弟们，给我围上去！"
        ],
        [
          "say",
          "songjiang",
          "他们要从四面合围。众位互相照应，先挡住院中的军汉！"
        ],
        [
          "objective",
          "击败三凶与全部武装守卫；第2、4、6回合有增援，最后一批到齐后全灭敌军获胜。武松倒下或超过20回合失败。"
        ],
        [
          "turnLimit",
          20
        ]
      ]
    },
    {
      "on": {
        "dead": "jiangmenshen"
      },
      "do": [
        [
          "say",
          "jiangmenshen",
          "武二郎……快活林那顿打还未消，今夜又撞在你手里！"
        ],
        [
          "say",
          "wusong",
          "你这厮夺人买卖、设计害我。快活林饶你一命，今夜却饶你不得！"
        ],
        [
          "narrate",
          "蒋门神急要挣扎时，武松早落一刀，劈脸剁着，和那交椅都砍翻了。"
        ]
      ]
    },
    {
      "on": {
        "dead": "zhangdujian"
      },
      "do": [
        [
          "say",
          "zhangdujian",
          "武松！我抬举你做亲随，待你不薄，你怎敢……"
        ],
        [
          "say",
          "wusong",
          "你抬举我，原来是要我的性命！恩将仇报的是你，不是武松！"
        ],
        [
          "narrate",
          "张都监方才伸得脚动，被武松当时一刀，齐耳根连脖子砍着，扑地倒在楼板上。"
        ]
      ]
    },
    {
      "on": {
        "dead": "zhangtuanlian"
      },
      "do": [
        [
          "say",
          "zhangtuanlian",
          "反了！一个配军也敢杀朝廷命官！"
        ],
        [
          "say",
          "wusong",
          "你替蒋门神出头，买嘱公人在飞云浦害我，还说甚么命官！"
        ],
        [
          "narrate",
          "张团练终是武官出身，虽然酒醉，还有些气力，提起一把交椅抡将来；武松早接个住，就势一推，赶入去一刀砍翻。"
        ]
      ]
    },
    {
      "on": "enemiesDefeated",
      "do": [
        [
          "narrate",
          "三凶伏诛，府中武装守卫尽被打散。武松在粉壁题下「杀人者，打虎武松也！」众好汉护着他越城而出，连夜望十字坡去了。"
        ],
        [
          "victory",
          "血溅鸳鸯楼，众好汉护着武松杀出孟州。"
        ]
      ],
      "if": "all-waves-arrived"
    },
    {
      "on": {
        "dead": "wusong"
      },
      "do": [
        [
          "defeat",
          "武松倒下，众人未能脱险。"
        ]
      ]
    },
    {
      "on": {
        "turn": 2
      },
      "do": [
        [
          "narrate",
          "院中喊杀声起，两厢的军汉与弓手赶来，从东西两面夹攻！"
        ],
        [
          "appear",
          "wave2-1"
        ],
        [
          "appear",
          "wave2-2"
        ],
        [
          "appear",
          "wave2-3"
        ],
        [
          "appear",
          "wave2-4"
        ],
        [
          "appear",
