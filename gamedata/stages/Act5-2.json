      "head": [],
      "ops": [
        {"op":12,"flag":0,"value":4294967295},
        {"op":13,"flag":0,"text":"众人来到东京，正待进酒铺歇脚，街头却横过四个泼皮，拦住了去路。"},
        {"op":12,"flag":0,"value":1020},
        {"op":13,"flag":0,"text":"和尚，打俺们地面经过，怎地不留下些买酒钱？"},
        {"op":12,"flag":0,"value":16},
        {"op":13,"flag":0,"text":"洒家不曾吃你的酒，倒来问洒家讨钱？"},
        {"op":12,"flag":0,"value":1020},
        {"op":13,"flag":0,"text":"少说闲话！留下银子，放你过去；若说半个不字，教你认得俺们！"},
        {"op":12,"flag":0,"value":3},
        {"op":13,"flag":0,"text":"这几个鸟人，倒来寻鲁大哥的晦气！"},
        {"op":12,"flag":0,"value":16},
        {"op":13,"flag":0,"text":"兄弟们且站开，休来插手！只这几个腌臜泼才，洒家一个便料理了！"},
        {"op":12,"flag":0,"value":0},
        {"op":13,"flag":0,"text":"好，我们就在旁边，看大哥的手段！"},
        {"op":12,"flag":0,"value":0},
        {"op":115,"flag":null,"text":"ally"},
        {"op":12,"flag":0,"value":3},
        {"op":115,"flag":null,"text":"ally"},
        {"op":12,"flag":0,"value":13},
        {"op":115,"flag":null,"text":"ally"},
        {"op":12,"flag":0,"value":15},
        {"op":115,"flag":null,"text":"ally"},
        {"op":12,"flag":0,"value":5},
        {"op":115,"flag":null,"text":"ally"},
        {"op":35,"flag":null,"value":5},
        {"op":31,"flag":null,"text":"五回合内打倒四名泼皮；鲁智深倒下或超时则失败。其余好汉旁观，不参加战斗。"}
      ]
    },
    {
      "trigger": {"kind":"turn","turn":2},
      "cond": {"type":0,"arg":0},
      "head": [],
      "ops": [
        {"op":12,"flag":0,"value":16},
        {"op":13,"flag":0,"text":"方才那股横劲哪里去了？尽管上来，休教洒家一个个寻你！"}
      ]
    },
    {
      "trigger": {"kind":"cond"},
      "cond": {"type":1,"arg":255},
      "head": [],
      "ops": [
        {"op":12,"flag":0,"value":4294967295},
        {"op":13,"flag":0,"text":"四个泼皮被打得东倒西歪，连声告饶，哪里还敢逞强。"},
        {"op":12,"flag":0,"value":16},
        {"op":13,"flag":0,"text":"有手有脚，不去寻个正经营生，却在街头欺人！往后再教洒家撞见，可没今日这般便宜！"},
        {"op":12,"flag":0,"value":0},
        {"op":13,"flag":0,"text":"大哥还未使禅杖，他们便撑不住了。"},
        {"op":12,"flag":0,"value":16},
        {"op":13,"flag":0,"text":"说起气力，且教你们看个明白。"},
        {"op":12,"flag":0,"value":16},
        {"op":14,"flag":0,"value":4},
        {"op":15,"flag":0,"value":14},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":0,"value":16},
        {"op":108,"flag":null,"value":0},
        {"op":12,"flag":0,"value":4294967295},
        {"op":13,"flag":0,"text":"智深走到柳树旁，束紧腰间衣带，两手抱住树身，腰胯间猛一发力！"},
        {"op":118,"flag":null,"value":0,"args":{"cells":[{"x":3,"y":11},{"x":2,"y":12},{"x":3,"y":12},{"x":4,"y":12},{"x":3,"y":13},{"x":4,"y":13}]}},
        {"op":12,"flag":0,"value":4294967295},
        {"op":13,"flag":0,"text":"只听土响根摧，一株垂杨柳竟被他连根拔起。泼皮们看得目瞪口呆，拜服散去。"},
        {"op":12,"flag":0,"value":3},
        {"op":13,"flag":0,"text":"鲁大哥这番手段，今日可开了眼！"},
        {"op":12,"flag":0,"value":16},
        {"op":13,"flag":0,"text":"拔树算甚么！待洒家再使一路禅杖与你们看。"},
        {"op":12,"flag":0,"value":16},
        {"op":14,"flag":0,"value":6},
        {"op":15,"flag":0,"value":13},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":0,"value":16},
        {"op":119,"flag":null,"value":0},
        {"op":119,"flag":null,"value":0},
        {"op":12,"flag":0,"value":11},
        {"op":13,"flag":0,"text":"好使得！"},
        {"op":12,"flag":0,"value":11},
        {"op":14,"flag":0,"value":8},
        {"op":15,"flag":0,"value":13},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":0,"value":16},
        {"op":13,"flag":0,"text":"哪位官人在那里喝彩？既看得入眼，何不过来相叙？"},
        {"op":12,"flag":0,"value":11},
        {"op":13,"flag":0,"text":"这条禅杖少说也有六十来斤，师兄使来却似浑不费力，教人好生钦佩！"},
        {"op":12,"flag":0,"value":16},
        {"op":13,"flag":0,"text":"洒家关西鲁达，如今法名智深。未敢请教官人姓名？"},
        {"op":12,"flag":0,"value":11},
        {"op":13,"flag":0,"text":"在下林冲，在东京充个禁军枪棒教头。"},
        {"op":12,"flag":0,"value":16},
        {"op":13,"flag":0,"text":"莫不是林提辖的公子？洒家在东京，正愁少个相知的弟兄！"},
        {"op":12,"flag":0,"value":4294967295},
        {"op":13,"flag":0,"text":"二人越说越投契，林冲拜智深为兄。众人就在酒铺前坐下，彼此叙礼。"},
        {"op":12,"flag":0,"value":3},
        {"op":13,"flag":0,"text":"林教头，在下是王进王教头的徒弟，吾师有一信要转交给你。"},
        {"op":12,"flag":0,"value":11},
        {"op":13,"flag":0,"text":"哦？我看看……王兄的好意，林冲心领了。只是在东京尚有家眷，不能说走便走。"},
        {"op":12,"flag":0,"value":0},
        {"op":13,"flag":0,"text":"教头今日怎地恰从这里经过？"},
        {"op":12,"flag":0,"value":11},
        {"op":13,"flag":0,"text":"今日陪拙荆到庙里还愿，见师兄舞杖看得入神，便让她与丫头先去烧香了。"},
        {"op":12,"flag":0,"value":16},
        {"op":13,"flag":0,"text":"放着夫人独自去上香，不要紧么？"},
        {"op":12,"flag":0,"value":11},
        {"op":13,"flag":0,"text":"就在近处，料也无妨。来，诸位且饮一杯。"},
        {"op":12,"flag":0,"value":31},
        {"op":13,"flag":0,"text":"官人！不要再喝酒了！夫人在庙前被一群登徒子纠缠住了！"},
        {"op":12,"flag":0,"value":31},
        {"op":14,"flag":0,"value":9},
        {"op":15,"flag":0,"value":13},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":0,"value":11},
        {"op":13,"flag":0,"text":"在哪里？！"},
        {"op":12,"flag":0,"value":31},
        {"op":13,"flag":0,"text":"方才经过五岳楼，几个富家子弟拦住夫人。我看情势不妙，便脱身来寻官人！"},
        {"op":12,"flag":0,"value":11},
        {"op":13,"flag":0,"text":"锦儿，快带路！诸位，林冲先行一步！"},
        {"op":12,"flag":0,"value":11},
        {"op":14,"flag":0,"value":12},
        {"op":15,"flag":0,"value":10},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":0,"value":11},
