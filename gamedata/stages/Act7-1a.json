        {"op":12,"flag":1,"value":1015},
        {"op":12,"flag":1,"value":1016},
        {"op":12,"flag":1,"value":1017},
        {"op":12,"flag":1,"value":1018},
        {"op":12,"flag":1,"value":1019},
        {"op":12,"flag":1,"value":1020},
        {"op":12,"flag":1,"value":1021},
        {"op":12,"flag":1,"value":1022},
        {"op":12,"flag":1,"value":1023},
        {"op":12,"flag":1,"value":1024},
        {"op":12,"flag":0,"value":1025},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"id":14,"text":"陆谦！你竟然想出卖我！"},
        {"op":12,"flag":1,"value":64},
        {"op":13,"flag":0,"id":15,"text":"林冲，我等虽然无仇；但是受人之托，忠人之事。高太尉答应只要我带着你的首级回去，他会给我优厚的奖赏..."},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"id":16,"text":"你这无耻之徒！为了高官厚禄就可以当高俅的爪牙吗！"},
        {"op":12,"flag":1,"value":64},
        {"op":13,"flag":0,"id":17,"text":"哈哈哈...！没错！跟着高太尉荣华富贵享用不尽；你能当我的踏脚石，也算是你的荣幸了！手下，把他们一个都不留地杀光！"},
        {"op":12,"flag":1,"value":64},
