  ],
  "script": [
    {
      "on": "start",
      "do": [
        [
          "title",
          "清风寨 · 寨门"
        ],
        [
          "narrate",
          "次日，秦明、宋江引着众好汉，从西南一路来到清风寨。黄信守在东北寨门前，身边列着刀枪卫队，弓手在后压阵。寨中几队官兵分守道路，刘高的家丁也各执刀棒，闻声赶来拦截。"
        ],
        [
          "say",
          "qinming",
          "黄信贤弟，开门！秦明有话和你说。"
        ],
        [
          "focus",
          "huangxin"
        ],
        [
          "say",
          "huangxin",
          "总管也反了？朝廷不曾亏负你，如何倒引着强人来打寨子！"
        ],
        [
          "say",
          "qinming",
          "众兄弟休伤黄信性命，待我近前劝他。"
        ],
        [
          "say",
          "songjiang",
          "刘高家里那伙家丁，却一个也休放走！"
        ],
        [
          "buff",
          "huangxin",
          "defense",
          {
            "pct": 200
          }
        ],
        [
          "objective",
          "胜利：秦明劝降黄信或将其擒住，并打退仍在抵抗的寨兵与刘高家丁（含增援）\n失败：宋江或秦明倒下；超过20回合"
        ],
        [
          "turnLimit",
          20
        ]
      ]
    },
    {
      "on": {
        "turn": 3
      },
      "do": [
        [
          "narrate",
          "左边道口一阵喧嚷，刘高又调来几个家丁，径向众好汉杀来。"
        ],
        [
          "appear",
          "jd2-1"
        ],
        [
          "appear",
          "jd2-2"
        ],
        [
          "appear",
          "jd2-3"
        ]
      ]
    },
    {
      "on": {
        "turn": 5
      },
      "do": [
        [
          "narrate",
          "南边来路又有家丁赶到，想从后面截断众好汉的退路。"
        ],
        [
          "appear",
          "jd2-4"
        ],
        [
          "appear",
          "jd2-5"
        ],
        [
          "appear",
          "jd2-6"
        ]
      ]
    },
    {
      "on": {
        "near": "huangxin",
        "by": "qinming"
      },
      "unless": "weak",
      "do": [
        [
          "say",
          "qinming",
          "贤弟，你又无老小，何不听我言语，也去山寨入伙，免受那文官的气？"
        ],
        [
          "say",
          "huangxin",
          "总管休说！黄信食君之禄，岂肯随你落草！看剑！"
        ]
      ]
    },
    {
      "on": {
        "hp": "huangxin",
        "below": 50
      },
      "do": [
        [
          "narrate",
          "黄信身上带伤，手里的丧门剑渐渐乱了——秦明再到他身边劝一劝，或许肯降。"
        ],
        [
          "flag",
          "weak"
        ]
      ]
    },
    {
      "on": {
        "near": "huangxin",
        "by": "qinming"
      },
      "if": "weak",
      "do": [
        [
          "say",
          "qinming",
          "贤弟，我的妻小都被慕容知府杀了，秦明已是无家可归。山上宋公明哥哥仗义疏财，专一结识天下好汉，你何苦替刘高那厮卖命！"
        ],
        [
          "say",
          "huangxin",
          "既然恩官在彼，黄信安敢不从。只是不曾听得说有宋公明在山上。"
        ],
        [
          "say",
          "songjiang",
          "黄都监，宋江在此！"
        ],
        [
          "say",
          "huangxin",
          "原来及时雨宋公明哥哥也在这里！黄信愿降！"
        ],
        [
          "defect",
          "huangxin",
          "ally"
        ],
        [
          "narrate",
          "黄信收了剑，下马拜降。两个随侍多年的亲随赶到身边，听候吩咐，寨中其余官兵却仍持械列阵。"
        ],
        [
          "defect",
          "hx-1",
          "ally"
        ],
        [
          "leave",
          "hx-1"
        ],
        [
          "defect",
          "hx-2",
          "ally"
        ],
        [
          "leave",
          "hx-2"
        ],
        [
          "narrate",
          "黄信向两个亲随吩咐道：「你两个随我多年，若还信得过黄信，便收了兵器，退到一旁，休再厮杀。」二人应声退开。"
        ],
        [
          "narrate",
          "其余官兵中有人喝道：「黄都监要去便去！俺们吃的是朝廷粮饷，怎肯跟你落草！众人守住寨子，休放走了强人！」"
        ],
        [
          "say",
          "qinming",
          "各人自有各人的去路，不必强求。贤弟，你且与亲随退开，余下的由我们应付。"
        ],
        [
          "flag",
          "surrendered"
        ]
      ]
    },
    {
      "on": {
        "dead": "huangxin"
      },
      "do": [
        [
          "narrate",
          "黄信被打落马下，众人一齐上前拿住。秦明亲解其缚，再三劝说。黄信叹道：「既然恩官在彼，黄信安敢不从。」只有两个随侍多年的亲随收住刀枪，寨中其余官兵并不肯降。"
        ],
        [
          "defect",
          "hx-1",
          "ally"
        ],
        [
          "leave",
          "hx-1"
        ],
        [
          "defect",
          "hx-2",
          "ally"
        ],
        [
          "leave",
          "hx-2"
        ],
        [
          "narrate",
          "黄信向两个亲随吩咐道：「你两个随我多年，若还信得过黄信，便收了兵器，退到一旁，休再厮杀。」二人应声退开。"
        ],
        [
          "narrate",
          "其余官兵中有人喝道：「黄都监要去便去！俺们吃的是朝廷粮饷，怎肯跟你落草！众人守住寨子，休放走了强人！」"
        ],
        [
          "say",
          "qinming",
          "各人自有各人的去路，不必强求。贤弟，你且与亲随退开，余下的由我们应付。"
        ],
        [
          "flag",
          "surrendered"
        ]
      ]
    },
    {
      "on": "allEnemiesDefeated",
      "if": "surrendered",
      "do": [
        [
          "narrate",
          "仍在抵抗的寨兵与刘高家丁都被打散，清风寨中再无人拦路。花荣先去家里接出老小。"
        ],
        [
          "narrate",
          "王英抢了刘高的妇人，要她做压寨夫人。燕顺跳起身来，把那妇人一刀挥为两段：「这等淫妇，留她何用！」王英大怒，宋江劝住了，许他日后另娶一个好的。"
        ],
        [
          "appear",
          "mei"
        ],
        [
          "move",
          "huarong",
          17,
          8
        ],
        [
          "move",
          "qinming",
          16,
          8
        ],
        [
          "face",
          "mei",
          "qinming"
        ],
        [
          "face",
          "qinming",
          "mei"
        ],
        [
          "face",
          "huarong",
          "mei"
        ],
        [
          "say",
          "huarong",
          "妹子，这位便是秦总管。宋公明哥哥作主，将你许配与他。"
        ],
        [
          "say",
          "mei",
          "小妹见过总管。"
        ],
        [
          "say",
          "qinming",
