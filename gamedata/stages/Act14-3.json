      "head": [1,42,1,0,0,0,28,2,0],
      "ops": [
        {"op":12,"flag":1,"value":68},
        {"op":18,"flag":1,"value":0},
        {"op":19,"flag":1,"value":61},
        {"op":13,"flag":0,"id":1,"text":"来来，各位不要客气，尽量喝！"},
        {"op":12,"flag":1,"value":12},
        {"op":13,"flag":0,"id":2,"text":"王头领，有关我们入伙的事...？"},
        {"op":12,"flag":1,"value":68},
        {"op":13,"flag":0,"id":3,"text":"众位豪杰特定到此来聚义，只恨敝山小寨是一洼之水，哪里容得下这么多真龙？在下准备一些小礼物，当作盘缠；请你们另投名山大寨，做一番事业。"},
        {"op":12,"flag":1,"value":1001},
        {"op":14,"flag":1,"value":26},
        {"op":15,"flag":1,"value":30},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":1002},
        {"op":14,"flag":1,"value":26},
        {"op":15,"flag":1,"value":29},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":1003},
        {"op":14,"flag":1,"value":26},
        {"op":15,"flag":1,"value":28},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":12},
        {"op":13,"flag":0,"id":4,"text":"在下久闻梁山招贤纳士，所以特地率领同伙相投；既然王头领无法收容我等，那么我等应当自行告退。王头领所赐之黄金白银，决不敢拿；并非我敢自夸，我等还有点盘缠可用。请王头领收回金银，我等就此告别。"},
        {"op":12,"flag":1,"value":68},
        {"op":13,"flag":0,"id":5,"text":"何必推托？不是敝山不接纳众位豪杰，只是山寨粮少房稀，恐怕会误了足下的前途，毁了诸位的威名。休怪，休怪。"},
        {"op":12,"flag":1,"value":11},
        {"op":18,"flag":1,"value":0},
        {"op":19,"flag":1,"value":62},
        {"op":12,"flag":1,"value":4294967295,"quiet":true},
        {"op":13,"flag":1,"id":6,"text":"只见吴用把手来拈髭须。"},
        {"op":12,"flag":1,"value":11,"quiet":true},
        {"op":13,"flag":0,"id":7,"text":"就算梁山粮少房稀，并非没有解决的方法！山寨中粮食短少，可以到四邻村镇去借；山场水泊，树木茂盛，要盖千间房屋也没有问题。这分明是拿藉口赶我们下山！我们千里投名、万里投主；林冲虽然不才，如果头领肯收留，当以一死向前，实为平生之幸。我不是为了要些许的金银而来，而你却想用钱财把我们打发下山？岂不小看了我？！"},
        {"op":12,"flag":1,"value":68},
        {"op":13,"flag":0,"id":8,"text":"无礼！我毕竟也是堂堂一山寨之主，岂能让你撒野？！喔...你就是那个『豹子头』林冲啊...你的通缉令已经从东京贴到这附近，官府的每一个人都想要你的项上人头换取功名！你想我能收留你这个祸害吗？！"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"id":9,"text":"(不好，林冲又要发作了...)"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"id":10,"text":"你不过是个没考上功名的穷书生，胸中又没丝毫学问，怎么做得了山寨之主！"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"id":11,"text":"林冲！不要冲动！"},
        {"op":12,"flag":1,"value":12},
        {"op":13,"flag":0,"id":12,"text":"林教头！不要为了我们坏了大义！"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"id":13,"text":"这是个笑里藏刀之人！我今日绝对不放过他！"},
        {"op":12,"flag":1,"value":68},
        {"op":13,"flag":0,"id":14,"text":"哈哈哈...嘲笑我没什么本事？可是今天你们却会死在这么个考不上功名的穷书生手下！我好意想花些路费请你们走，你们却敬酒不吃吃罚酒！喽罗们，动手！"},
        {"op":12,"flag":1,"value":11,"quiet":true},
        {"op":13,"flag":1,"id":15,"text":"你这嫉贤妒能的贼，不杀了要你何用！你也无大量之才，也做不得山寨之主！"},
        {"op":12,"flag":1,"value":68,"quiet":true},
        {"op":29,"flag":null,"id":16,"text":"一场血战，即将拉开战幕。。。"}
      ]
    }
  ]
