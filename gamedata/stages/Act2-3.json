      "head": [1,27,1,0,0,0,34,2,0],
      "ops": [
        {"op":12,"flag":1,"value":4294967295},
        {"op":18,"flag":1,"value":1},
        {"op":19,"flag":1,"value":10},
        {"op":13,"flag":0,"id":1,"text":"话说史家村附近，有一群山贼霸占少华山，为首三名头目，底下聚集着五七百个小喽罗打家劫舍。领头的『神机军师』朱武，能使两口双刀；精通阵法，长于谋略。『跳涧虎』陈达，使一条白点钢枪。『锦花蛇』杨春，使一口大杆刀。"},
        {"op":12,"flag":1,"value":5},
        {"op":12,"flag":1,"value":59},
        {"op":12,"flag":0,"value":15},
        {"op":12,"flag":1,"value":5},
        {"op":13,"flag":0,"id":2,"text":"我们兄弟在这个少华山上大秤分金、整套穿衣、倒也是招惹了不少官府商人；今日听说华阴县出三千贯赏金要捉拿我们三人，总有一天官军会打上山寨。只是山寨中钱粮不是很多，何不乘机先去四周乡镇劫些粮草回来？等到官军进攻时，才有粮食可以长期御敌？"},
        {"op":12,"flag":1,"value":59},
        {"op":13,"flag":0,"id":3,"text":"大哥说的是。俺马上带一两百个喽罗去华阴县借粮，看他们给是不给！"},
        {"op":12,"flag":1,"value":15},
        {"op":13,"flag":0,"id":4,"text":"二哥有所不知，如果要去华阴县，必须经过史家村；史家村的『九纹龙』史进是头猛虎，不可去招惹他；况且史家村三四百家都由史进组织训练，可不同于普通村庄。二哥何不去蒲城县？那里防备不周，必可有所收获。"},
        {"op":12,"flag":1,"value":59},
        {"op":13,"flag":0,"id":5,"text":"他奶奶的！当强盗连官府都不怕了，难道还怕一个村长！东怕一个村长，西怕一个县令，那在江湖上还混的下去吗？！"},
        {"op":12,"flag":1,"value":15},
        {"op":13,"flag":0,"id":6,"text":"哥哥说得有理；但是这个史进实在厉害...."},
        {"op":12,"flag":1,"value":5},
        {"op":13,"flag":0,"id":7,"text":"我也听说这个人十分英雄，有真本事。贤弟，还是不要去吧！"},
        {"op":12,"flag":1,"value":59},
        {"op":13,"flag":0,"id":8,"text":"啊～～！你们两个闭上你们的鸟嘴！『长别人志气，灭自己威风！』他也是人，难道有三头六臂吗？俺不信！"},
        {"op":12,"flag":1,"value":59},
        {"op":13,"flag":0,"id":9,"text":"你们快去备俺的马来！现在俺就带人踏平史家村，放火烧掉华阴县！"},
        {"op":12,"flag":1,"value":59},
        {"op":14,"flag":1,"value":9},
        {"op":15,"flag":1,"value":16},
        {"op":17,"flag":0,"value":1},
        {"op":29,"flag":null,"id":10,"text":"少华山山贼要踏平史家村，形势危急！"}
      ]
    }
  ]
}
