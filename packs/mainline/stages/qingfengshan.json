        ],
        [
          "say",
          "likui",
          "鸟人使绊子！放俺起来，一个个都砍了！"
        ],
        [
          "narrate",
          "喽啰把三个都缚了，点起火把，一步步解上山寨来。"
        ],
        [
          "leave",
          "songjiang"
        ],
        [
          "leave",
          "hero"
        ],
        [
          "leave",
          "likui"
        ],
        [
          "victory",
          "宋江、武龙、李逵在清风山下吃绊脚索绊翻，被喽啰拿上山寨去了。"
        ]
      ]
    },
    {
      "on": "enemiesDefeated",
