        {"op":19,"flag":1,"value":60},
        {"op":13,"flag":0,"text":"%N一行人在延安府待了三天，也就告别了王进，往梁山泊而行。不下数日，已来到梁山下..."},
        {"op":12,"flag":1,"value":4294967295,"quiet":true},
        {"op":13,"flag":1,"text":"但见八百里梁山泊，港汊纵横，芦苇连天，宛子城雄踞在山顶上。"},
        {"op":12,"flag":1,"value":1001},
        {"op":14,"flag":1,"value":9},
        {"op":15,"flag":1,"value":8},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":1001},
        {"op":13,"flag":0,"text":"报告大王！东溪村晁盖求见！"},
