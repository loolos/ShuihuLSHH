  "blocks": [
    {
      "trigger": {"kind":"turn","turn":0},
      "cond": {"type":0,"arg":0},
      "head": [1,69,4,1,1,1,27,2,0],
      "ops": [
        {"op":12,"flag":1,"value":14},
        {"op":13,"flag":0,"text":"(我出生入死，想尽力把『生辰纲』抢救回来，洗脱污名；怎么可以在这里被一起列为贼党...啊！前面就是何涛的部队...)"},
        {"op":12,"flag":1,"value":54},
        {"op":13,"flag":0,"text":"全军注意，给我把东溪村周围布下天罗地网；连一只苍蝇都不要给我放过！不论男女老幼，都是强盗的同党！如果抵抗的话，格杀勿论！"},
        {"op":12,"flag":1,"value":32},
        {"op":13,"flag":0,"text":"可是...刚才不是有个提辖进去追捕犯人...？"},
        {"op":12,"flag":1,"value":54},
        {"op":13,"flag":0,"text":"罗嗦！你看刚刚那个人哪里像是军官？脸上分明被刺著两行金印，又有那么大一块青色胎记；三分不像人，七分倒像鬼！不知道是哪个大牢逃出来的囚犯，对于这份『生辰纲』想要黑吃黑吧！也不想想自己的长相，还想冒充军官？太自不量力了！"},
        {"op":12,"flag":1,"value":14},
        {"op":14,"flag":1,"value":29},
        {"op":15,"flag":1,"value":25},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":14},
        {"op":18,"flag":1,"value":0},
        {"op":19,"flag":1,"value":51},
        {"op":13,"flag":0,"text":"你给我说清楚，是谁自不量力！"},
        {"op":12,"flag":1,"value":54},
        {"op":13,"flag":0,"text":"杨志？！你怎么在这里？"},
        {"op":12,"flag":1,"value":14},
        {"op":13,"flag":0,"text":"何涛！同是朝廷命官，我好意将二龙山的功劳分给你，一心只想追回『生辰纲』；没想到你居然忘恩负义，想连我一起灭口！"},
        {"op":12,"flag":1,"value":54},
        {"op":13,"flag":0,"text":"哼...我正想去捉你，没想到你居然自己送上门来...左右！快把反贼拿下！"},
        {"op":12,"flag":1,"value":32},
        {"op":13,"flag":0,"text":"是！"},
        {"op":12,"flag":1,"value":16},
        {"op":13,"flag":0,"text":"啊！杨兄弟居然跑到何涛部队前面！太无谋了！"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"text":"杨兄弟有难！我们绕到庄子西南，从那边院门杀进去接应他。%X兄，这段期间你赶快确保一条逃生路线。"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"text":"我知道了。"},
        {"op":12,"flag":1,"value":3},
        {"op":12,"flag":1,"value":13},
        {"op":12,"flag":1,"value":15},
        {"op":12,"flag":1,"value":5},
        {"op":13,"flag":0,"text":"西南这道院门没人把守。我们从这边、晁天王的人从庄前，两头夹击；庄里花木多，正好顺手放火。"},
        {"op":12,"flag":1,"value":0},
        {"op":17,"flag":0,"value":2},
        {"op":12,"flag":1,"value":12},
        {"op":17,"flag":0,"value":2},
        {"op":12,"flag":1,"value":2},
        {"op":13,"flag":0,"text":"贫道也助你们一臂之力吧！贫道『入云龙』公孙胜，略懂一些妖术。"},
        {"op":12,"flag":1,"value":4294967295},
        {"op":20,"flag":1,"text":"\u0001"},
        {"op":21,"flag":1,"text":"m08"},
        {"op":13,"flag":0,"text":"(公孙胜加入了！)"},
        {"op":12,"flag":1,"value":17},
        {"op":13,"flag":0,"text":"我是『赤发鬼』刘唐，以后多多指教。"},
        {"op":12,"flag":1,"value":4294967295},
        {"op":20,"flag":1,"text":"\u0001"},
        {"op":21,"flag":1,"text":"m08"},
        {"op":13,"flag":0,"text":"(刘唐加入了！)"},
        {"op":12,"flag":1,"value":7},
        {"op":13,"flag":0,"text":"『立地太岁』阮小二 。"},
        {"op":12,"flag":1,"value":8},
        {"op":13,"flag":0,"text":"『短命二郎』阮小五。"},
        {"op":12,"flag":1,"value":9},
        {"op":13,"flag":0,"text":"『活阎罗』阮小七 。"},
        {"op":12,"flag":1,"value":7},
        {"op":13,"flag":0,"text":"我们三兄弟是石碣村的渔夫，擅长在水中作战。"},
        {"op":12,"flag":1,"value":4294967295},
        {"op":20,"flag":1,"text":"\u0001"},
        {"op":21,"flag":1,"text":"m08"},
        {"op":13,"flag":0,"text":"(阮氏叁兄弟加入了！)"},
        {"op":12,"flag":1,"value":10},
        {"op":13,"flag":0,"text":"好，诸位随小生从庄前杀过去，和林教头两头夹击！"},
        {"op":12,"flag":1,"value":54},
        {"op":13,"flag":0,"text":"(不好！敌人都是一些出了名的凶神恶煞...)"},
        {"op":12,"flag":1,"value":54},
        {"op":13,"flag":0,"text":"把里面所有人都给我拿下，一个也不要让他跑了！"},
        {"op":12,"flag":1,"value":32},
        {"op":13,"flag":0,"text":"是！"},
        {"op":12,"flag":1,"value":54},
        {"op":13,"flag":1,"text":"我先到门外等你们的好消息...对了！先把那个杨志给我抓住，若有抵抗格杀勿论！"},
