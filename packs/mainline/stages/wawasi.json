    ],
    [
     "appear",
     "w2"
    ],
    [
     "appear",
     "w3"
    ],
    [
     "narrate",
     "崔道成提着朴刀，引着几个强人从殿后杀出来！"
    ],
    [
     "say",
     "cui",
     "小的们，都出来！莫教这秃驴走了！"
    ],
    [
     "say",
     "luzhishen",
     "吃饱了正好！生铁佛，洒家等你多时了！"
    ]
