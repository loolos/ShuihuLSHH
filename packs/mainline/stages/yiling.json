        [
          "narrate",
          "那母大虫到洞口，先把尾去窝里一剪，便把后半截身躯坐将入去。"
        ],
        [
          "say",
          "likui",
          "正是你这业畜吃了我娘！"
        ],
        [
          "flag",
          "tigress"
        ]
