        ],
        [
          "setAi",
          "b2",
          0
        ],
        [
          "setAi",
          "b3",
          0
        ],
        [
          "setAi",
          "b4",
          0
        ],
        [
          "setAi",
          "b5",
          0
        ],
        [
          "setAi",
