  "blocks": [
    {
      "trigger": {"kind":"turn","turn":0},
      "cond": {"type":0,"arg":0},
      "head": [1,102,1,0,0,0,38,2,0],
      "ops": [
        {"op":12,"flag":1,"value":37},
        {"op":13,"flag":0,"id":1,"text":"林教头，太尉在门内等你，请进。"},
        {"op":12,"flag":1,"value":11},
        {"op":14,"flag":1,"value":10},
        {"op":15,"flag":1,"value":9},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":56},
        {"op":13,"flag":0,"id":2,"text":"来者何人？！竟敢擅闯白虎节堂！"},
        {"op":12,"flag":1,"value":36},
        {"op":18,"flag":1,"value":0},
        {"op":19,"flag":1,"value":32},
        {"op":13,"flag":0,"id":3,"text":"威～武～"},
        {"op":12,"flag":1,"value":56},
        {"op":13,"flag":0,"id":4,"text":"王潮、马瀚，给我把这名刺客捉起来！"},
        {"op":12,"flag":1,"value":1002},
        {"op":14,"flag":1,"value":10},
        {"op":15,"flag":1,"value":10},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":1004},
        {"op":14,"flag":1,"value":10},
        {"op":15,"flag":1,"value":8},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"id":5,"text":"太尉！这是误会！是我林冲啊！"},
        {"op":12,"flag":1,"value":56},
        {"op":13,"flag":0,"id":6,"text":"哦，的确是林冲...你身为朝廷命官，更应该知道白虎节堂是什么去处..."},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"id":7,"text":"(不好！白虎节堂是商议军事机密的地方，如果没有许可是不能随便擅闯的...)"},
        {"op":12,"flag":1,"value":56},
        {"op":13,"flag":0,"id":8,"text":"林冲！你无本人呼唤，居然敢擅闯白虎节堂！你可知法律吗？！你是想要行刺本官，还是想偷窃国家机密？！"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"id":9,"text":"太尉！明明是你叫人送信，打算设酒席排解纠纷才叫我来的啊！"},
        {"op":12,"flag":1,"value":56},
        {"op":13,"flag":0,"id":10,"text":"哼！别以为你在干什么我不知道！想必你是想对本官不利！否则你为何与弃职逃官的王进相互勾结？！王进写给你的信我都已经看过了！"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"id":11,"text":"(啊！那封信怎么会在他手上！)"},
        {"op":12,"flag":1,"value":56},
        {"op":13,"flag":0,"id":12,"text":"王进那厮仗着老子的势，看不起本官；甚至装病不屑见本官！再者弃职逃官躲到延安府，最后竟然勾结我管辖军官打算行刺我！你这个吃里扒外的家伙！我不打死你也要把你刺配边疆！"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"id":13,"text":"冤枉啊！太尉，我从来没有想要行刺你啊！"},
        {"op":12,"flag":1,"value":56},
        {"op":13,"flag":0,"id":14,"text":"还敢狡辩？！除了物证以外，我连人证都有了！"},
        {"op":12,"flag":1,"value":57},
        {"op":14,"flag":1,"value":7},
        {"op":15,"flag":1,"value":10},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":57},
        {"op":13,"flag":0,"id":15,"text":"嘿嘿嘿...这封信千真万确是从你身上掉下来的，林教头..."},
        {"op":12,"flag":1,"value":56},
        {"op":13,"flag":0,"id":16,"text":"林冲！现在人证、物证皆齐全，你还有什么话要讲！"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"id":17,"text":"哈哈哈...原来是这样子啊！太尉为子报仇，太感人了！太感人了！"},
        {"op":12,"flag":1,"value":57},
        {"op":13,"flag":0,"id":18,"text":"林冲！你犯下这种叛逆之罪，还不快点伏首认罪？！"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"id":19,"text":"我已经知道剧本是怎么写的...剧本最后不是我死在大牢，就是在押解途中被人害死吧...很可惜，我不会照着你们的剧本演！"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"id":20,"text":"高俅！我会用这个拳头打断你那高傲的鼻子！"},
        {"op":12,"flag":1,"value":0},
        {"op":18,"flag":1,"value":0},
        {"op":19,"flag":1,"value":33},
        {"op":13,"flag":0,"id":21,"text":"『%M』%N在此！林教头，我们来救你啦！"},
        {"op":12,"flag":1,"value":0},
        {"op":14,"flag":1,"value":10},
        {"op":15,"flag":1,"value":9},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"id":22,"text":"『九纹龙』史进在此！不怕死的就过来吧！"},
        {"op":12,"flag":1,"value":3},
        {"op":14,"flag":1,"value":10},
        {"op":15,"flag":1,"value":9},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":16},
        {"op":13,"flag":0,"id":23,"text":"俺就是『花和尚』鲁智深！让你们尝尝俺拳头的厉害！"},
        {"op":12,"flag":1,"value":16},
        {"op":14,"flag":1,"value":10},
        {"op":15,"flag":1,"value":9},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":5},
        {"op":13,"flag":0,"id":24,"text":"『神机军师』朱武！"},
        {"op":12,"flag":1,"value":5},
        {"op":14,"flag":1,"value":10},
        {"op":15,"flag":1,"value":9},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":13},
        {"op":13,"flag":0,"id":25,"text":"『跳涧虎』陈达！"},
        {"op":12,"flag":1,"value":13},
        {"op":14,"flag":1,"value":10},
        {"op":15,"flag":1,"value":9},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":15},
        {"op":13,"flag":0,"id":26,"text":"『锦花蛇』杨春！"},
        {"op":12,"flag":1,"value":15},
        {"op":14,"flag":1,"value":10},
        {"op":15,"flag":1,"value":9},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":5},
        {"op":13,"flag":0,"id":27,"text":"少华山三头目来当你们的对手！"},
        {"op":12,"flag":1,"value":56},
        {"op":13,"flag":0,"id":28,"text":"反了！反了！强盗居然打进太尉府中！每个反贼都不要给我放走！对了，林教头，只要捉住这些强盗，你的罪就一笔勾销！"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"id":29,"text":"哼...八十万禁军教头林冲在刚才已经死了...这些是我的同伴，我是『豹子头』林冲！"},
        {"op":29,"flag":null,"id":30,"text":"『豹子头』林冲，从此踏上漫漫的不归路。"}
      ]
    }
  ]
}
