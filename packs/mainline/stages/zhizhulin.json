      "name": "强人头目",
      "hidden": true
    }
  ],
  "script": [
    {
      "on": "start",
      "do": [
        ["bind", "linchong"],
        ["narrate", "林冲获罪刺配沧州，董超、薛霸押着他行至野猪林，借口歇息，将他绑在树旁。", "#1"],
        ["say", "dongchao", "林冲，到了这无人处，也该了结你的性命了！", "#2"],
        ["say", "linchong", "董超、薛霸！你们受高俅指使，竟敢在押解途中害我！", "#3"],
        ["say", "xueba", "少说废话！今日便叫你死在这野猪林中！", "#4"],
        ["narrate", "眼见二人举起棍棒，林中忽然传来一声断喝！", "#5"],
        ["appear", "hero"],
        ["appear", "luzhishen"],
        ["say", "hero", "住手！有我在，休想伤林教头分毫！", "#6"],
        ["say", "luzhishen", "洒家早料到这两个公人没安好心！林教头，洒家来救你！", "#7"],
        ["cleanse", "linchong"],
        ["say", "linchong", "鲁大哥！多谢救命之恩！", "#8"],
        ["say", "luzhishen", "先打发了这两个狗官，咱们再说话！", "#9"],
        ["objective", "限制回合数 --- 18", "#10"],
        ["objective", "胜利条件   --- 打退董超、薛霸及林中强人和头目", "#11"],
        ["objective", "失败条件一 --- 主角死亡", "#12"],
        ["objective", "失败条件二 --- 林冲死亡", "#13"],
        ["objective", "失败条件三 --- 鲁智深死亡", "#14"],
        ["turnLimit", 18]
      ]
    },
    {
      "on": "enemiesDefeated",
      "do": [
        ["appear", "bandit1"],
        ["appear", "bandit2"],
        ["appear", "bandit3"],
        ["appear", "bandit4"],
        ["narrate", "喊杀声四起，野猪林中又窜出数名强人！", "#15"]
      ]
    },
    {
      "on": "enemiesDefeated",
      "do": [
        ["appear", "bandit-chief"],
        ["narrate", "强人四散逃走，林中头目闻声赶来，拦住众人的去路。", "#16"],
        ["say", "bandit-chief", "打了我的弟兄，还想从野猪林安然走出去？", "#17"]
      ]
    },
    {
      "on": "enemiesDefeated",
      "do": [
        ["narrate", "董超、薛霸伏法，林中强人也被打退。众人不敢久留，继续暗中护送林冲前往沧州。", "#18"],
        ["victory", "野猪林救下林冲！", "#19"]
      ]
    },
    {
      "on": {
        "dead": "hero"
      },
      "do": [
        ["defeat", "主角倒在野猪林中，林冲与鲁智深被强人围住，终究未能脱身……", "#20"]
      ]
    },
    {
      "on": {
        "dead": "linchong"
      },
      "do": [
        ["defeat", "林冲死于押解途中，鲁智深与主角悲愤难当，却被官差和强人团团围住……", "#21"]
      ]
    },
    {
      "on": {
        "dead": "luzhishen"
      },
      "do": [
        ["defeat", "鲁智深倒在野猪林中，林冲与主角再难抵挡官差和强人……", "#22"]
      ]
    }
  ]
}
