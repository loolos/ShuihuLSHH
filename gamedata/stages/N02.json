    {
      "trigger": {"kind":"turn","turn":8},
      "cond": {"type":0,"arg":8},
      "head": [1,26,3,1,1,1,23,2,0],
      "ops": [
        {"op":12,"flag":1,"value":59},
        {"op":13,"flag":0,"id":19,"text":"哼！没想到史进那么顽强，喽罗！你领几个人回少华山禀报大头目，把所有人都给俺带过来！"},
        {"op":12,"flag":1,"value":44},
        {"op":13,"flag":1,"id":20,"text":"是！"},
        {"op":17,"flag":0,"value":2},
        {"op":12,"flag":1,"value":45},
        {"op":13,"flag":1,"id":21,"text":"是！"},
        {"op":17,"flag":0,"value":2},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"id":22,"text":"糟了！不能让那几个人逃走！"},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"id":23,"text":"咦？！"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"id":24,"text":"若让少华山众匪倾巢而出的话，就麻烦了！"},
        {"op":12,"flag":1,"value":1},
        {"op":13,"flag":0,"id":25,"text":"这该如何是好？"},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"id":26,"text":"庄后有条通往少华山必经之地的捷径，我派几名家丁前去拦截！"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"id":27,"text":"唔...我看还是慎重一些的好，不如就请王兄领几名庄客前往吧！"},
        {"op":12,"flag":1,"value":1},
        {"op":13,"flag":0,"id":28,"text":"交给我好了。"},
        {"op":12,"flag":1,"value":4294967295},
        {"op":13,"flag":0,"id":29,"text":"王进退场了！"},
