      "head": [1,64,1,0,0,0,68,2,0],
      "ops": [
        {"op":12,"flag":1,"value":1},
        {"op":14,"flag":1,"value":6},
        {"op":15,"flag":1,"value":6},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":18},
        {"op":14,"flag":1,"value":6},
        {"op":15,"flag":1,"value":5},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":0},
        {"op":18,"flag":1,"value":1},
        {"op":19,"flag":1,"value":9},
        {"op":13,"flag":0,"text":"你究竟是何人？为何不明就理乱打一通？！"},
        {"op":12,"flag":1,"value":3},
        {"op":14,"flag":1,"value":7},
        {"op":15,"flag":1,"value":8},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"text":"这位师父！我是史家村史进，请收我为徒弟！"},
        {"op":12,"flag":1,"value":24},
        {"op":14,"flag":1,"value":7},
        {"op":15,"flag":1,"value":10},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":24},
        {"op":13,"flag":0,"text":"进儿！不得无礼！"},
        {"op":12,"flag":1,"value":24},
        {"op":13,"flag":0,"text":"吾乃史家村主人史太公。敢问壮士为何来到敝村？"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"text":"我名叫%N。同伴有伤，希望太公能让我们借宿一夜。"},
        {"op":12,"flag":1,"value":24},
        {"op":13,"flag":0,"text":"呵呵...不要说是一夜，住上一年半载也没有问题！但是我有一个条件。当你住在这儿，希望有空闲的时间就稍微调教一下小儿。"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"text":"这位...是令公子？刚才出手太重，还请恕罪。"},
        {"op":12,"flag":1,"value":24},
        {"op":13,"flag":0,"text":"哪里的话。小儿不懂事，学了些花拳绣腿就想试试自己的功夫；他时常见到过往客人就上前挑战，就算是断手断脚，也是他自作自受。"},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"text":"在下学艺不精，愿师父收留！"},
        {"op":12,"flag":1,"value":24},
        {"op":13,"flag":0,"text":"老汉世居此华阴县界，前面就是少华山，有山贼出没；此村便叫史家村，村中三四百家都姓史。小儿从小只爱使棒弄枪，老汉只有随他的性子，不知道请了多少师父教他；同时又请了名匠替他刺了这身刺青，全身上下共有九条龙。远近居民都叫他『九纹龙史进』。壮士居然有缘至此，何不传他真材实学，以了老汉之心愿？"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"text":"嗯...但是我只会拳脚功夫，更何况也没有教人的经验...."},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"text":"这位王教头原本是八十万禁军教头，皇帝身边的禁卫军都是他调教出来的，功力不会在我之下；加上他十八般武艺样样精通，令郎交给他指导必定功力大进。"},
        {"op":12,"flag":1,"value":1},
        {"op":13,"flag":0,"text":"什么！我..."},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"text":"(这不是很好吗？你们可以在这里休养数天，代价也不过是教导史进功夫；不会是刚被追杀几天，怎么教学生都忘记了吧？)"},
        {"op":12,"flag":1,"value":1},
        {"op":13,"flag":0,"text":"(别...别开玩笑！教了二十年的职业怎么会忘记！)"},
        {"op":12,"flag":1,"value":24},
        {"op":13,"flag":0,"text":"那么就太好了！进儿，快来拜师父！"},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"text":"可是，我只服那位大哥的功夫...."},
        {"op":12,"flag":1,"value":1,"quiet":true},
        {"op":13,"flag":1,"text":"这棒也使得好了，只是有破绽，赢不得真好汉。"},
        {"op":12,"flag":1,"value":3,"quiet":true},
        {"op":13,"flag":1,"text":"俺经了七八个有名的师父，我不信倒不如你！你敢和我扠一扠么？"},
        {"op":12,"flag":1,"value":4294967295,"quiet":true},
        {"op":13,"flag":1,"text":"王进将棒一掣，却望史进怀里直搠将来，只一缴，史进的棒丢在一边，扑地望后倒了。"},
        {"op":12,"flag":1,"value":3,"quiet":true},
        {"op":13,"flag":1,"text":"……我枉自经了许多师父，原来不值半分！师父在上，受徒弟一拜！"},
        {"op":12,"flag":1,"value":24},
        {"op":13,"flag":0,"text":"对了，%X兄，是否能看在老汉的薄面上跟小儿结为义兄弟？"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"text":"啊...好啊。"},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"text":"大哥在上，受小弟一拜！"},
        {"op":12,"flag":1,"value":4294967295},
        {"op":20,"flag":1,"text":"\u0001"},
        {"op":21,"flag":1,"text":"m08"},
        {"op":13,"flag":0,"text":"(史进加入了！)"},
        {"op":12,"flag":1,"value":24},
        {"op":13,"flag":0,"text":"呵呵...今天真是双喜临门！小儿一日中就拜了师父与义兄！%X兄如果没什么紧急事，就暂时住在敝村吧。来人啊！准备宴席，替两位贵客接风！"},
        {"op":12,"flag":1,"value":4294967295,"quiet":true},
        {"op":13,"flag":1,"text":"自此王进每日点拨史进：矛、锤、弓、弩、铳，鞭、简、剑、链、挝，斧、钺并戈、戟，牌、棒与枪、杈——十八般武艺，从头指教。"},
        {"op":12,"flag":1,"value":24,"quiet":true},
        {"op":29,"flag":null,"text":"主角收服史进，并与史进结为兄弟；史进拜王进为师，一行人遂暂住史家庄。"}
      ]
    }
  ]
}
