      "ops": [
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"id":1,"text":"董超、薛霸和那伙强人已被打退。林教头无恙，众人仍暗中护送他去沧州。"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"id":2,"text":"嘘！前面有人影！"},
        {"op":12,"flag":1,"value":64},
        {"op":14,"flag":1,"value":25},
        {"op":15,"flag":1,"value":41},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":64},
        {"op":13,"flag":0,"id":3,"text":"林教头请留步！"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"id":4,"text":"你不是陆虞候吗？怎么会在这里？"},
        {"op":12,"flag":1,"value":64},
        {"op":13,"flag":0,"id":5,"text":"林教头受的委屈，已经传遍整个东京，连皇帝都惊动了！现在高俅已经被解除官职，正等待林教头回去跟高俅对质呢！我是特地来通知林教头回去，以免林教头遇上了什么意外。"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"id":6,"text":"啊...是这样子啊！太好了..."},
        {"op":12,"flag":1,"value":64},
        {"op":13,"flag":0,"id":7,"text":"此去野猪林山贼众多，要是林教头出了什么意外，在下可无法跟上司交代...林冲，回东京吧！"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"id":8,"text":"嗯...太好了..."},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"id":9,"text":"等一下。林冲，你相信他的话？"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"id":10,"text":"陆谦是我多年的好友，岂有欺骗我的道理？"},
        {"op":12,"flag":1,"value":64},
        {"op":13,"flag":0,"id":11,"text":"你又是什么东西！林冲好不容易有辩解自己罪名的机会，你要他放弃这个机会，一辈子当个不忠不孝之人！"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"id":12,"text":"哼哼...话倒是说得满漂亮的；但是，那些树林中的杀气是什么？！"},
        {"op":12,"flag":1,"value":64},
        {"op":18,"flag":1,"value":0},
        {"op":19,"flag":1,"value":36},
        {"op":13,"flag":0,"id":13,"text":"哼...被发现了,出来吧！"},
        {"op":12,"flag":1,"value":1001},
        {"op":12,"flag":1,"value":1002},
        {"op":12,"flag":1,"value":1003},
        {"op":12,"flag":1,"value":1004},
        {"op":12,"flag":1,"value":1005},
        {"op":12,"flag":1,"value":1006},
        {"op":12,"flag":1,"value":1007},
