        [
          "narrate",
          "朱贵取出一张鹊画弓，搭上一枝响箭，望着对港芦苇丛中射去。响箭到处，芦苇丛里早摇出一只快船来。"
        ],
        [
          "appear",
          "zhangheng"
        ],
        [
          "appear",
          "lvfang"
        ],
        [
          "say",
          "zhangheng",
          "朱贵兄弟放箭，必有紧事！船火儿张横在此！"
        ],
        [
          "say",
          "lvfang",
          "小温侯吕方也来了！哪个鸟官军敢来撩拨？"
        ],
        [
          "say",
          "zhugui",
          "来得好！后面还有船么？"
        ],
        [
          "say",
          "zhangheng",
          "俺兄弟张顺载着郭盛随后便到！"
        ],
        [
          "narrate",
          "缉捕使臣见水里有船来，知道走漏了，亲自领着马军杀进来！"
        ],
        [
