        {"op":12,"flag":1,"value":4294967295,"quiet":true},
        {"op":13,"flag":1,"text":"六月初四，杨志押送十一担生辰纲行至黄泥冈。山路险僻，他改趁早凉为日中赶路，又一路催打，军汉、虞候早已怨声满腹。"},
        {"op":12,"flag":1,"value":14},
        {"op":13,"flag":0,"text":"快走！赶过前面冈子去，却再理会。"},
        {"op":12,"flag":1,"value":1002},
        {"op":13,"flag":0,"text":"这般火似热的天气，又挑着重担！不拣早凉行，动不动藤条打来，都是一般父母皮肉，我们直恁地苦！"},
        {"op":12,"flag":1,"value":1003},
        {"op":13,"flag":0,"text":"趁早不走，日里热时走不得，却又打我们！"},
        {"op":12,"flag":1,"value":14,"quiet":true},
        {"op":13,"flag":1,"text":"前日行的须是好地面，如今正是尴尬去处。若不日里赶过去，谁敢五更半夜走！"},
        {"op":12,"flag":1,"value":1002},
        {"op":13,"flag":0,"text":"我们挑着百十斤担子，须不比他空手走的。前面有松阴，便歇一歇罢！"},
        {"op":12,"flag":1,"value":1002},
        {"op":13,"flag":0,"text":"你便剁做我七八段，其实去不得了！"},
        {"op":12,"flag":1,"value":1004},
        {"op":13,"flag":0,"text":"权且歇一歇，略过日中再行罢。"},
        {"op":12,"flag":1,"value":14},
        {"op":13,"flag":0,"text":"这里正是强人出没的去处，地名叫做黄泥冈！白日里兀自出来劫人，谁敢在这里停脚！"},
        {"op":12,"flag":1,"value":1002},
        {"op":13,"flag":0,"text":"你端的不把人当人！便是留守相公自来监押时，也容我们说一句！"},
        {"op":12,"flag":1,"value":1005},
        {"op":13,"flag":0,"text":"我见你说好几遍了，只管把这话来惊吓人。"},
        {"op":12,"flag":1,"value":1006,"quiet":true},
        {"op":13,"flag":1,"text":"杨提辖且住！我在太师府里做奶公时，门下官军都向我喏喏连声。量你是个遭死的军人，相公抬举你做个提辖，便只顾逞能，把他们打，是何看待！"},
        {"op":12,"flag":1,"value":14,"quiet":true},
        {"op":13,"flag":1,"text":"都管，你须是城市里人，生长在相府里，那里知道途路上千难万难。"},
        {"op":12,"flag":1,"value":1006,"quiet":true},
        {"op":13,"flag":1,"text":"四川、两广也曾去来，不曾见你这般卖弄。"},
        {"op":12,"flag":1,"value":14,"quiet":true},
        {"op":13,"flag":1,"text":"如今须不比太平时节。"},
        {"op":12,"flag":1,"value":1006,"quiet":true},
        {"op":13,"flag":1,"text":"今日天下怎地不太平？"},
        {"op":12,"flag":1,"value":14},
        {"op":13,"flag":0,"text":"（只得忍气）且住！对面松林里有人窥望，俺去看个明白！"},
        {"op":12,"flag":1,"value":58},
        {"op":14,"flag":1,"value":8},
        {"op":15,"flag":1,"value":11},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":53},
        {"op":14,"flag":1,"value":10},
        {"op":15,"flag":1,"value":11},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":61},
        {"op":14,"flag":1,"value":12},
        {"op":15,"flag":1,"value":11},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":50},
        {"op":14,"flag":1,"value":10},
        {"op":15,"flag":1,"value":13},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":51},
        {"op":14,"flag":1,"value":9},
        {"op":15,"flag":1,"value":12},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":52},
        {"op":14,"flag":1,"value":11},
        {"op":15,"flag":1,"value":12},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":61},
        {"op":18,"flag":1,"value":1},
        {"op":19,"flag":1,"value":41},
        {"op":13,"flag":0,"text":"什么人？莫不是劫客的强人？"},
        {"op":12,"flag":1,"value":14},
        {"op":13,"flag":0,"text":"你们是什么人？"},
        {"op":12,"flag":1,"value":61},
        {"op":13,"flag":0,"text":"你们才是什么人？"},
        {"op":12,"flag":1,"value":14},
        {"op":13,"flag":0,"text":"你等莫不是歹人？"},
        {"op":12,"flag":1,"value":61},
        {"op":13,"flag":0,"text":"我等弟兄七人，是濠州人，贩枣子上东京去。当不过热，权在这林子里歇一歇，待晚凉了行。"},
        {"op":12,"flag":1,"value":14},
        {"op":13,"flag":0,"text":"原来如此，也是一般的客人。却才见你们窥望，惟恐是歹人，因此赶来看一看。"},
        {"op":12,"flag":1,"value":61},
        {"op":13,"flag":0,"text":"客官请几个枣子了去。咦，那边又有人上冈了！"},
        {"op":12,"flag":1,"value":4294967295,"quiet":true},
        {"op":13,"flag":1,"text":"远远地一个汉子，挑着一副担桶，唱上冈子来。"},
        {"op":12,"flag":1,"value":47,"quiet":true},
        {"op":13,"flag":1,"text":"赤日炎炎似火烧，野田禾稻半枯焦。农夫心内如汤煮，公子王孙把扇摇。"},
        {"op":12,"flag":1,"value":47},
        {"op":14,"flag":1,"value":6},
        {"op":15,"flag":1,"value":9},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":47},
        {"op":13,"flag":0,"text":"客官们买桶白酒吧！"},
        {"op":12,"flag":1,"value":1002},
        {"op":13,"flag":0,"text":"多少钱一桶？"},
        {"op":12,"flag":1,"value":47},
        {"op":13,"flag":0,"text":"五贯钱。"},
        {"op":12,"flag":1,"value":1002},
        {"op":13,"flag":0,"text":"我们又热又渴，何不凑钱买些吃，也解暑气？"},
        {"op":12,"flag":1,"value":14},
        {"op":13,"flag":0,"text":"你们不得洒家言语，胡乱便要买酒吃！多少好汉，被蒙汗药麻翻了！"},
        {"op":12,"flag":1,"value":47},
        {"op":13,"flag":0,"text":"早是我不卖与你吃，却说出这般没气力的话来！"},
        {"op":12,"flag":1,"value":61},
        {"op":13,"flag":0,"text":"既是他们疑心，且卖一桶与我们吃。"},
        {"op":12,"flag":1,"value":47},
        {"op":13,"flag":0,"text":"五贯钱一桶。"},
        {"op":12,"flag":1,"value":61},
        {"op":14,"flag":1,"value":6},
        {"op":15,"flag":1,"value":10},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":61},
        {"op":13,"flag":0,"text":"五贯便依你五贯，只饶我们一瓢吃。"},
        {"op":12,"flag":1,"value":47},
        {"op":13,"flag":0,"text":"饶不得，做定的价钱！"},
        {"op":12,"flag":1,"value":61},
        {"op":14,"flag":1,"value":9},
        {"op":15,"flag":1,"value":10},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":50},
        {"op":14,"flag":1,"value":10},
        {"op":15,"flag":1,"value":12},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":4294967295,"quiet":true},
        {"op":13,"flag":1,"text":"贩枣客先吃尽一桶，又讨饶酒。一个偷舀半瓢，挑酒汉子追去；另一个也来舀酒，被劈手夺瓢，倾回桶里。众军汉都在旁看着。"},
        {"op":12,"flag":1,"value":50},
        {"op":13,"flag":0,"text":"嗯...好酒..."},
        {"op":12,"flag":1,"value":14},
        {"op":13,"flag":0,"text":"（这伙客人买了一桶吃了，另一桶也当面吃了半瓢，想是好的……）"},
        {"op":12,"flag":1,"value":1006,"quiet":true},
        {"op":13,"flag":1,"text":"那贩枣子客人已买了一桶酒吃，胡乱教他们买了避暑气。冈子上端的没处讨水吃。"},
        {"op":12,"flag":1,"value":14,"quiet":true},
        {"op":13,"flag":1,"text":"既然老都管说了，教这厮们买吃了便起身。"},
        {"op":12,"flag":1,"value":1002},
        {"op":14,"flag":1,"value":7},
        {"op":15,"flag":1,"value":9},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":1002},
        {"op":13,"flag":0,"text":"大哥，另外一桶也卖与我们，润一润喉罢！"},
        {"op":12,"flag":1,"value":47},
        {"op":13,"flag":0,"text":"不卖不卖！我酒里面有蒙汗药！"},
        {"op":12,"flag":1,"value":14},
        {"op":13,"flag":0,"text":"（打了他们半日，也只得容他们买碗吃了便走。）"},
        {"op":12,"flag":1,"value":1002},
        {"op":13,"flag":0,"text":"大哥，方才言语冲撞，休与我们计较！这是五贯足钱，烦借客人的椰瓢一用。"},
        {"op":12,"flag":1,"value":1002},
        {"op":14,"flag":1,"value":7},
        {"op":15,"flag":1,"value":6},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":1003},
        {"op":14,"flag":1,"value":7},
        {"op":15,"flag":1,"value":5},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":1004},
        {"op":14,"flag":1,"value":6},
        {"op":15,"flag":1,"value":6},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":1005},
        {"op":14,"flag":1,"value":6},
        {"op":15,"flag":1,"value":5},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":4294967295},
        {"op":13,"flag":0,"text":"贩枣客劝转卖酒汉子，众人付钱借瓢。谢都管先吃，两个虞候、众军汉接连饮酒。杨志见众人无事，终究热渴难熬。"},
        {"op":12,"flag":1,"value":1003},
        {"op":14,"flag":1,"value":7},
        {"op":15,"flag":1,"value":8},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":1003},
        {"op":13,"flag":0,"text":"老都管和两位虞候都吃了，提辖也吃半瓢润润喉罢。"},
        {"op":12,"flag":1,"value":14},
        {"op":13,"flag":0,"text":"（只吃半瓢，便叫他们起身。）"},
        {"op":12,"flag":1,"value":53},
        {"op":13,"flag":0,"text":"倒也！倒也！"},
        {"op":12,"flag":1,"value":1002},
        {"op":13,"flag":0,"text":"唉呀...头...好昏..."},
        {"op":12,"flag":1,"value":14,"quiet":true},
        {"op":13,"flag":1,"text":"不好！这酒里有蒙汗药……"},
        {"op":12,"flag":1,"value":4294967295,"quiet":true},
        {"op":13,"flag":1,"text":"话未说完，杨志也眼前一黑，昏倒在地。军汉、虞候与老都管早已倒了一地。"},
        {"op":12,"flag":1,"value":58},
        {"op":13,"flag":0,"text":"快把金珠装上车，咱们下冈去！"},
        {"op":12,"flag":1,"value":4294967295,"quiet":true},
        {"op":13,"flag":1,"text":"晁盖等人将十一担生辰纲装上车，推车下冈。"},
        {"op":12,"flag":1,"value":14},
        {"op":29,"flag":null,"text":"黄泥冈，生辰纲被劫。"}
      ]
    }
  ],
  "names": {"1":"军汉","2":"军汉","3":"虞候","4":"虞候","5":"谢都管"}
}
