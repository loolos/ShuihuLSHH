  "blocks": [
    {
      "trigger": {"kind":"turn","turn":0},
      "cond": {"type":0,"arg":0},
      "head": [1,64,1,0,0,0,40,2,0],
      "ops": [
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"text":"你这个死贼寇！今日落到我的手中，还有什么话可说？！"},
        {"op":12,"flag":1,"value":13},
        {"op":13,"flag":0,"text":"要杀就杀吧！反正二十年后又是一条好汉！"},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"text":"死到临头还嘴硬！"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"text":"贤弟不要生气。你现在杀了这个强盗，只不过是弄脏了史家的地板；倒不如送去官府还可领赏..."},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"text":"哼！就暂且把你的头寄放在你的脖子上！等到我把其他两人一齐捉住，再一同送上官府！"},
        {"op":12,"flag":1,"value":49},
        {"op":14,"flag":1,"value":10},
        {"op":15,"flag":1,"value":11},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":49},
        {"op":13,"flag":0,"text":"大郎，少华山头领朱武、杨春求见。"},
        {"op":12,"flag":1,"value":3},
        {"op":18,"flag":1,"value":0},
        {"op":19,"flag":1,"value":13},
        {"op":13,"flag":0,"text":"什么？他们自己送上门了？"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"text":"...见见也无妨，带他们进来。"},
        {"op":12,"flag":1,"value":5},
        {"op":14,"flag":1,"value":11},
        {"op":15,"flag":1,"value":9},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":15},
        {"op":14,"flag":1,"value":11},
        {"op":15,"flag":1,"value":10},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":5},
        {"op":13,"flag":0,"text":"吾弟冒犯虎威，今日特地来负荆请罪。吾等恶贯满盈，不求史公恕罪，只求一同将我等送至官府！"},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"text":"什么...？！"},
        {"op":12,"flag":1,"value":15},
        {"op":13,"flag":0,"text":"我虽然是粗鲁人，但是也还知道什么叫做义气。当初与哥哥两人因官司缠身，不得已上山落草。当初发誓『不求同日生，但愿同日死』；虽然比不上刘关张的英雄，但是也不能放着哥哥不管独自偷生啊！"},
        {"op":12,"flag":1,"value":5},
        {"op":13,"flag":0,"text":"今日小弟陈达不听规劝，竟敢太岁头上动土；反被英雄擒住。某不才，无力救出手足兄弟，岂有面目见江东父老？今日特来求死，希望英雄将我等三人一同解送官府领赏，以应同生共死之誓。我等能死于英雄手中，并无怨言！"},
        {"op":12,"flag":1,"value":13},
        {"op":13,"flag":0,"text":"大哥...."},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"text":"(多讲义气的好汉啊！我要是把他们送到官府领赏，岂不叫天下英雄笑话？)"},
        {"op":12,"flag":1,"value":49},
        {"op":13,"flag":0,"text":"大郎，原本只能赚一千贯，现在另外两千贯也自己送上门来啦！小人马上拿绳索把这两个土匪捉起来！"},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"text":"李吉，退下！"},
        {"op":12,"flag":1,"value":49},
        {"op":13,"flag":0,"text":"可是...."},
        {"op":12,"flag":1,"value":3},
        {"op":14,"flag":1,"value":9},
        {"op":15,"flag":1,"value":10},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":5},
        {"op":13,"flag":0,"text":"史公，这是干什么？"},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"text":"你们如此义气深重，我如果把你们送了官府，那就不是好汉。我把陈达还给你们，如何？"},
        {"op":12,"flag":1,"value":5},
        {"op":13,"flag":0,"text":"只怕连累史公吃上官司；还是把我们送官府比较妥当。"},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"text":"不用多说。我摆一桌宴席招待好汉，你们愿意赏光吗？"},
        {"op":12,"flag":1,"value":15},
        {"op":13,"flag":0,"text":"死都不怕了，难道还怕喝酒吗？哈哈哈...."},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"text":"哈哈哈...."},
        {"op":29,"flag":null,"text":"英雄惜英雄，史进放了陈达，并与三人结交。"}
      ]
    }
  ]
}
