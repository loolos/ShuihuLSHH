  "script": [
    {
      "on": "start",
      "do": [
        [
          "portrait",
          "wusong",
          "faces/wusong-xingzhe.png"
        ],
        [
          "title",
          "清风山下 · 青州大路"
        ],
        [
          "narrate",
          "黄信、刘高押着两辆囚车，离了清风寨，行不过三四十里，前面望见一座大林子。"
        ],
        [
          "narrate",
          "只听得山坡上锣声响处，一伙喽啰抢将出来，拦住去路。"
        ],
        [
          "focus",
          "yanshun"
        ],
        [
          "say",
          "yanshun",
          "来往的到此当住脚！留下三千两买路黄金，任从过去。"
        ],
        [
          "focus",
          "huangxin"
        ],
        [
          "say",
          "huangxin",
          "你那厮们不得无礼，镇三山在此！"
        ],
        [
          "focus",
          "wangying"
        ],
        [
          "say",
          "wangying",
          "你便是镇万山，也要三千两买路黄金！"
        ],
        [
          "say",
          "likui",
          "少废话！把公明哥哥放下来，饶你们鸟命！"
        ],
        [
          "say",
          "hero",
          "囚车里是宋江哥哥和花荣兄弟，杀过去！"
        ],
        [
          "objective",
          "胜利：打倒黄信、刘高和全部官军（第 5 回合青州还有接应人马）\n失败：武龙或花荣倒下；超过 25 回合"
        ],
        [
          "turnLimit",
          25
        ]
      ]
    },
    {
      "on": {
        "turn": 2
      },
      "do": [
        [
          "narrate",
          "囚车里的花荣见了，把囚车掀开，便跳出来，将这缚索都挣断了，就军汉手里夺过一张弓、一壶箭。"
        ],
        [
          "appear",
          "huarong"
        ],
        [
          "buff",
          "huarong",
          "defense",
          {
            "pct": 100,
            "turns": 2
          }
        ],
        [
          "say",
          "huarong",
          "黄信！你那掷盏的手段，今番须还你！"
        ]
      ]
    },
    {
      "on": {
        "turn": 3
      },
      "do": [
        [
          "narrate",
          "西边大路上尘头起处，三筹好汉杀将过来——却是二龙山的武行者、花和尚鲁智深、青面兽杨志，得了武龙的书，连夜赶来！"
        ],
        [
          "appear",
          "wusong"
        ],
        [
          "appear",
          "luzhishen"
        ],
        [
          "appear",
          "yangzhi"
        ],
        [
          "say",
          "luzhishen",
          "洒家来也！哪个撮鸟敢押宋三郎？"
        ],
        [
          "say",
          "wusong",
          "哥哥！兄弟来了！"
        ],
        [
          "say",
          "yangzhi",
          "官军休走，杨志在此！"
        ]
      ]
    },
    {
      "on": {
        "turn": 5
      },
      "do": [
        [
          "narrate",
          "青州方向又来了一彪官军——是黄信先差人去调的接应人马！"
        ],
        [
          "appear",
          "wave-1"
        ],
        [
          "appear",
          "wave-2"
        ],
        [
          "appear",
          "wave-3"
        ],
        [
          "appear",
          "wave-4"
        ],
        [
          "appear",
          "wave-5"
        ],
        [
          "appear",
          "wave-6"
        ],
        [
          "appear",
          "wave-7"
        ],
        [
          "appear",
          "wave-8"
        ],
        [
          "appear",
          "wave-9"
        ],
        [
          "appear",
          "wave-10"
        ],
        [
          "flag",
          "wave"
        ]
      ]
    },
    {
      "on": {
        "dead": "huangxin"
      },
      "do": [
        [
          "narrate",
          "黄信见势头不好，拨回马，独自飞马奔回清风镇去了。"
        ]
      ]
    },
    {
      "on": {
        "dead": "liugao"
      },
      "do": [
        [
          "narrate",
          "刘高见头势不好，拨转马头便走，却被喽啰拽翻，横拖倒拽，绑在一边。"
        ]
      ]
    },
    {
      "on": "allEnemiesDefeated",
      "if": "wave",
      "do": [
        [
          "appear",
          "songjiang"
        ],
        [
          "narrate",
          "官军都杀散了。众好汉打开囚车，救出宋江。"
        ],
        [
          "say",
          "songjiang",
          "若不是众位兄弟舍命，宋江今番必死！"
        ],
        [
          "say",
          "huarong",
          "刘高这厮恩将仇报，今番须饶他不得！"
        ],
        [
          "narrate",
          "花荣亲手把刘高斩了，替宋江出了这口恶气。"
        ],
        [
          "say",
          "luzhishen",
          "宋三郎，洒家和武二郎、杨制使先回二龙山去。日后有用着洒家处，只消一封书来！"
        ],
        [
          "say",
          "wusong",
          "哥哥保重。兄弟在二龙山专等哥哥消息。"
        ],
        [
          "narrate",
          "二龙山三位好汉辞别众人，自回山去了。众人拥着宋江、花荣，都上清风山来。"
        ],
        [
          "leave",
          "wusong"
        ],
        [
          "leave",
          "luzhishen"
        ],
        [
          "leave",
          "yangzhi"
        ],
        [
          "victory",
          "众好汉在清风山下劫了囚车，救出宋江、花荣。黄信逃回清风镇，刘高被花荣所杀。二龙山三位好汉回山，众人都上清风山。"
        ]
      ]
    },
    {
      "on": {
        "dead": "hero"
      },
      "do": [
        [
          "defeat",
          "武龙倒下，劫囚车失败。"
        ]
      ]
    },
    {
      "on": {
        "dead": "huarong"
      },
      "do": [
        [
          "defeat",
          "花荣又被官军拿住了。"
        ]
      ]
    }
  ]
}