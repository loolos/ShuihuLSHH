        ],
        [
          "appear",
          "wave2-9"
        ]
      ]
    },
    {
      "on": {
        "turn": 4
      },
      "do": [
        [
          "narrate",
          "北廊又有护院赶来，南面府门也闯进一队巡夜官差，前后堵截众人！"
        ],
        [
          "appear",
          "wave4-1"
        ],
