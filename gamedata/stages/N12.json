        {"op":15,"flag":1,"value":7},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":20},
        {"op":13,"flag":0,"id":8,"text":"后门也有官军埋伏！"},
        {"op":12,"flag":1,"value":12},
        {"op":13,"flag":0,"id":9,"text":"不管了！放火烧房子，全部人员从后门杀出！"},
