  "script": [
    {
      "on": "start",
      "do": [
        [
          "title",
          "梁山泊 · 聚义厅"
        ],
        [
          "narrate",
          "宋江同众好汉离了还道村，回到梁山泊。吴用领了守寨头领，直到金沙滩迎接，一同上到聚义厅上，与晁盖相见了。"
        ],
        [
          "say",
          "chaogai",
          "贤弟独自下山，众兄弟好不放心。且喜平安回来！"
        ],
        [
          "say",
          "songjiang",
          "老父还不知如何……"
        ],
        [
          "narrate",
          "说犹未了，只见宋清引着一乘轿子，抬着宋太公上山来。"
        ],
        [
          "appear",
          "songtaigong"
        ],
        [
          "appear",
          "songqing"
        ],
        [
          "narrate",
          "宋江见了，喜从天降，笑逐颜开，慌忙下拜。"
        ],
        [
          "say",
          "songjiang",
          "老父惊恐！宋江做了不孝之子，负累了父亲吃惊受怕！"
        ],
        [
          "say",
          "songtaigong",
          "叵耐赵能那厮弟兄两个，每日拨人来守定了我们，只待江州公文到来，便要捉取我父子二人解送官司。"
        ],
        [
          "say",
          "songtaigong",
          "亏得戴院长和几位头领半夜里赶来，扶我上轿，一把火烧了庄院，才脱得这场祸事。"
        ],
        [
          "say",
          "songjiang",
          "今日父子团圆相见，皆赖众兄弟之力也！兄弟，快拜谢了众头领。"
        ],
        [
          "narrate",
          "宋清拜谢了众头领。晁盖便叫杀牛宰马，大吹大擂，作庆贺筵席。"
        ],
        [
          "say",
          "chaogai",
          "贤弟，听刘唐兄弟说，你在还道村吃了一场大惊恐？"
        ],
        [
          "say",
          "songjiang",
          "赵能、赵得引着土兵，把小可赶进还道村。那村只有一条路，小可没处躲，只得钻进一座古庙的神厨里。"
        ],
        [
          "say",
          "songjiang",
          "两个都头来挑帐子，只见神厨里卷起一阵黑尘，又起一阵怪风，把火把都吹灭了。众土兵都道是神明嗔怪，乱窜起来。"
        ],
        [
          "say",
          "likui",
          "哥哥只顾躲，铁牛在庙前一斧砍了赵能那厮，好不爽快！"
        ],
        [
          "say",
          "songjiang",
          "庙里供的是九天玄女娘娘。小可梦里被两个青衣童子请去，娘娘赐了仙酒仙枣，又传下三卷天书。醒来袖里果然有这三卷书。"
        ],
        [
          "say",
          "songjiang",
          "娘娘吩咐：『汝可替天行道为主，全忠仗义为臣，辅国安民，去邪归正。』"
        ],
        [
          "say",
          "chaogai",
          "替天行道……兄弟们聚在这水泊里，正该如此！"
        ],
        [
          "say",
          "songjiang",
          "娘娘又道：『此三卷之书，只可与天机星同观，其他皆不可见。功成之后，便可焚之，勿留在世。』只不知这天机星是谁。"
        ],
        [
          "say",
          "wuyong",
          "既是娘娘法旨，哥哥且把天书好生收藏，不可轻易示人。天机自有分晓，日后自然应验。"
        ],
        [
          "say",
          "gongsunsheng",
          "贫道看来，此是上天垂象。公明哥哥休负了娘娘之言。"
        ],
        [
          "narrate",
          "看官听说：这天机星，便是智多星吴用。后来宋江只与吴学究两个同看天书，此是后话。"
        ],
        [
          "tint",
          "dusk"
        ],
        [
          "title",
          "第三日 · 筵席上"
        ],
        [
          "narrate",
          "一连吃了三日筵席。第三日酒席上，公孙胜起身，对晁盖、宋江说道——"
        ],
        [
          "say",
          "gongsunsheng",
          "贫道自随众头领上山，多时不曾还乡。蓟州老母在彼，亦恐我真人本师悬望，欲待回乡省视一遭。"
        ],
        [
          "say",
          "gongsunsheng",
          "暂别众头领，三五个月再回来相见，以满小道之愿。"
        ],
        [
          "say",
          "chaogai",
          "向日已闻先生所言，令堂在北方无人侍奉。今既如此说时，难以阻当。只是不忍分别。"
        ],
        [
          "say",
          "gongsunsheng",
          "小道回家参过本师真人，安顿了老母，便回山寨。"
        ],
        [
          "say",
          "chaogai",
          "百日之外，专望鹤驾降临，切不可爽约。"
        ],
        [
          "say",
          "gongsunsheng",
          "小道岂敢失信。"
        ],
        [
          "tint",
          ""
        ],
        [
          "narrate",
          "次日早，众头领直送到金沙滩。晁盖取出一盘黄白之资相送。公孙胜作道人打扮，背上雌雄宝剑，拜别了众人，望蓟州去了。"
        ],
        [
          "leave",
          "gongsunsheng"
        ],
        [
          "say",
          "likui",
          "干鸟气么！这个也去取爷，那个也去望娘，偏铁牛是土掘坑里钻出来的！"
        ],
        [
          "narrate",
          "说罢，李逵就关下放声大哭起来。"
        ],
        [
          "victory",
          ""
        ]
      ]
    }
  ]
}