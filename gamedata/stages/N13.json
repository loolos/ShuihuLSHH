      "head": [1,18,5,1,1,2,33,2,0],
      "ops": [
        {"op":12,"flag":1,"value":32},
        {"op":13,"flag":0,"id":1,"text":"报告观察！此地叫做蓼儿洼，邻近梁山泊；周围都是深湖水泽，加上比人还要高的芦苇，几乎连前方五尺的东西都看不清。这附近时常有强人出没，但是连官军也不敢轻易进剿...何观察，我看我们还是早点退兵吧..."},
        {"op":12,"flag":1,"value":54},
        {"op":13,"flag":0,"id":2,"text":"胆小鬼！谁要是敢退一步的话，就以阵前逃亡当场斩首！"},
        {"op":12,"flag":1,"value":33},
        {"op":13,"flag":0,"id":3,"text":"左右有人影！"},
        {"op":12,"flag":1,"value":8},
        {"op":18,"flag":1,"value":0},
        {"op":19,"flag":1,"value":56},
        {"op":13,"flag":0,"id":4,"text":"打鱼一世蓼儿洼，不种青苗不种麻。酷吏赃官都杀尽，忠臣报答赵官家！"},
        {"op":12,"flag":1,"value":32},
        {"op":13,"flag":0,"id":5,"text":"这个人就是阮小五！"},
        {"op":12,"flag":1,"value":9},
        {"op":13,"flag":0,"id":6,"text":"老爷生长石碣村，禀性生来要杀人。先斩何涛巡简首，京师献与赵王君！"},
        {"op":12,"flag":1,"value":33},
        {"op":13,"flag":0,"id":7,"text":"这个正是阮小七！"},
        {"op":12,"flag":1,"value":54},
        {"op":13,"flag":0,"id":8,"text":"嘿！好大胆！居然敢两个人就来挑衅官军！阮小二不在，这两个人就没有什么好怕的！左右！先把这两个人捉起来！"},
        {"op":35,"flag":null,"value":50},
        {"op":31,"flag":null,"id":9,"text":"限制回合数 --- 50"},
        {"op":32,"flag":null,"id":10,"text":"胜利条件   --- 引诱何涛深入蓼儿洼"},
        {"op":33,"flag":null,"id":11,"text":"失败条件一 --- 阮小五死亡"},
        {"op":33,"flag":null,"id":12,"text":"失败条件二 --- 阮小七死亡"}
      ]
    },
    {
