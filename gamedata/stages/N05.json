      "ops": [
        {"op":12,"flag":1,"value":11},
        {"op":18,"flag":1,"value":0},
        {"op":19,"flag":1,"value":29},
        {"op":13,"flag":0,"text":"高衙内！你调戏我妻子，同时用言语污辱我；我忍受不住了！我一定要把你打得满地找牙才甘心！"},
        {"op":12,"flag":1,"value":57},
        {"op":13,"flag":0,"text":"你...你敢打我？你知道打了我会有什么后果吗？"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"text":"我不在乎！我拼着大不了不干这个禁军教头，也要出这口鸟气！"},
        {"op":12,"flag":1,"value":57},
        {"op":13,"flag":0,"text":"哼哼...你只有一个人，我手下可有数十个人；就算你是禁军教头，你能打倒这么多人吗？"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"text":"卑鄙..."},
        {"op":12,"flag":1,"value":0},
        {"op":12,"flag":1,"value":3},
        {"op":12,"flag":0,"value":16},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"text":"林教头！我们来了！你可不是一个人孤军奋战！"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"text":"啊...%X兄...你们..."},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"text":"我们来助阵了！"},
        {"op":12,"flag":1,"value":16},
        {"op":13,"flag":0,"text":"有架可以打怎么不通知俺呢？太不够意思了吧！洒家的拳头好久没揍人了！"},
        {"op":12,"flag":1,"value":16,"quiet":true},
        {"op":13,"flag":1,"text":"林兄弟，你却怕他本官太尉，洒家怕他甚鸟！俺若撞见那撮鸟时，且教他吃洒家三百禅杖了去！"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"text":"好吧！大家爱怎么打就怎么打吧！不过，高衙内是我的对手，谁都不要出手！"},
        {"op":12,"flag":1,"value":4294967295},
        {"op":20,"flag":1,"text":"\u0001"},
        {"op":21,"flag":1,"text":"m08"},
        {"op":13,"flag":0,"text":"(林冲加入了！)"},
