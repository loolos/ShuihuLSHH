  "blocks": [
    {
      "trigger": {"kind":"turn","turn":0},
      "cond": {"type":0,"arg":0},
      "head": [1,16,4,1,1,1,25,2,0],
      "ops": [
        {"op":12,"flag":1,"value":26},
        {"op":13,"flag":0,"text":"两位教头，请较量一棒。"},
        {"op":12,"flag":1,"value":71},
        {"op":13,"flag":0,"text":"来，来，来！让我看看你有没有本事！"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"text":"(这个洪教头必定是柴大官人的师父；我若是一棒打翻了他，对柴大官人的面子上不好看...该如何是好？)"},
        {"op":12,"flag":1,"value":26},
        {"op":13,"flag":0,"text":"林武师，这位洪教头到这里也不久；在这里也没有遇上对手。林武师请尽全力，小可正要看看两位教头的本事。"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"text":"(原来不是柴大官人的师父！那我可以不用手下留情了。)"},
        {"op":12,"flag":1,"value":71},
        {"op":13,"flag":0,"text":"来，来，来！"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"text":"洪师父，请指教。"},
        {"op":12,"flag":1,"value":26,"quiet":true},
        {"op":13,"flag":1,"text":"二位教头比试，非比其他，这锭银子权为利物。哪位赢了，便拿了去。"},
        {"op":12,"flag":1,"value":26},
        {"op":17,"flag":0,"value":2},
        {"op":35,"flag":null,"value":10},
        {"op":31,"flag":null,"text":"限制回合数 --- 10"},
        {"op":32,"flag":null,"text":"胜利条件   --- 打败洪教头"},
        {"op":33,"flag":null,"text":"失败条件   --- 林冲死亡"}
      ]
    },
    {
      "trigger": {"kind":"turn","turn":10},
      "cond": {"type":0,"arg":10},
      "head": [1,0,1,0,0,0,38,2,0],
      "ops": [
        {"op":30,"flag":null,"text":"限制回合数已到，未完成任务，游戏失败！"}
      ]
    },
    {
      "trigger": {"kind":"death","char":11},
      "cond": {"type":1,"arg":11},
      "head": [1,0,1,0,0,0,156,2,1],
      "ops": [
        {"op":30,"flag":null,"text":"林冲败于洪教头棒下，众好汉再无颜面寄住府中，遂告别柴进，继续着亡命的生涯；林冲遭此重挫之后，从此郁郁寡欢，众人再也闯不出名堂，于是分道扬镳，四散而去........"}
      ]
    },
    {
      "trigger": {"kind":"death","char":71},
      "cond": {"type":1,"arg":71},
      "head": [1,10,1,0,0,0,18,2,1],
      "ops": [
        {"op":12,"flag":1,"value":4294967295,"quiet":true},
        {"op":13,"flag":1,"text":"林冲把棒一横，那棒直扫着洪教头臁儿骨上，洪教头撇了棒，扑地倒了。"},
        {"op":12,"flag":1,"value":71},
        {"op":13,"flag":0,"text":"呜啊！"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"text":"洪师父，承让了。"},
        {"op":12,"flag":1,"value":71},
        {"op":13,"flag":0,"text":"你...你以为这样子就结束了吗！徒弟们！给我上！给我狠狠地打！"},
        {"op":12,"flag":1,"value":26},
        {"op":13,"flag":0,"text":"洪教头！你在干什么！"},
        {"op":12,"flag":1,"value":71},
        {"op":13,"flag":0,"text":"少罗唆！我要把这个林冲的四肢打断才甘心！"},
        {"op":29,"flag":null,"text":"一场恶战即将开始。"}
      ]
    }
  ]
}
