      "cond": {"type":1,"arg":0},
      "head": [1,0,1,0,0,0,96,2,1],
      "ops": [
        {"op":30,"flag":null,"text":"林冲等人重心顿失，束手就擒，陆谦手起刀落，将众人斩于草料场，一场大火，将众人烧得片骨无存........"}
      ]
    },
    {
      "trigger": {"kind":"death","char":11},
      "cond": {"type":1,"arg":11},
      "head": [1,0,1,0,0,0,128,2,1],
      "ops": [
        {"op":30,"flag":null,"text":"林冲死于乱刀之下，成为草料场的堆肥，%N误中陷阱被捕，终被挑断手筋、脚筋，成为废人，其余人等误闯草料堆中，终被大火烧死，无一幸免…"}
      ]
    },
    {
      "trigger": {"kind":"death","char":255},
      "cond": {"type":1,"arg":255},
      "head": [1,10,1,0,0,0,8,2,1],
      "ops": [
        {"op":12,"flag":1,"value":64,"quiet":true,"actor":{"action":"show","near":11}},
        {"op":12,"flag":1,"value":4294967295,"quiet":true},
        {"op":13,"flag":1,"text":"一场恶战过后，喊杀声渐息。陆谦负伤倒在雪地里，尚有一口气，正挣扎着往外爬。林冲赶上前，劈胸只一提，将他掼翻在地。"},
        {"op":12,"flag":1,"value":64,"quiet":true,"actor":{"action":"speak"}},
        {"op":13,"flag":1,"text":"饶命！不干小人事，太尉差遣，不敢不来。"},
        {"op":12,"flag":1,"value":11,"quiet":true},
        {"op":13,"flag":1,"text":"奸贼！我与你自幼相交，今日倒来害我，怎不干你事！"},
        {"op":12,"flag":1,"value":64,"quiet":true,"actor":{"action":"speak"}},
        {"op":13,"flag":1,"text":"太尉府的差遣，谁敢违拗？我若不来，也要丢了性命！教头只看往日情分，放我这一遭！"},
        {"op":12,"flag":1,"value":11,"quiet":true},
        {"op":13,"flag":1,"text":"情分？你骗我去你家，替高衙内害我娘子时，可曾想过情分？我吃官司、受刺配，你还追到野猪林；如今又放火烧我的安身处！"},
        {"op":12,"flag":1,"value":64,"quiet":true,"actor":{"action":"speak"}},
        {"op":13,"flag":1,"text":"是小人一时糊涂！我回京便说你死在火里，从此再不来寻你。你饶我一命，我必报答！"},
        {"op":12,"flag":1,"value":11,"quiet":true},
        {"op":13,"flag":1,"text":"你方才还说，便逃得性命，也要拿失守草料场的死罪来治我。烧不死，便送上法场——你们何曾肯留我一条路！"},
        {"op":12,"flag":1,"value":64,"quiet":true,"actor":{"action":"speak"}},
        {"op":13,"flag":1,"text":"林冲！你若杀了我，太尉岂肯罢休？你便再无回头的余地了！"},
        {"op":12,"flag":1,"value":11,"quiet":true},
        {"op":13,"flag":1,"text":"我一路忍让，只求保全一家性命，你们却步步相逼。事到如今，还拿高俅来压我！"},
        {"op":12,"flag":1,"value":4294967295,"quiet":true},
        {"op":13,"flag":1,"text":"陆谦扯住林冲衣角，口里仍叫着饶命。林冲一把甩开他的手，拔出刀来。"},
        {"op":12,"flag":1,"value":11,"quiet":true},
        {"op":13,"flag":1,"text":"陆谦，你我旧日的交情，早被你亲手断尽了。今日这一刀，是你自取的！"},
        {"op":12,"flag":1,"value":4294967295,"quiet":true},
        {"op":13,"flag":1,"text":"林冲手起一刀，结果了陆谦。"},
        {"op":12,"flag":1,"value":64,"quiet":true,"actor":{"action":"hide"}},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"text":"沧州也不能待下去了；高俅已经知道我们在这里了。如果继续在这里，一定会连累到柴大官人..."},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"text":"大哥，去延安府吧。我们还得通知师父，高俅已经知道他躲在延安府的事..."},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"text":"林教头，为了你亲人的安全；你最好把他们托付给柴大官人。陆谦虽然被你杀了，但是第二波、第三波的追兵必定源源不绝的出现。高俅的追兵只会跟着你走，并不会刻意追查你的亲人的。"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"text":"...我知道了。这样子对他们是最安全的吧 ..."},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"text":"走吧，去延安府...必须要早点通知王进。"},
        {"op":29,"flag":null,"text":"过关了！"}
      ]
    }
  ]
}
