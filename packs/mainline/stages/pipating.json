  "script": [
    {
      "on": "start",
      "do": [
        [
          "title",
          "江州 · 琵琶亭下江边"
        ],
        [
          "narrate",
          "宋江在琵琶亭上要几尾鲜鱼做醒酒汤。李逵自告奋勇，跳下亭子，奔到江边渔船上讨鱼。"
        ],
        [
          "say",
          "likui",
          "你船上活鱼，把两尾来与我！"
        ],
        [
          "say",
          "yuren-1",
          "主人不来，我们不敢开舱卖鱼。"
        ],
        [
          "narrate",
          "李逵等不得，跳上船去，把竹笆篾一拔，那活鱼都走了。众渔人一齐拿竹篙来打李逵。"
        ],
        [
          "objective",
          "胜：先把张顺打到一半体力以下；之后宋江、戴宗、武龙任一人赶到栈桥中段（被渔人堵着），宋江亮出张横的书信\n败：李逵倒下；超过 15 回合"
        ],
        [
          "turnLimit",
          15
        ]
      ]
    },
    {
      "on": {
        "turn": 2
      },
      "do": [
        [
          "narrate",
          "只见江边小路上一个人奔来，头上裹着青纱万字巾，腰下系一条绢水裙——正是卖鱼的主人张顺。"
        ],
        [
          "appear",
          "zhangshun"
        ],
        [
          "say",
          "zhangshun",
          "你这黑大汉，吃了豹子心、大虫胆，也不敢来搅乱老爷的道路！"
        ],
        [
          "say",
          "likui",
          "老爷正要打你这鸟人！"
        ]
      ]
    },
    {
      "on": {
        "hp": "zhangshun",
        "below": 50
      },
      "do": [
        [
          "narrate",
          "张顺吃李逵打得急了，一跳跳上栈桥边泊着的渔船，把竹篙一点。"
        ],
        [
          "move",
          "zhangshun",
          4,
          15
        ],
        [
          "say",
          "zhangshun",
          "黑杀才！今番来和你见个输赢！你若是好汉，便下水来！"
        ],
        [
          "say",
          "likui",
          "我便怕你不成！"
        ],
        [
          "leave",
          "yuren-1"
        ],
        [
          "leave",
          "yuren-2"
        ],
        [
          "leave",
          "yuren-3"
        ],
        [
          "leave",
          "yuren-4"
        ],
        [
          "leave",
          "yuren-5"
        ],
        [
          "leave",
          "yuren-6"
        ],
        [
          "move",
          "likui",
          5,
          15
        ],
        [
          "narrate",
          "李逵跳上船去，张顺把船一侧，两个都翻在江里。张顺把李逵提将起来，又淹将下去，不知淹了几十遭。"
        ],
        [
          "bind",
          "likui"
        ],
        [
          "setAi",
          "zhangshun",
          11
        ],
        [
          "buff",
          "zhangshun",
          "attack",
          {
            "pct": 50,
            "turns": 99
          }
        ],
        [
          "buff",
          "zhangshun",
          "defense",
          {
            "pct": 50,
            "turns": 99
          }
        ],
        [
          "appear",
          "lan-1"
        ],
        [
          "appear",
          "lan-2"
        ],
        [
          "appear",
          "lan-3"
        ],
        [
          "appear",
          "lan-4"
        ],
        [
          "narrate",
          "渔人们在栈桥上一字排开，拦住去路，只是喝彩。"
        ],
        [
          "appear",
          "songjiang"
        ],
        [
          "appear",
          "daizong"
        ],
        [
          "appear",
          "hero"
        ],
        [
          "focus",
          "songjiang"
        ],
        [
          "say",
          "daizong",
          "不好！那白条子把铁牛淹在江里了！"
        ],
        [
          "say",
          "songjiang",
          "张横兄弟的书信还在我身边——快去栈桥上，叫他住手！"
        ],
        [
          "objective",
          "胜：宋江、戴宗、武龙任一人赶到栈桥中段，宋江亮出张横的书信\n败：李逵倒下（他在水里，每回合挨张顺淹）；超过 15 回合"
        ],
        [
          "flag",
          "water"
        ]
      ]
    },
