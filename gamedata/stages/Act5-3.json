  "blocks": [
    {
      "trigger": {"kind":"turn","turn":0},
      "cond": {"type":0,"arg":0},
      "head": [1,58,1,0,0,0,38,2,0],
      "ops": [
        {"op":12,"flag":1,"value":57},
        {"op":18,"flag":1,"value":0},
        {"op":19,"flag":1,"value":27},
        {"op":13,"flag":0,"text":"来嘛！只不过上五岳楼喝个小茶，聊个小天嘛。何必这么扭扭捏捏呢？"},
        {"op":12,"flag":1,"value":30},
        {"op":13,"flag":0,"text":"人...人家可是有丈夫的人，怎么可以跟着陌生男子随便上酒楼..."},
        {"op":12,"flag":1,"value":63},
        {"op":13,"flag":0,"text":"我们家主人可是当朝高太尉之子，名满天下的美男子；世上不知道有多少女子迷恋他？这种天下知名的风流人物怎么会是『陌生男子』啊？"},
        {"op":12,"flag":1,"value":37},
        {"op":13,"flag":0,"text":"是啊是啊，我们高衙内的风度翩翩，能够与他春宵一夜，也算是三生有幸啊。"},
        {"op":12,"flag":1,"value":57},
        {"op":13,"flag":0,"text":"唉...你那个丈夫那里比得上本人的风流倜傥？小美人，『有花堪折直须折，莫待无花空折枝。』如此风花雪月的良辰美景，正是谈情说爱的好时机啊！"},
        {"op":12,"flag":1,"value":63},
        {"op":13,"flag":0,"text":"啊！真不愧是少爷啊！文思泉涌，出口成章；令小人佩服的五体投地！"},
        {"op":12,"flag":1,"value":37},
        {"op":13,"flag":0,"text":"少爷的天纵英明，我们凡人哪里比得上他的千分...不，是万分之一啊！"},
        {"op":12,"flag":1,"value":57},
        {"op":13,"flag":0,"text":"哼哼..."},
        {"op":12,"flag":1,"value":30},
        {"op":13,"flag":0,"text":"我...我要叫了！"},
        {"op":12,"flag":1,"value":57},
        {"op":13,"flag":0,"text":"你叫啊？全东京城上下有谁不知道我是高太尉的儿子；是没有人敢跟我作对！谁敢当见义勇为的英雄好汉，那就是找死！"},
        {"op":12,"flag":1,"value":11},
        {"op":14,"flag":1,"value":7},
        {"op":15,"flag":1,"value":12},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":11},
        {"op":18,"flag":1,"value":0},
        {"op":19,"flag":1,"value":28},
        {"op":13,"flag":0,"text":"调戏良人妻子，当得何罪！"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"text":"(不好！这位是高太尉的干儿子，人称『花花太岁』的高衙内...)"},
        {"op":12,"flag":1,"value":57},
        {"op":13,"flag":0,"text":"唷，这不是林冲吗？本人正在谈情说爱的时候，你干什么来搅局？想来英雄救美？还是活得不耐烦了？还不赶快退下！"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"text":"...衙内有所不知，此名女子乃小人的妻子；希望衙内就此罢手。"},
        {"op":12,"flag":1,"value":57},
        {"op":13,"flag":0,"text":"哦，这年头英雄救美是用半路上认老婆的方法啊？无凭无据，为什么我要相信你？这种话我也会说，这个女子是我指腹为婚的妻子；怎样？"},
        {"op":12,"flag":1,"value":63},
        {"op":14,"flag":1,"value":8},
        {"op":15,"flag":1,"value":11},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":63},
        {"op":13,"flag":0,"text":"(衙内有所不知，这名女子的确是林冲的妻子。)"},
        {"op":12,"flag":1,"value":57},
        {"op":13,"flag":0,"text":"就算是你的妻子又怎么样？被我高衙内看上眼的女子，我还不曾没弄上手过！你不过是个小小的教头，还敢顶撞我？"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"text":"...."},
        {"op":12,"flag":1,"value":57},
        {"op":13,"flag":0,"text":"怎样，敢打我吗？来呀，我的脸颊就在这里给你打。"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"text":"...."},
        {"op":12,"flag":1,"value":57},
        {"op":13,"flag":0,"text":"哼！没种！"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"text":"老虎不发威，你把我当病猫！"},
        {"op":12,"flag":1,"value":57},
        {"op":13,"flag":0,"text":"啊...血 、流血了！牙齿也掉了；还有我俊美的脸...杀！给我把林冲杀掉！"},
        {"op":29,"flag":null,"text":"忍无可忍，毋须再忍，该出手的时候到了！"}
      ]
    }
  ]
}
