      "ops": [
        {"op":12,"flag":1,"value":58},
        {"op":18,"flag":1,"value":0},
        {"op":19,"flag":1,"value":47},
        {"op":13,"flag":0,"text":"你们是什么人？"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"text":"我是『%M』%N！你们哪一个人是晁盖？"},
        {"op":12,"flag":1,"value":58},
        {"op":13,"flag":0,"text":"行不更名、坐不改姓；『托塔天王』晁盖就是本人。这位壮士有何贵干？"},
        {"op":12,"flag":1,"value":14},
        {"op":13,"flag":0,"text":"少罗嗦！快把『生辰纲』还来！"},
        {"op":12,"flag":1,"value":58},
        {"op":13,"flag":0,"text":"哦？原来是梁中书的走狗。想必你一定从他那里得到不少好处吧！是卖私盐？还是开赌场？"},
        {"op":12,"flag":1,"value":14},
        {"op":13,"flag":0,"text":"不准你污辱恩相！"},
        {"op":12,"flag":1,"value":58},
        {"op":13,"flag":0,"text":"狗果然是狗。只知道死忠，却不知自己的主人做了什么事。连白痴都知道，清官哪有可能搜集这么多珠宝珍玩献给自己的岳父祝寿呢？当然不是贪污就是压榨民脂民膏！而你们这些走狗就是真正的帮凶！"},
        {"op":12,"flag":1,"value":14},
        {"op":13,"flag":0,"text":"...."},
        {"op":12,"flag":1,"value":58},
        {"op":13,"flag":0,"text":"我们将会代表平民百姓的怒吼，给腐败的高官们迎头痛击！"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"text":"这种大话我也听多了。每一个强盗在发威时看起来都是英雄无敌、豪气万千；碰到生死关头时，却常常是跪下求饶，分明是狗熊一个。现在把『生辰纲』交出来，我还可以放你一条生路；否则，就只有强行用武力夺取！"},
        {"op":12,"flag":1,"value":58},
        {"op":13,"flag":0,"text":"有趣！有本事你就打倒我抢回『生辰纲』吧！"},
        {"op":12,"flag":1,"value":4294967295},
        {"op":13,"flag":0,"text":"晁盖一伙日后都是同道中人。打倒晁盖便能问出生辰纲的下落；吴用、公孙胜等人体力不到三成就会罢手，不必赶尽杀绝。"},
        {"op":35,"flag":null,"value":50},
        {"op":31,"flag":null,"text":"限制回合数 --- 50"},
        {"op":32,"flag":null,"text":"胜利条件   --- 打败晁盖"},
        {"op":33,"flag":null,"text":"失败条件一 --- %N死亡"},
        {"op":33,"flag":null,"text":"失败条件二 --- 杨志死亡"}
      ]
    },
