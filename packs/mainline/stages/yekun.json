        ],
        [
          "narrate",
          "燕顺、郑天寿和两侧伏着的喽啰这才一齐现身，护住陷坑，将秦明押离战场。"
        ],
        [
          "say",
          "songjiang",
          "秦总管已擒住！兄弟们合力打退其余官军，休教他们抢回人去！"
        ]
      ]
    },
    {
      "on": {
        "dead": "songjiang"
      },
      "do": [
        [
          "defeat",
          "宋江倒下，清风山失守。"
        ]
      ]
    },
    {
      "on": {
        "dead": "hero"
      },
      "do": [
        [
          "defeat",
          "武龙倒下，清风山失守。"
        ]
      ]
    },
    {
      "on": "allEnemiesDefeated",
      "if": "qinming-captured",
      "do": [
        [
          "narrate",
          "青州官军尽数被打退，众好汉收住兵器，将擒获的秦明押回清风山。"
        ],
        [
          "victory",
          "秦明已被擒住，其余敌军全部败退，众人押他回山。"
        ]
      ]
    }
  ]
