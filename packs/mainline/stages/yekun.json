  "script": [
    {
      "on": "start",
      "do": [
        [
          "title",
          "清风山 · 夜伏官道"
        ],
        [
          "narrate",
          "黄信逃回青州，申报清风山反了花荣。慕容知府差本州兵马总管秦明，领一百马军、四百步军，杀奔清风山来。"
        ],
        [
          "narrate",
          "那秦明性格急躁，声若雷霆，人都叫他做霹雳火。使一条狼牙棒，有万夫不当之勇。"
        ],
        [
          "focus",
          "qinming"
        ],
        [
          "say",
          "qinming",
          "反贼花荣！你祖代是将门之子，朝廷命官，教你做个知寨，掌握一境地方，食禄于国，有何亏你处，却去结连贼寇，反背朝廷！"
        ],
        [
          "focus",
          "huarong"
        ],
        [
          "say",
          "huarong",
          "秦明，你这厮原来不识好人饶让。我念你是个上司官，你道俺真个怕你！"
        ],
        [
          "say",
          "huarong",
          "秦总管，你只凭刘高一面之词，便认定我等是反贼？我若有心伤你，何须在此分说！"
        ],
        [
          "say",
          "qinming",
          "休逞口舌！有胆量便下来，与我见个高低！"
        ],
        [
          "narrate",
          "花荣不再争辩，将枪横住，探手取弓。山风掠过官道，秦明盔顶的红缨正迎风摆动；花荣搭箭扣弦，稳稳瞄住那一点殷红。"
        ],
        [
          "say",
          "huarong",
          "秦总管，看你盔上红缨！"
        ],
        [
          "shoot",
          "huarong",
          "qinming",
          "一箭落缨"
        ],
        [
          "narrate",
          "花荣拈弓搭箭，望秦明盔顶上只一箭，正中盔上，射落斗来大那颗红缨，却似报个信与他。"
        ],
        [
          "narrate",
          "弦声犹在山间回荡，红缨已随箭飘落。秦明勒马抬头，只觉盔顶一轻，身后的马军也不由得收住了缰绳。"
        ],
        [
          "say",
          "qz-1",
          "总管！他这一箭……只取红缨，并未伤人！"
        ],
        [
          "say",
          "huarong",
          "这一箭只作相劝。且听我将冤屈说清，莫叫军士们枉送性命。"
        ],
        [
          "say",
          "qinming",
          "好箭法！却休想凭这一箭吓退秦明！众军随我上前，拿住花荣！"
        ],
        [
          "say",
          "hero",
          "他果然动了真怒。哥哥们且退，让小弟去引他！"
        ],
        [
          "say",
          "songjiang",
          "那秦明性如烈火，只消沿这官道引他上来。前方路中已掘下陷坑，两边又伏着人，诱他来，便好拿他。"
        ],
        [
          "say",
          "hero",
          "小弟和铁牛在路中撩拨他，待他追近便往北退，引那厮从两边伏兵中间冲进坑里！"
        ],
        [
          "buff",
          "qinming",
          "defense",
          {
            "pct": 800
          }
        ],
        [
          "turnLimit",
          20
        ],
        [
          "tint",
          "night"
        ]
      ]
    },
    {
      "on": {
        "turn": 3
      },
      "do": [
        [
          "tint",
          "night"
        ],
        [
          "narrate",
          "夜色渐深。官道两侧伏着的喽啰只是放冷箭、丢擂木，秦明越发焦躁。"
        ]
      ]
    },
    {
      "on": {
        "turn": 4
      },
      "do": [
        [
          "narrate",
          "山下又有一伙青州步军赶上山来接应。"
        ],
        [
          "appear",
          "wave-1"
        ],
        [
          "appear",
          "wave-2"
        ],
        [
          "appear",
          "wave-3"
        ],
        [
          "appear",
          "wave-4"
        ],
        [
          "appear",
          "wave-5"
        ],
        [
          "appear",
          "wave-6"
        ],
        [
          "appear",
          "wave-7"
        ],
        [
          "appear",
          "wave-8"
        ],
        [
          "appear",
          "wave-9"
        ],
        [
          "appear",
          "wave-10"
        ],
        [
          "appear",
          "wave-11"
        ],
        [
          "appear",
          "wave-12"
        ],
        [
          "flag",
          "wave"
        ]
      ]
    },
    {
      "on": {
        "enter": "qinming",
        "area": [
          14,
          9,
          19,
          12
        ],
        "label": "陷坑"
      },
      "do": [
        [
          "narrate",
          "秦明怒气冲天，拍马舞棒，只顾往山上赶。赶到半山里，黑地里只听得一声响——走不到三五十步，和人连马攧下陷坑里去。"
        ],
        [
          "narrate",
          "两边埋伏下五十个挠钩手，把秦明搭将起来，剥了衣甲、头盔、军器，拿条绳索绑了，把马也救起来，都解上山来。"
        ],
        [
          "capture",
          "qinming"
        ],
        [
          "appear",
          "yanshun"
        ],
        [
          "appear",
          "zhengtianshou"
        ],
        [
          "appear",
          "ally-1"
        ],
        [
          "appear",
          "ally-2"
        ],
        [
          "appear",
          "ally-3"
        ],
        [
          "flag",
          "qinming-captured"
        ],
        [
          "narrate",
          "燕顺、郑天寿和两侧伏着的喽啰这才一齐现身，护住陷坑，将秦明押离战场。"
        ],
        [
          "say",
          "songjiang",
          "秦总管已擒住！兄弟们合力打退其余官军，休教他们抢回人去！"
        ]
      ]
    },
    {
      "on": {
        "dead": "qinming"
      },
      "do": [
        [
          "narrate",
          "秦明力乏，马也跑得困了，却还不肯退。"
        ],
        [
          "narrate",
          "秦明怒气冲天，拍马舞棒，只顾往山上赶。赶到半山里，黑地里只听得一声响——走不到三五十步，和人连马攧下陷坑里去。"
        ],
        [
          "narrate",
          "两边埋伏下五十个挠钩手，把秦明搭将起来，剥了衣甲、头盔、军器，拿条绳索绑了，把马也救起来，都解上山来。"
        ],
        [
          "capture",
          "qinming"
        ],
        [
          "appear",
