    },
    {
      "on": {
        "enter": "wusong",
        "area": [
          6,
          1,
          16,
          9
        ]
      },
      "do": [
        [
          "leave",
          "wine-1"
        ],
        [
          "leave",
          "wine-2"
        ],
        [
          "leave",
          "wine-3"
        ],
        [
          "say",
          "jiang-wife",
          "甚么人在此撒野？"
        ],
        [
          "leave",
          "jiang-wife"
        ],
        [
          "say",
          "jiangmenshen",
          "敢来快活林寻事，先问问蒋门神的拳头！你是何人？"
        ],
        [
          "say",
          "wusong",
          "俺便是武松。施恩的酒店，怎地落到了你的手里？"
        ],
        [
          "say",
          "jiangmenshen",
          "施恩打不过我，自然让给我。怎么，你要替他出头？"
        ],
        [
          "say",
          "wusong",
          "他在牢城里待俺有恩，俺应下替他讨个公道。你仗势夺店，又打伤人，今日把酒店还来！"
        ],
        [
          "say",
          "jiangmenshen",
          "这快活林有张团练照看！你一个配军，也敢来管我的事？"
        ],
        [
          "say",
          "wusong",
          "休拿张团练吓人！你既凭拳头夺店，俺便凭这双拳头，教你还给施恩！"
        ],
        [
          "appear",
          "jiangmenshen"
        ],
        [
          "appear",
          "guard-1"
        ],
        [
          "appear",
          "guard-2"
        ],
        [
          "appear",
          "guard-3"
        ],
