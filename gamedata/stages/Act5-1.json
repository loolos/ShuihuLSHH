  "blocks": [
    {
      "trigger": {"kind":"turn","turn":0},
      "cond": {"type":0,"arg":0},
      "head": [1,88,1,0,0,0,42,2,0],
      "ops": [
        {"op":12,"flag":1,"value":16},
        {"op":18,"flag":1,"value":1},
        {"op":19,"flag":1,"value":24},
        {"op":13,"flag":0,"text":"刚才是你说要把俺打得『一佛出世，二佛升天』？有本事就来啊？哇哈哈！"},
        {"op":12,"flag":1,"value":55},
        {"op":13,"flag":0,"text":"(可恶...待会儿等我兄弟来救时，看我怎么报仇...)"},
        {"op":12,"flag":1,"value":16},
        {"op":13,"flag":0,"text":"太公，洒家没有骗你吧！这个强盗头子不会再烦你了；到时候把这一伙人送至官府还可以领到一大笔赏金。这都是我佛慈悲；善哉善哉...哦，没酒了？太公，再拿酒来！"},
        {"op":12,"flag":1,"value":27},
        {"op":13,"flag":0,"text":"唉...是是..."},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"text":"贤弟，何不引见一下这位师兄？"},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"text":"他原本是经略府提辖，姓鲁名达；过去曾经有一面之缘，他曾经在史家村借住过一阵子。不过为什么剃了一个大光头，我就不清楚了。"},
        {"op":12,"flag":1,"value":16},
        {"op":13,"flag":0,"text":"洒家三拳打死一名叫『镇关西』的郑姓屠夫，被官府通缉；想想干脆上五台山当和尚避避风头..."},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"text":"看破红尘了吗？"},
        {"op":12,"flag":1,"value":16},
        {"op":13,"flag":0,"text":"结果在五台山上喝酒吃狗肉、打坏了看山门的金刚力士、打伤了数十个和尚...被赶下山了。"},
        {"op":12,"flag":1,"value":16,"quiet":true},
        {"op":13,"flag":1,"text":"临走时，智真长老送了洒家四句偈子：『遇林而起，遇山而富，遇水而兴，遇江而止。』洒家到如今也参不透。"},
        {"op":12,"flag":1,"value":0,"quiet":true},
        {"op":13,"flag":1,"text":"（遇林而起……）"},
        {"op":12,"flag":1,"value":27},
        {"op":13,"flag":0,"text":"啊？原来你不是五台山上的高僧？！"},
        {"op":12,"flag":1,"value":16},
        {"op":13,"flag":0,"text":"洒家又没说自己是高僧；俺从五台山下来也是事实...啊，没肉了，再拿五斤肉来。"},
        {"op":12,"flag":1,"value":27},
        {"op":13,"flag":0,"text":"阿弥陀佛...我怎么留了一个花和尚下来..."},
        {"op":12,"flag":1,"value":19},
        {"op":14,"flag":1,"value":8},
        {"op":15,"flag":1,"value":6},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":19},
        {"op":13,"flag":0,"text":"太公，桃花山大头目拜见。"},
        {"op":12,"flag":1,"value":27},
        {"op":13,"flag":0,"text":"啊？又有强盗？"},
        {"op":12,"flag":1,"value":16},
        {"op":13,"flag":0,"text":"无妨。叫他进来，他敢作怪就一同捉起来！"},
        {"op":12,"flag":1,"value":25},
        {"op":14,"flag":1,"value":13},
        {"op":15,"flag":1,"value":9},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":25},
        {"op":13,"flag":0,"text":"手下留情！吾弟管教不周，冒犯尊颜；希望壮士能够网开一面，放吾弟一条生路。在下一定备齐金银珠宝作为谢礼..."},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"text":"这位声音好熟..."},
        {"op":12,"flag":1,"value":25},
        {"op":13,"flag":0,"text":"史进？你不是史进吗？好久不见！"},
        {"op":12,"flag":1,"value":3},
        {"op":14,"flag":1,"value":12},
        {"op":15,"flag":1,"value":9},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"text":"师父！"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"text":"这位是...？"},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"text":"这位是『打虎将』李忠，我的第七任师父。"},
        {"op":12,"flag":1,"value":25},
        {"op":13,"flag":0,"text":"太好了，原来是自己人！"},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"text":"师父，你怎么会在这里？"},
        {"op":12,"flag":1,"value":25},
        {"op":13,"flag":0,"text":"刚才被你们打的那名大汉叫做『小霸王』周通；原本就在桃花山上当大王。前些日子抢劫路人时抢到你师父，被我打败；结果他把山寨中第一把交椅给我坐了，自己情愿坐第二把交椅。"},
        {"op":12,"flag":1,"value":25,"quiet":true},
        {"op":13,"flag":1,"text":"……咦，这位师父，你的声音好厮熟。莫不是渭州的鲁提辖？"},
        {"op":12,"flag":1,"value":16,"quiet":true},
        {"op":13,"flag":1,"text":"洒家不是别人，老种经略相公帐前提辖鲁达的便是。如今出了家做和尚，唤做鲁智深。李忠，你还在街上使枪棒卖膏药么？"},
        {"op":12,"flag":1,"value":25,"quiet":true},
        {"op":13,"flag":1,"text":"哥哥别来无恙！小弟如今在桃花山落草，惭愧，惭愧。"},
        {"op":12,"flag":1,"value":16},
        {"op":13,"flag":0,"text":"哈哈，原来都是故人！来来，坐下喝酒... 啊，椅子不够了；太公，拿椅子来！"},
        {"op":12,"flag":1,"value":27},
        {"op":13,"flag":0,"text":"(完蛋了，原来这群贼党是一伙的！连那个花和尚都跟他们称兄道弟...)"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"text":"太公别紧张。大家都先坐下。"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"text":"李师父也在这里当个见证；刘太公这门亲事就不要再提了。他只有这个女儿，周兄弟这样霸王硬上弓也没道理；不如就此作罢。从此两家和平，好吗？"},
        {"op":12,"flag":1,"value":55},
        {"op":13,"flag":0,"text":"可是..."},
        {"op":12,"flag":1,"value":25},
        {"op":13,"flag":0,"text":"兄弟，%X兄都已经这么说了，你就看你老哥哥份上答应了吧。"},
        {"op":12,"flag":1,"value":55},
        {"op":13,"flag":0,"text":"...好吧。"},
        {"op":12,"flag":1,"value":16},
        {"op":13,"flag":0,"text":"哇哈哈！太好了！大家达成共识又不伤和气，值得庆祝！太公，还有什么吃的喝的全部拿上来！"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"text":"鲁兄，接下来你有什么打算吗？"},
        {"op":12,"flag":1,"value":16},
        {"op":13,"flag":0,"text":"五台山是回不去；嗯...跟着你们似乎会遇上不少有趣的事。好！我就跟你们一起走吧！就这么决定了！"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"text":"喂喂，不要这样擅自决定好不好...(苦笑)"},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"text":"他以前就是这样的性格..."},
        {"op":12,"flag":1,"value":4294967295},
        {"op":13,"flag":0,"text":"第二天，李忠与周通带着喽罗们回到桃花山上，继续过著打家劫舍的日子；%N一行人也继续踏上旅程，往延安府前进。"},
        {"op":29,"flag":null,"text":"经过大家的努力，桃花村又恢复了以往的平静。"}
      ]
    }
  ]
}
