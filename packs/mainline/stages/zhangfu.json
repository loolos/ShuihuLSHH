        [
          "narrate",
          "武松提条哨棒抢入后花园，寻了一遍不见人影，转身时却被一条板凳绊翻，七八个军汉叫声「捉贼」，就地把他绑了。"
        ],
        [
          "act",
          "guard-a",
          "attack",
          "wusong"
        ],
        [
