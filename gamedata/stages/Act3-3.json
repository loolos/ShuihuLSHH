      "head": [1,28,1,0,0,0,34,2,0],
      "ops": [
        {"op":12,"flag":1,"value":49},
        {"op":13,"flag":0,"id":1,"text":"(大郎是疯了吗？放着白花花的三千贯不赚，还把银子们放了？好，你不赚我赚！)"},
        {"op":12,"flag":1,"value":49},
        {"op":14,"flag":1,"value":10},
        {"op":15,"flag":1,"value":8},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":38},
        {"op":13,"flag":0,"id":2,"text":"下面是谁啊？"},
        {"op":12,"flag":1,"value":49},
        {"op":13,"flag":0,"id":3,"text":"小人李吉，家居史家村，以打猎维生。"},
        {"op":12,"flag":1,"value":38},
        {"op":13,"flag":0,"id":4,"text":"嗯，有何事要禀报啊？"},
        {"op":12,"flag":1,"value":49},
        {"op":13,"flag":0,"id":5,"text":"大爷明鉴。托大爷的鸿福，少华山三个强盗的下落已经知道了。"},
        {"op":12,"flag":1,"value":38},
        {"op":13,"flag":0,"id":6,"text":"什么？那些山贼在哪里？！"},
        {"op":12,"flag":1,"value":49},
        {"op":13,"flag":0,"id":7,"text":"那三个强盗正在史家村跟史进饮酒作乐、称兄道弟呢！"},
        {"op":12,"flag":1,"value":38},
        {"op":18,"flag":1,"value":0},
        {"op":19,"flag":1,"value":14},
        {"op":13,"flag":0,"id":8,"text":"岂有此理！身为村长，居然跟山贼狼狈为奸？！国家有此种仓中之鼠，哪会安定？！来人啊！马上集合部队，由我亲自带兵讨贼！"},
        {"op":12,"flag":1,"value":49},
        {"op":13,"flag":0,"id":9,"text":"大爷，那么那三千贯的奖赏..."},
        {"op":12,"flag":1,"value":38},
        {"op":13,"flag":0,"id":10,"text":"等到捉住史进一伙人之后，我不会亏待你的。现在，还需要你帮我们带路。"},
        {"op":12,"flag":1,"value":49},
        {"op":13,"flag":0,"id":11,"text":"是！"},
        {"op":29,"flag":null,"id":12,"text":"李吉出卖史进，官府举兵进犯史家村。"}
      ]
    }
  ]
