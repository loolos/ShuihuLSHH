      "head": [1,32,1,0,0,0,20,2,0],
      "ops": [
        {"op":12,"flag":1,"value":0},
        {"op":14,"flag":1,"value":8},
        {"op":15,"flag":1,"value":6},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"id":1,"text":"刚刚那一批人已被我们打跑，短期内可能不会追来..."},
        {"op":12,"flag":1,"value":8},
        {"op":13,"flag":0,"id":2,"text":"无妨！只要逃到这里就没问题了！"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"id":3,"text":"没问题？这里四周都是与人等高的芦苇，我看我们会先在里面迷路！"},
        {"op":12,"flag":1,"value":7},
        {"op":13,"flag":0,"id":4,"text":"教头有所不知。这里名叫蓼儿洼，我们三兄弟住的石碣村就在附近。也就是说，这个蓼儿洼等于是我家的后院。哪里有深渊、哪里可以埋伏，没有人比我们兄弟更了解！"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"id":5,"text":"这里如果知道地形的话，真的是不错的埋伏地点..."},
        {"op":12,"flag":1,"value":21},
        {"op":14,"flag":1,"value":10},
        {"op":15,"flag":1,"value":12},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":21},
        {"op":18,"flag":1,"value":0},
        {"op":19,"flag":1,"value":55},
        {"op":13,"flag":0,"id":6,"text":"二郎！你是干了什么事啊？有许多官兵跟着你们后面追过来啦！带头的何观察还直向我们问说有没有看到晁盖、阮氏三兄弟的人影..."},
        {"op":12,"flag":1,"value":7},
        {"op":13,"flag":0,"id":7,"text":"不要慌；我们三个就足以对付他们！让他们大半下水淹死、小半被刀戳死！"},
        {"op":12,"flag":1,"value":10},
        {"op":13,"flag":0,"id":8,"text":"%X兄，以兵法上来说，奇袭总是最好的办法；敌人虽然人多势众，但是我们可占了天时、地利、人和；此战必胜！"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"id":9,"text":"也好！我们就在这里给他们来个迎头痛击！"},
        {"op":12,"flag":1,"value":7},
        {"op":13,"flag":0,"id":10,"text":"孙二，事情紧急！你快去村子里找些人来帮忙！拜托你了！"},
        {"op":12,"flag":1,"value":21},
        {"op":13,"flag":0,"id":11,"text":"我知道了！"},
        {"op":29,"flag":null,"id":12,"text":"阮氏兄弟设计蓼儿洼。"}
      ]
    }
  ]
}
