  "blocks": [
    {
      "trigger": {"kind":"turn","turn":0},
      "cond": {"type":0,"arg":0},
      "head": [1,62,4,1,1,1,23,2,0],
      "ops": [
        {"op":12,"flag":1,"value":42},
        {"op":13,"flag":0,"id":1,"text":"山贼正在村子里面吗？这个史进实在是太大胆了。"},
        {"op":12,"flag":1,"value":49},
        {"op":13,"flag":0,"id":2,"text":"就是啊。县尉大爷，那个史进一定是以前就跟强盗们勾结。"},
        {"op":12,"flag":1,"value":38},
        {"op":13,"flag":0,"id":3,"text":"报告县尉，部队已经部署完毕；我们不会让任何一只苍蝇逃走！"},
        {"op":12,"flag":1,"value":42},
        {"op":13,"flag":0,"id":4,"text":"嗯，很好。现在已经布下了天罗地网，量他们插翅也难飞了！哈哈哈！"},
        {"op":12,"flag":1,"value":42},
        {"op":13,"flag":0,"id":5,"text":"里面的人听着！我是华阴县县尉，你们已经被包围了！我们有三四百名士兵已经将村子周围紧紧包围，不要企图脱逃，更不要意图抵抗！我们已经得到情报，史进窝藏三名少华山山贼朱武、陈达、杨春。此四人快快束手就缚；否则全村视为贼党，格杀勿论！"},
        {"op":12,"flag":1,"value":19},
        {"op":12,"flag":1,"value":0},
        {"op":12,"flag":1,"value":1},
        {"op":12,"flag":1,"value":3},
        {"op":12,"flag":1,"value":5},
        {"op":12,"flag":1,"value":13},
        {"op":12,"flag":0,"value":15},
        {"op":12,"flag":1,"value":19},
        {"op":18,"flag":1,"value":0},
        {"op":19,"flag":1,"value":15},
        {"op":13,"flag":0,"id":6,"text":"大郎，不好了！官军把这里团团围住了！"},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"id":7,"text":"官军怎么会知道这事？！"},
        {"op":12,"flag":1,"value":5},
        {"op":13,"flag":0,"id":8,"text":"史兄，你是没有前科的人，不要被我们连累了。你可以用绳索把我们三人绑住带去领赏，以免连累了你。"},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"id":9,"text":"不行！这不就成了我用计把你们留下来，再伙同官军捉住；江湖上会以为我『九纹龙』是个卖友求荣之人！如今死时同死，活时同活，不要再提把你们送出去领赏的事了！现在先让我问个清楚，再想办法。"},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"id":10,"text":"你们为何三更半夜前来劫我庄？"},
        {"op":12,"flag":1,"value":38},
        {"op":13,"flag":0,"id":11,"text":"大郎，不要狡辩了！你私藏强人，你庄中的李吉已经一五一十的讲出来了！"},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"id":12,"text":"胡说八道！我把强人骗住用蒙汗药迷倒，现在全部五花大绑准备送官！这个李吉平常做事不牢靠，常常被我责骂鞭打；今日我派他前去通告官府，没有想到居然反咬我一口，想要独吞三千贯的赏金！畜生！"},
        {"op":12,"flag":1,"value":42},
        {"op":13,"flag":0,"id":13,"text":"李吉，有这回事？"},
        {"op":12,"flag":1,"value":49},
        {"op":13,"flag":0,"id":14,"text":"他骗人！"},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"id":15,"text":"两位都头不必急，我现在就把三名强盗带出来同去请赏。"},
        {"op":12,"flag":1,"value":38},
        {"op":13,"flag":0,"id":16,"text":"大郎肯这样最好。"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"id":17,"text":"(贤弟，你有何打算？)"},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"id":18,"text":"(这种情况下，只有强行突破了。我将率领庄客们诱敌拖延时间；乘这机会，让村里的老弱妇孺逃走。)"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"id":19,"text":"(王教头，你也趁此机会带着母亲往延安府去吧！)"},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"id":20,"text":"(师父您放心。有您传授的功夫，这种货色三五百个还近不了我身。您安心的走吧！)"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"id":21,"text":"(教头放心，史进的安危就交给我了。)"},
        {"op":12,"flag":1,"value":1},
        {"op":13,"flag":1,"id":22,"text":"(对不起...徒儿有难却无法助一臂之力...)"},
        {"op":17,"flag":0,"value":2},
        {"op":12,"flag":1,"value":5},
        {"op":13,"flag":0,"id":23,"text":"(某等也愿助一臂之力！)"},
        {"op":12,"flag":1,"value":4294967295},
        {"op":20,"flag":1,"text":"\u0001"},
        {"op":21,"flag":1,"text":"m08"},
        {"op":13,"flag":0,"id":24,"text":"(少华山叁头目加入了！)"},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"id":25,"text":"(那太好了！等到村门一开，大伙一齐杀出；杀得他们片甲不留！)"},
        {"op":35,"flag":null,"value":50},
        {"op":31,"flag":null,"id":26,"text":"限制回合数 --- 50"},
        {"op":32,"flag":null,"id":27,"text":"胜利条件   --- 打败县尉"},
        {"op":33,"flag":null,"id":28,"text":"失败条件   --- %N死亡"}
      ]
    },
