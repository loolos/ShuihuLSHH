  "blocks": [
    {
      "trigger": {"kind":"turn","turn":0},
      "cond": {"type":0,"arg":0},
      "head": [1,48,5,1,1,2,27,2,0],
      "ops": [
        {"op":12,"flag":1,"value":4294967295,"quiet":true},
        {"op":13,"flag":1,"text":"正是严冬天气，彤云密布，朔风渐起，那雪正下得紧。"},
        {"op":12,"flag":1,"value":4294967295,"quiet":true},
        {"op":13,"flag":1,"text":"草料场的草厅年久失修，四下漏风。林冲与众好汉一道出外采买修屋的材料，顺带沽些酒食御寒。归来时，却见草堆间火光冲天，风卷烈焰，已不是寻常失火的模样。"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"text":"不好！草料场怎么已经烧起来了？我们才去市集买修屋的材料和酒食，来回不过这点工夫！"},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"text":"林教头，先别冲过去！那边有三个人走来，咱们且借山神庙旁的暗处藏身，听听动静。"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"text":"（低声）我出门前盖好了火盆，门也锁妥了。这样大的火，难道有人故意纵的？"},
        {"op":12,"flag":1,"value":71},
        {"op":18,"flag":1,"value":0},
        {"op":19,"flag":1,"value":40},
        {"op":13,"flag":0,"text":"这火势好！我在四下草堆点了十来处火，任他林冲有天大的本事，也无处躲藏！"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"text":"（低声）是洪教头的声音……诸位暂且忍耐，莫惊动他们。"},
        {"op":12,"flag":1,"value":71},
        {"op":13,"flag":0,"text":"先前听说柴进替他安排了这份差事，我也只是记在心里。谁想今日倒成了结果他性命的所在！"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"text":"（暗想）原来他们早就盯上了我，却等到此时才下手……"},
        {"op":12,"flag":1,"value":64},
        {"op":13,"flag":0,"text":"端的亏你用心！管营、差拨那边已经打点妥当。回到京师禀过太尉，自有你们的好处。"},
        {"op":12,"flag":1,"value":71},
        {"op":13,"flag":0,"text":"便逃得性命时，烧了大军草料场，也得个死罪！咱们再看一看，休叫他脱了身。"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"text":"（低声）陆谦，富安……竟又是这两个！"},
        {"op":12,"flag":1,"value":63},
        {"op":13,"flag":0,"text":"再等火烧透了，拾得他两块骨头回京，也好在太尉和衙内面前交差。林冲一死，衙内那桩心事便了了！"},
        {"op":12,"flag":1,"value":4294967295,"quiet":true},
        {"op":13,"flag":1,"text":"林冲伏在暗处，将三人的话听得明白，这才知晓纵火与治罪的毒计。他攥紧花枪，怒从心起；众好汉也各执兵刃，随他现身拦住去路。"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"text":"泼贼！你们竟放火害我，还要拿失守草料场的罪名断我的活路！今日不杀你们，林冲还有甚么活路！"},
        {"op":12,"flag":1,"value":71,"quiet":true},
        {"op":13,"flag":1,"text":"林冲？！你竟不在草料场里！方才的话……都叫你听去了？"},
        {"op":12,"flag":1,"value":63,"quiet":true},
        {"op":13,"flag":1,"text":"陆虞候，他身后还有人！快叫弟兄们围住，莫让他们走脱！"},
        {"op":12,"flag":1,"value":64,"quiet":true},
        {"op":13,"flag":1,"text":"林教头，且慢动手！我也是奉命行事，你我旧日的交情，何必闹到这般田地？"},
        {"op":12,"flag":1,"value":11,"quiet":true},
        {"op":13,"flag":1,"text":"陆谦！我只道你是故交，谁知你一回回要置我于死地！如今毒计败露，还敢来攀旧日情分！"},
        {"op":12,"flag":1,"value":64,"quiet":true},
        {"op":13,"flag":1,"text":"既把话说破，便留你不得！众人一起上，休叫一个走了！"},
        {"op":12,"flag":1,"value":1011},
        {"op":12,"flag":1,"value":1012},
        {"op":12,"flag":1,"value":1013},
        {"op":12,"flag":1,"value":1014},
