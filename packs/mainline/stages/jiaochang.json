{
 "id": "jiaochang",
 "title": "禁军教场",
 "tutorial": true,
 "gearAt": "none",
 "rewards": { "gold": 0 },
 "map": { "base": "Train1" },
 "bgm": ["march", "rock"],
 "units": [
  { "id": "wangjin", "class": 1, "side": "player", "x": 9, "y": 13, "facing": 0, "level": 4, "items": [14, 84, 113, 156, 156, 0, 0] },
  { "id": "zhangpai", "class": 32, "side": "ally", "x": 8, "y": 14, "facing": 0, "level": 4, "name": "张牌", "ai": 8, "hpMultiplier": 2 },
  { "id": "lipai", "class": 33, "side": "ally", "x": 10, "y": 14, "facing": 0, "level": 4, "name": "李牌", "ai": 8 },
  { "id": "p2", "class": 33, "side": "enemy", "x": 9, "y": 8, "facing": 2, "level": 2, "name": "陪练军士", "ai": 8, "hidden": true, "hpMultiplier": 4 },
  { "id": "p3a", "class": 33, "side": "enemy", "x": 7, "y": 8, "facing": 0, "level": 2, "name": "陪练军士", "ai": 8, "hidden": true, "hpMultiplier": 4 },
  { "id": "p3b", "class": 33, "side": "enemy", "x": 11, "y": 8, "facing": 0, "level": 2, "name": "陪练军士", "ai": 8, "hidden": true, "hpMultiplier": 4 },
  { "id": "p4a", "class": 33, "side": "enemy", "x": 7, "y": 7, "facing": 2, "level": 2, "name": "陪练军士", "ai": 8, "target": "wangjin", "hidden": true, "hpMultiplier": 4 },
  { "id": "p4b", "class": 33, "side": "enemy", "x": 11, "y": 7, "facing": 2, "level": 2, "name": "陪练军士", "ai": 8, "target": "wangjin", "hidden": true, "hpMultiplier": 4 },
  { "id": "p5a", "class": 33, "side": "enemy", "x": 8, "y": 7, "facing": 2, "level": 2, "name": "陪练军士", "ai": 8, "hidden": true, "hpMultiplier": 4 },
  { "id": "p5b", "class": 33, "side": "enemy", "x": 9, "y": 7, "facing": 2, "level": 2, "name": "陪练军士", "ai": 8, "hidden": true, "hpMultiplier": 4 },
  { "id": "p5c", "class": 33, "side": "enemy", "x": 10, "y": 7, "facing": 2, "level": 2, "name": "陪练军士", "ai": 8, "hidden": true, "hpMultiplier": 4 },
  { "id": "p8a", "class": 33, "side": "enemy", "x": 8, "y": 6, "facing": 2, "level": 2, "name": "守台军士", "ai": 0, "hidden": true, "hpMultiplier": 2 },
  { "id": "p8b", "class": 33, "side": "enemy", "x": 10, "y": 6, "facing": 2, "level": 2, "name": "守台军士", "ai": 0, "hidden": true, "hpMultiplier": 2 },
  { "id": "junzheng", "class": 36, "side": "ally", "x": 11, "y": 15, "facing": 0, "level": 3, "name": "军正司", "ai": 8, "hidden": true },
  { "id": "gaoqiu", "class": 56, "side": "ally", "x": 10, "y": 15, "facing": 0, "level": 20, "ai": 8, "hidden": true },
  { "id": "yajiang", "class": 38, "side": "ally", "x": 12, "y": 15, "facing": 0, "level": 10, "name": "牙将", "ai": 8, "hidden": true }
 ],
 "script": [
  { "on": "start", "do": [
   ["title", "东京 · 殿帅府教场", "#1"],
   ["narrate", "话说哲宗皇帝在位时，东京开封府汴梁城里有个浮浪破落户子弟，姓高，排行第二，自小不成家业，只好刺枪使棒，最是踢得好脚气毬，京师人都叫他做高毬。后来发迹，便将气毬那字去了「毛」傍，添作「立人」，改作姓高名俅。", "#2"],
   ["narrate", "这高俅凭一脚好球得了端王欢心。后来端王做了天子，便是道君皇帝，不到半年，抬举高俅做到殿帅府太尉。", "#3"],
   ["narrate", "殿帅府里有个八十万禁军教头，姓王名进。这些时日患病在家，今日病体初愈，便到教场里来看军士操练。", "#4"],
   ["say", "zhangpai", "教头病好了！小的们都盼着教头指点几路棒法。", "#5"],
   ["say", "lipai", "教头，弟兄们今日都在，正好操演一回。", "#6"],
   ["say", "wangjin", "好。张牌、李牌，你两个看仔细了：临阵对敌，先要知道怎么走、怎么打、怎么守。", "#7"],
   ["choice", "要不要跟着王教头操练一遍？（操作教学，约十分钟）", ["跟着操练（教学）", "teach", "#8"], ["跳过教学，直接看剧情", "skip", "#9"], "#10"]
  ]},

  { "on": { "flag": "skip" }, "do": [
   ["narrate", "王进在教场里操演了一日，众军士无不叹服。", "#11"],
   ["flag", "moved"],
   ["flag", "done"]
  ]},

  { "on": { "flag": "teach" }, "do": [
   ["say", "wangjin", "先说站位。我走到前面那一格，你们看着。", "#12"],
   ["narrate", "【教学 1/8 · 移动】点王进（或点他脚下的格子），在弹出的菜单里选「移动」，地图上会标出走得到的格子，再点标出的目标格。目标格在地图和小地图上用颜色标出。", "#13"],
   ["objective", "教学 1/8 --- 移动：让王进走到标出的格子", "#14"],
   ["objective", "提示       --- 点人物 → 移动 → 点目标格", "#15"]
  ]},
  { "on": { "enter": "wangjin", "area": [9, 10, 9, 10], "label": "目标" }, "if": "teach", "do": [
   ["flag", "moved"],
   ["narrate", "【教学】走过以后，这一回合还能出手；没走满的步数也还能再走。出手之前，菜单里的「撤销移动」可以退回原地。", "#16"],
   ["appear", "p2"],
   ["say", "p2", "请教头赐教！", "#17"],
   ["say", "wangjin", "来得好。看棒！", "#18"],
   ["narrate", "【教学 2/8 · 攻击】走到陪练军士旁边一格，选「攻击」，再点他。选中目标后，屏幕下方会显示命中率和预计伤害。没打中也不要紧，下回合再来。", "#19"],
   ["narrate", "【教学】王进出过手，这一回合就算行动完了。我方的人都行动完会自动「回合终了」，轮到对方；也可以随时按右上角的「回合终了」。", "#20"],
   ["objective", "教学 2/8 --- 攻击：打中陪练军士一下", "#21"],
   ["objective", "提示       --- 走到旁边 → 攻击 → 点目标", "#22"]
  ]},
  { "on": { "hp": "p2", "below": 100 }, "do": [
   ["say", "p2", "哎哟！教头好棒法，小的服了！", "#23"],
   ["leave", "p2"],
   ["flag", "step3"],
   ["say", "wangjin", "正面打人，人家看得见，躲得开、挡得住。临阵要会抢人背后。", "#24"],
   ["appear", "p3a"],
   ["appear", "p3b"],
   ["say", "zhangpai", "这两个弟兄背对着教头，教头绕过去试试。", "#25"],
   ["narrate", "【教学 3/8 · 背后与侧面】人物有朝向。从背后打，命中高得多，伤害 ×1.25；从侧面打，伤害 ×1.1。绕到陪练军士背后或侧面，再攻击他。", "#26"],
   ["objective", "教学 3/8 --- 从背后或侧面攻击陪练军士", "#27"],
   ["objective", "提示       --- 他们面朝里，绕到身后那一格再攻击", "#28"]
  ]},
  { "on": { "did": "wangjin", "action": "attack" }, "if": "step3", "unless": "step4", "do": [
   ["say", "zhangpai", "教头，那是正面！绕到他身后再打。", "#29"]
  ]},
  { "on": { "did": "wangjin", "action": "flank" }, "if": "step3", "do": [
   ["flag", "step4"],
   ["say", "p3a", "哎呀，背后吃了一棒，竟没瞧见！", "#30"],
   ["leave", "p3a"],
   ["leave", "p3b"],
   ["say", "wangjin", "这就是了。反过来，人家抢你背后，你也要会守。", "#31"],
   ["appear", "p4a"],
   ["appear", "p4b"],
   ["buff", "p4a", "attack", { "pct": -70, "turns": 20 }],
   ["buff", "p4b", "attack", { "pct": -70, "turns": 20 }],
   ["say", "p4a", "教头摆好架势，我们两个便一齐上！", "#32"],
   ["narrate", "【教学 4/8 · 防御与反击】选「防御」，王进这一回合不出手，挨打时伤害减三成；对方贴身打过来被你闪开，还有一半机会顺势反击，反击必定打中。王进摆出防御架势，两个陪练才会攻上来。", "#33"],
   ["narrate", "【教学】王进这一回合已经出过手，等对方回合过去（自动「回合终了」），下一回合再点王进选「防御」。", "#34"],
   ["objective", "教学 4/8 --- 防御：让王进防御，挨对方一下", "#35"],
   ["objective", "提示       --- 点王进 → 防御 → 等对方回合", "#36"]
  ]},
  { "on": { "did": "wangjin", "action": "defend" }, "if": "step4", "unless": "step5", "do": [
   ["say", "p4b", "教头架势摆好了，上！", "#37"],
   ["setAi", "p4a", 1],
   ["setAi", "p4b", 1]
  ]},
  { "on": { "did": "wangjin", "action": "attack" }, "if": "step4", "unless": "step5", "do": [
   ["say", "lipai", "教头先别还手，这一节是练守的，选「防御」。", "#38"]
  ]},
  { "on": { "did": "wangjin", "action": "counter" }, "if": "step4", "do": [
   ["say", "zhangpai", "好！闪开就是一棒，这便是反击！", "#39"]
  ]},
  { "on": { "did": "wangjin", "action": "guard" }, "if": "step4", "unless": "step5", "do": [
   ["say", "p4b", "教头守得严实，打不进去！", "#40"],
   ["say", "wangjin", "守住了，再寻空当还手。好，退下罢。", "#41"],
   ["flag", "step5"]
  ]},
  { "on": { "hp": "p4a", "below": 35 }, "do": [["say", "p4a", "教头手下留情，小的认输！", "#42"], ["standDown", "p4a"], ["flag", "p4aout"]] },
  { "on": { "hp": "p4b", "below": 35 }, "do": [["say", "p4b", "小的也认输了！", "#43"], ["standDown", "p4b"], ["flag", "p4bout"]] },
  { "on": { "flag": "p4aout" }, "if": "p4bout", "unless": "step5", "do": [["say", "wangjin", "也罢，守的功夫，日后临阵再练。", "#44"], ["flag", "step5"]] },
  { "on": { "flag": "p4bout" }, "if": "p4aout", "unless": "step5", "do": [["say", "wangjin", "也罢，守的功夫，日后临阵再练。", "#45"], ["flag", "step5"]] },
  { "on": { "flag": "step5" }, "do": [
   ["leave", "p4a"],
   ["leave", "p4b"],
   ["appear", "p5a"],
   ["appear", "p5b"],
   ["appear", "p5c"],
   ["say", "lipai", "教头，再教我们几路真本事！", "#46"],
   ["say", "wangjin", "看好了，这几路是家传的。", "#47"],
   ["narrate", "【教学 5/8 · 技能与气】选「技能」，列表里是会的招式，后面的数字是要耗的气（人物头上的黄条）；气不够的招式是灰的。选好招式，地图上标出射程，指着格子能看到打到哪几格，再点一下出招。等级升上去还会领悟新招。", "#48"],
   ["objective", "教学 5/8 --- 技能：对陪练军士用一次技能", "#49"],
   ["objective", "提示       --- 点王进 → 技能 → 选一招 → 点目标", "#50"]
  ]},
  { "on": { "did": "wangjin", "action": "attack" }, "if": "step5", "unless": "step6", "do": [
   ["say", "zhangpai", "教头，那是寻常一棒。打开「技能」，使一路招式给我们看看！", "#51"]
  ]},
  { "on": { "did": "wangjin", "action": "skill" }, "if": "step5", "do": [
   ["flag", "step6"],
   ["say", "p5b", "好棒法！小的们佩服！", "#52"],
   ["leave", "p5a"],
   ["leave", "p5b"],
   ["leave", "p5c"],
   ["say", "wangjin", "……咳咳。病才好，到底气力不加。", "#53"],
   ["say", "lipai", "教头身上带着膏药，先贴上歇一歇。", "#54"],
   ["narrate", "【教学 6/8 · 道具】选「道具」，点狗皮膏药，再选「使用」，点王进自己（也可以给身边的人用）。用道具不算行动，用完还能做别的事；「给予」能把东西交给身边的自己人。", "#55"],
   ["narrate", "【教学】出过手的人这一回合就不能再用道具了。等回合终了，下一回合再点王进用膏药。", "#56"],
   ["objective", "教学 6/8 --- 道具：用一次狗皮膏药", "#57"],
   ["objective", "提示       --- 点王进 → 道具 → 狗皮膏药 → 使用", "#58"]
  ]},
  { "on": { "did": "wangjin", "action": "item" }, "if": "step6", "do": [
   ["flag", "step7"],
   ["say", "wangjin", "好些了。练武也要会歇。", "#59"],
   ["narrate", "【教学 7/8 · 休息】还没出手的人可以选「休息」，回复最大体力和气的五分之一，这一回合就不再行动。回合终了时还没行动的人会自动休息或防御。", "#60"],
   ["objective", "教学 7/8 --- 休息：让王进休息一次", "#61"],
   ["objective", "提示       --- 点王进 → 休息", "#62"]
  ]},
  { "on": { "did": "wangjin", "action": "rest" }, "if": "step7", "do": [
   ["flag", "step8"],
   ["say", "wangjin", "最后操演一阵抢旗。张牌扛着令旗随我上将台；台上两个弟兄守着，抢上去便算赢。", "#63"],
   ["say", "zhangpai", "得令！", "#64"],
   ["approach", "zhangpai", "wangjin"],
   ["defect", "zhangpai", "player"],
   ["appear", "p8a"],
   ["appear", "p8b"],
   ["buff", "p8a", "attack", { "pct": -80, "turns": 20 }],
   ["buff", "p8b", "attack", { "pct": -80, "turns": 20 }],
   ["narrate", "【教学 8/8 · 胜负条件】张牌现在也归你指挥，下回合起和王进一样点他行动。每关开头都会说明胜利、失败条件，随时可以按顶栏的「目标」按钮再看；要去的地方在地图和右下角小地图上标出来。", "#65"],
   ["objective", "教学 8/8 --- 胜利条件：张牌走进将台（标出的区域）", "#66"],
   ["objective", "失败条件   --- 王进或张牌倒下", "#67"]
  ]},
  { "on": { "hp": "p3a", "below": 40 }, "if": "step3", "unless": "step4", "do": [["say", "zhangpai", "正面打不进去的。教头绕到他身后！", "#68"], ["transform", "p3a", 33, "陪练军士"]] },
  { "on": { "hp": "p3b", "below": 40 }, "if": "step3", "unless": "step4", "do": [["say", "zhangpai", "正面打不进去的。教头绕到他身后！", "#69"], ["transform", "p3b", 33, "陪练军士"]] },
  { "on": { "hp": "p8a", "below": 50 }, "do": [["say", "p8a", "小的认输！", "#70"], ["standDown", "p8a"]] },
  { "on": { "hp": "p8b", "below": 50 }, "do": [["say", "p8b", "让了，让了！", "#71"], ["standDown", "p8b"]] },
  { "on": { "enter": "zhangpai", "area": [8, 4, 10, 5], "label": "将台" }, "if": "step8", "do": [
   ["say", "zhangpai", "令旗上台了！", "#72"],
   ["say", "wangjin", "操演得好。你们记着：走、打、守、招式、歇息，样样都要熟。", "#73"],
   ["narrate", "【教学完毕】以后每一关照这样打。打不过时，顶栏的「时光倒流」能回到之前的回合重来。", "#74"],
   ["flag", "done"]
  ]},

  { "on": { "flag": "done" }, "if": "moved", "do": [
   ["appear", "junzheng"],
   ["move", "junzheng", 9, 12],
   ["say", "junzheng", "王教头，不好了！新任高殿帅今日到任点名，满营官员都去参拜，只欠你一个。太尉大怒，说你推病在家，不伏他点视，亲自寻到教场来了！", "#75"],
   ["say", "wangjin", "我病了半月，今日才好，正待去参拜……", "#76"],
   ["appear", "gaoqiu"],
   ["appear", "yajiang"],
   ["move", "gaoqiu", 10, 11],
   ["face", "wangjin", "gaoqiu"],
   ["face", "gaoqiu", "wangjin"],
   ["say", "gaoqiu", "你那厮便是都军教头王昇的儿子？", "#77"],
   ["say", "wangjin", "小人便是。", "#78"],
   ["say", "gaoqiu", "这厮！你爷是街市上使花棒卖药的，你省的甚么武艺？前官没眼，参你做个教头，如何敢小觑我，不伏俺点视！你托谁的势要推病在家安闲快乐？", "#79"],
   ["say", "wangjin", "小人怎敢。其实患病未痊。", "#80"],
   ["say", "gaoqiu", "贼配军！你既害病，如何来得？左右，与我拿下这厮，加力与我打！", "#81"],
   ["say", "yajiang", "太尉，今日是太尉上任好日头，权免此人这一次。", "#82"],
   ["say", "gaoqiu", "你这贼配军，且看众将之面，饶恕你今日之犯，明日却和你理会！", "#83"],
   ["leave", "gaoqiu"],
   ["leave", "yajiang"],
   ["leave", "junzheng"],
   ["face", "wangjin", 2],
   ["say", "wangjin", "俺道是甚么高殿帅，却原来正是东京帮闲的圆社高二！比先时曾学使棒，被我父亲一棒打翻，三四个月将息不起，有此之仇。他今日发迹，得做殿帅府太尉，正待要报仇。我不想正属他管，自古道：「不怕官，只怕管。」俺如何与他争得？", "#84"],
   ["victory", "王进当众受辱，闷闷回到家中。", "#85"]
  ]},

  { "on": { "hp": "zhangpai", "below": 40 }, "if": "step8", "do": [
   ["say", "p8a", "张牌哥哥扛着旗，弟兄们别真打伤了他！", "#86"],
   ["standDown", "p8a"],
   ["standDown", "p8b"]
  ]},
  { "on": { "hp": "wangjin", "below": 35 }, "do": [
   ["say", "zhangpai", "教头大病初愈，弟兄们下手轻些！", "#87"],
   ["narrate", "众军士都放慢了手脚。王进喘了口气，精神又足了。", "#88"],
   ["transform", "wangjin", 1]
  ]},
  { "on": { "dead": "wangjin" }, "do": [["defeat", "王进力尽倒地。再操演一回吧。", "#89"]] },
  { "on": { "dead": "zhangpai" }, "do": [["defeat", "张牌被打倒了。再操演一回吧。", "#90"]] }
 ]
}
