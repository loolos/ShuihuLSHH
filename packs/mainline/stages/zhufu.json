        ],
        [
          "setAi",
          "c5",
          0
        ],
        [
          "setAi",
          "c6",
          0
        ],
        [
          "setAi",
          "caotaigong",
          4
        ]
      ]
    },
    {
      "on": {
        "turn": 6
      },
      "unless": "alarm",
      "do": [
        [
          "say",
          "liyun",
          "天色不早，众人吃够了，收拾上路！"
        ],
        [
          "narrate",
          "朱富再劝时，土兵们都要动身，看出了破绽。"
        ],
        [
          "flag",
          "alarm"
        ]
      ]
    },
    {
      "on": {
        "near": "likui",
        "by": "zhugui",
        "playerPhase": true
      },
      "do": [
        [
          "cleanse",
          "likui"
        ],
        [
          "say",
          "likui",
          "朱贵哥哥！快把俺的绳索割了——"
        ],
        [
          "narrate",
          "李逵挣断了麻索，夺过一把朴刀，大吼一声，跳将起来。"
        ],
        [
          "say",
          "likui",
          "曹太公那老驴、李鬼的婆娘，一个也休想走脱！"
        ],
        [
          "buff",
          "likui",
          "attack",
          {
            "pct": 20,
            "turns": 3
          }
        ],
        [
          "flag",
          "freed"
        ],
        [
          "flag",
          "alarm"
        ]
      ]
    },
    {
      "on": {
        "enter": "caotaigong",
        "area": [
          27,
          9,
          29,
          14
        ]
      },
      "do": [
        [
          "narrate",
          "曹太公过了板桥，一溜烟逃回县里去了。"
        ],
        [
          "leave",
          "caotaigong"
        ]
      ]
    },
    {
      "on": {
        "dead": "caotaigong"
      },
      "do": [
        [
          "say",
          "likui",
          "你这老驴灌俺酒、绑俺去请赏，今日也吃俺一刀！"
        ]
      ]
    },
    {
      "on": {
        "hp": "liyun",
        "below": 40
      },
      "do": [
        [
          "say",
          "liyun",
          "这黑厮好生了得！"
        ],
        [
          "flag",
          "liyun-low"
        ]
      ]
    },
    {
      "on": {
        "hp": "liyun",
        "below": 25
      },
      "unless": "liyun-join",
      "do": [
        [
          "standDown",
          "liyun"
        ],
        [
          "say",
          "liyun",
          "罢了……李云抵敌不住。"
        ],
        [
          "flag",
          "liyun-low"
        ]
      ]
    },
    {
      "on": {
        "near": "liyun",
        "by": "zhufu"
      },
      "if": "liyun-low",
      "do": [
        [
          "say",
          "zhufu",
          "师父听禀：小弟多蒙错爱，指教枪棒。今日事急，只得用计救了李大哥。师父失陷了犯人，回县去如何见知县？不如同上梁山泊，投奔宋公明入伙。"
        ],
        [
          "say",
          "liyun",
          "……我家中又无老小，回去必吃官司。罢！只得随你们去休！"
        ],
        [
          "say",
          "likui",
          "早说便是！险些吃俺砍了。"
        ],
        [
          "flag",
          "liyun-join"
        ],
        [
          "victory",
          "青眼虎李云纳头便拜，随朱富、朱贵、李逵一同投梁山泊来。宋江、晁盖大喜，就请李云、朱富坐了交椅。"
        ]
      ]
    },
    {
      "on": {
        "enter": [
          "likui",
          "zhufu"
        ],
        "area": [
          0,
          0,
          3,
          3
        ],
        "label": "小路",
        "atTurnEnd": true
      },
      "if": "freed",
      "do": [
        [
          "narrate",
          "朱富、朱贵引着李逵，抄小路望梁山泊便走。李云醒来，赶来时只见一地麻翻的土兵。他回县去必吃官司，寻思半晌，只得也赶上梁山泊来。"
        ],
        [
          "victory",
          "宋江见李逵回来，又添了青眼虎李云、笑面虎朱富两个好汉，大喜，筵席庆贺。"
        ]
      ]
    },
    {
      "on": {
        "dead": "likui"
      },
      "do": [
        [
          "defeat",
          "李逵倒下了……"
        ]
      ]
    },
    {
      "on": {
        "dead": "zhufu"
      },
      "do": [
        [
          "defeat",
          "朱富倒下了……"
        ]
      ]
    }
  ]
}
