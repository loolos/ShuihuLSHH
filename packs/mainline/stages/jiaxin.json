        ],
        [
          "appear",
          "m7"
        ]
      ]
    },
    {
      "on": {
        "enter": "hero",
        "area": [
          16,
          0,
          17,
          0
        ]
      },
      "do": [
        [
          "narrate",
          "众好汉护着武龙打开后门杀将出去，夺了几匹快马，星夜奔回梁山泊。"
        ],
        [
          "narrate",
          "蔡九知府把戴宗也下在死囚牢里，定下斩刑：宋江、戴宗两个，押赴江州十字路口，斩首示众。"
        ],
        [
          "narrate",
          "晁盖、吴用听了武龙报信，当下点起十七个头领，扮作客商、丐者、脚夫、使枪棒的，暗暗潜入江州。"
        ],
        [
          "victory",
          "众好汉杀出江州府衙后门，回梁山报信！"
        ]
      ]
    },
    {
      "on": {
        "dead": "hero"
      },
      "do": [
        [
          "defeat",
          "武龙倒下了……"
        ]
      ]
    }
  ]
}
