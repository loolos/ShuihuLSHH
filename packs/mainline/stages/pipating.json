        ],
        [
          "leave",
          "yuren-6"
        ],
        [
          "move",
          "likui",
          5,
          15
        ],
        [
          "face",
          "likui",
          "zhangshun"
        ],
        [
          "face",
          "zhangshun",
          "likui"
        ],
        [
          "narrate",
          "张顺便把竹篙望岸边一点，双脚一蹬，那只渔船一似狂风飘败叶，箭也似投江心里去了。"
        ],
        [
          "say",
          "zhangshun",
          "你来！今番和你定要见个输赢！"
        ],
        [
          "act",
          "likui",
          "attack",
          "zhangshun"
        ],
        [
          "act",
          "zhangshun",
          "defend",
          "likui"
        ],
        [
          "say",
          "zhangshun",
          "且不和你厮打，先教你吃些水。"
        ],
        [
          "narrate",
          "两只脚把船只一晃，船底朝天，英雄落水。两个都扑桶地翻筋斗撞下江里去。"
        ],
        [
          "act",
          "likui",
          "hurt"
        ],
        [
          "wait",
          400
        ],
        [
          "narrate",
          "只见江面开处，那人把李逵提将起来，又淹将下去。"
        ],
        [
          "act",
          "likui",
          "hurt"
        ],
        [
          "wait",
          300
        ],
        [
          "act",
          "likui",
          "hurt"
        ],
        [
          "wait",
          300
        ],
        [
          "act",
          "likui",
          "hurt"
        ],
        [
          "narrate",
          "何止淹了数十遭。"
        ],
        [
          "bind",
          "likui"
        ],
        [
          "setAi",
