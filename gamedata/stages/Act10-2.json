        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"id":2,"text":"喂！发生什么事了！振作一点。"},
        {"op":12,"flag":1,"value":14},
        {"op":13,"flag":0,"id":3,"text":"..."},
        {"op":12,"flag":1,"value":14},
        {"op":13,"flag":0,"id":4,"text":"不好！生辰纲！...啊...头好痛..."},
        {"op":12,"flag":1,"value":1002},
        {"op":13,"flag":0,"id":5,"text":"生，生辰纲不见了！这可是要杀头的啊！我不要死！"},
        {"op":12,"flag":1,"value":1003},
        {"op":13,"flag":0,"id":6,"text":"我，我也不要死！我要回家种田！"},
