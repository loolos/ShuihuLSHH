 "script": [
  {
   "on": "start",
   "do": [
    [
     "narrate",
     "试手关：看看新人物的样子和招式。"
    ],
    [
     "say",
     "daizong",
     "小可江州两院押牢节级戴宗，江湖上叫我「神行太保」。缚上四个甲马，一日能行八百里！"
    ],
    [
     "say",
     "likui",
     "铁牛在此！哪个鸟人来吃俺一斧？"
    ],
    [
     "say",
     "songjiang",
     "在下郓城宋江。两位兄弟，小心了！"
    ],
    [
     "objective",
     "胜利条件：打倒所有敌人"
    ],
    [
     "objective",
     "失败条件：戴宗、李逵或宋江倒下"
    ]
   ]
  },
  {
   "on": {
    "dead": "daizong"
   },
   "do": [
    [
     "defeat",
     "试手结束。"
    ]
   ]
  },
  {
   "on": {
    "dead": "likui"
   },
   "do": [
    [
     "defeat",
     "试手结束。"
    ]
   ]
  },
  {
   "on": {
    "dead": "songjiang"
   },
   "do": [
    [
     "defeat",
     "试手结束。"
    ]
   ]
  },
  {
   "on": "enemiesDefeated",
   "do": [
    [
     "victory",
     "试手完毕。"
    ]
   ]
  }
 ]
