          "attendant",
          "wusong"
        ],
        [
          "say",
          "attendant",
          "都监相公只请武都头一人进去，闲人在门外候着。"
        ],
        [
          "face",
          "hero",
          "wusong"
        ],
        [
          "say",
          "hero",
