        ],
        [
          "appear",
          "lan-4"
        ],
        [
          "narrate",
          "渔人们在栈桥上一字排开，拦住去路，只是喝彩。"
        ],
        [
          "say",
          "lan-1",
          "这黑大汉今番却着道儿。"
        ],
        [
          "appear",
          "songjiang"
        ],
        [
          "appear",
          "daizong"
        ],
        [
          "appear",
          "hero"
        ],
        [
          "focus",
