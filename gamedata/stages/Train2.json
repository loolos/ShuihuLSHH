      "head": [1,24,1,0,0,0,0,2,0],
      "ops": [
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"text":"师父！"},
        {"op":12,"flag":1,"value":1},
        {"op":13,"flag":0,"text":"喔！这不是史进吗？%X兄也在... 啊！林冲，你怎么也来了..."},
        {"op":12,"flag":1,"value":11},
        {"op":18,"flag":1,"value":0},
        {"op":19,"flag":1,"value":59},
        {"op":13,"flag":0,"text":"这真是说来话长啊..."},
        {"op":12,"flag":1,"value":4294967295},
        {"op":13,"flag":0,"text":"林冲将高衙内看上林夫人、白虎节堂遭陷、野猪林的暗杀、以及主角们仗义相助的来龙去脉都向王进说了。"},
        {"op":12,"flag":1,"value":1},
        {"op":13,"flag":0,"text":"唉～我所担心的事终究还是发生了。"},
        {"op":12,"flag":1,"value":11},
        {"op":13,"flag":0,"text":"不过这样也好，至少我不用再在那卑鄙小人的手下做事了，妻子和家人也都送到了安全的地方；倒是王大哥，高俅已经知道你在延安府了，我们都很担心他会来加害于你..."},
        {"op":12,"flag":1,"value":1},
        {"op":13,"flag":0,"text":"哈哈...这我倒不担心，我已经躲开他那么远了，我相信他不会再来找我麻烦...不谈这个了，来了那么多的好汉，怎么不帮我介绍一下。"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"text":"王兄，我来介绍，这位是...."},
        {"op":12,"flag":1,"value":4294967295},
        {"op":13,"flag":0,"text":"当下%N将晁盖、公孙胜、阮氏兄弟等众人一一介绍给王进，双方相互寒喧了一番，皆是惺惺相惜、相见恨晚。"},
        {"op":12,"flag":1,"value":1},
        {"op":13,"flag":0,"text":"对了！前些日子我又研究出一套功夫，谁有兴趣与我切磋切磋？"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"text":"哈哈！王兄真是嗜武成痴啊！"},
        {"op":27,"flag":null,"value":1}
      ]
    },
