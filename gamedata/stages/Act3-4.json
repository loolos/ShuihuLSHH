      "head": [1,30,1,0,0,0,18,2,0],
      "ops": [
        {"op":12,"flag":1,"value":0},
        {"op":18,"flag":1,"value":0},
        {"op":19,"flag":1,"value":16},
        {"op":13,"flag":0,"id":1,"text":"这样一来，代表我们正式与官府作对了... 贤弟，你有何打算？"},
        {"op":12,"flag":1,"value":13},
        {"op":13,"flag":0,"id":2,"text":"不如史进哥哥与咱们一起上少华山当大王，过着大秤分金、整套穿衣的生活！管他什么鸟官府，来多少杀多少！"},
        {"op":12,"flag":1,"value":15},
        {"op":13,"flag":0,"id":3,"text":"这样可好，有『九纹龙』史进在，有哪个官军敢正眼瞧我们？"},
        {"op":12,"flag":1,"value":3,"quiet":true},
        {"op":13,"flag":1,"id":4,"text":"我是个清白好汉，如何肯把父母遗体来点污了。你劝我落草，再也休题。"},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"id":5,"text":"总之这里是呆不下去了...吩咐所有庄客，将村中剩下的金银分一分，各自散去；再一把火烧了史家村，免得麻烦。接下来，就全看大哥作主了。"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"id":6,"text":"王教头说要前往延安府投靠朋友；不如我们也去找他，再做打算。"},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"id":7,"text":"嗯，就这么办。"},
        {"op":12,"flag":1,"value":5},
        {"op":14,"flag":1,"value":10},
        {"op":14,"flag":1,"value":10},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":5},
        {"op":13,"flag":0,"id":8,"text":"我们三人有个不情之请；请让我们跟随你们！"},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"id":9,"text":"那么少华山上三四百人怎么办？"},
        {"op":12,"flag":1,"value":13},
        {"op":13,"flag":0,"id":10,"text":"小小山寨，就地将金银珠宝分一分解散好了。"},
        {"op":12,"flag":1,"value":5},
        {"op":13,"flag":0,"id":11,"text":"我等深受史公厚恩，尚未回报。情愿跟随史公左右，以报不杀之恩。"},
        {"op":12,"flag":1,"value":3},
        {"op":13,"flag":0,"id":12,"text":"大哥，这要怎么办？"},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"id":13,"text":"人多好办事...也好，就让他们跟吧。"},
        {"op":29,"flag":null,"id":14,"text":"众兄弟结伴闯天下。"}
      ]
    }
  ]
