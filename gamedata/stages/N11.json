        {"op":12,"flag":1,"value":19},
        {"op":18,"flag":1,"value":0},
        {"op":19,"flag":1,"value":50},
        {"op":13,"flag":0,"text":"大事不好！官军已经把东溪村团团围住！"},
        {"op":12,"flag":1,"value":14},
        {"op":13,"flag":0,"text":"我不相信！我去跟何涛理论！"},
        {"op":12,"flag":1,"value":14},
        {"op":14,"flag":1,"value":35},
        {"op":15,"flag":1,"value":19},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":14},
        {"op":17,"flag":0,"value":2},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"text":"杨志！"},
        {"op":12,"flag":1,"value":10},
        {"op":13,"flag":0,"text":"看这个情况，随时可能会发动攻击..."},
        {"op":12,"flag":1,"value":12},
        {"op":13,"flag":0,"text":"不用顾虑我...重伤的人是跑不远的；你们各自逃生吧！%N，你们也走吧。"},
        {"op":12,"flag":1,"value":0},
        {"op":14,"flag":1,"value":11},
        {"op":15,"flag":1,"value":8},
        {"op":17,"flag":0,"value":1},
        {"op":12,"flag":1,"value":0},
        {"op":13,"flag":0,"text":"看样子我们是在同一条船上... 走吧！我们一起逃出去！"},
        {"op":12,"flag":1,"value":4294967295},
