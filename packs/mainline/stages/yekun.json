        ]
      ]
    },
    {
      "on": {
        "enter": "qinming",
        "area": [
          21,
          7,
          26,
          11
        ]
      },
      "do": [
        [
          "narrate",
          "秦明怒气冲天，拍马舞棒，只顾往山上赶。赶到半山里，黑地里只听得一声响——走不到三五十步，和人连马攧下陷坑里去。"
        ],
        [
          "narrate",
          "两边埋伏下五十个挠钩手，把秦明搭将起来，剥了衣甲、头盔、军器，拿条绳索绑了，把马也救起来，都解上山来。"
        ],
        [
          "victory",
          "秦明夜里追上清风山，连人带马攧下陷坑，被挠钩手拿了。"
        ]
      ]
    },
    {
      "on": {
        "dead": "qinming"
      },
      "do": [
        [
          "narrate",
          "秦明力乏，马也跑得困了，却还不肯退。"
        ],
        [
          "narrate",
          "秦明怒气冲天，拍马舞棒，只顾往山上赶。赶到半山里，黑地里只听得一声响——走不到三五十步，和人连马攧下陷坑里去。"
        ],
        [
          "narrate",
          "两边埋伏下五十个挠钩手，把秦明搭将起来，剥了衣甲、头盔、军器，拿条绳索绑了，把马也救起来，都解上山来。"
        ],
        [
          "victory",
          "秦明夜里追上清风山，连人带马攧下陷坑，被挠钩手拿了。"
        ]
      ]
    },
